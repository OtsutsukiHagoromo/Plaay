{
  "rewrites": [
    {
      "source": "/",
      "destination": "/api/dashboard"
    },
    {
      "source": "/new",
      "destination": "/api/dashboard?new=1"
    },
    {
      "source": "/promos",
      "destination": "/api/dashboard?promos=1"
    },
    {
      "source": "/express",
      "destination": "/api/dashboard?express=1"
    },
    {
      "source": "/order/:id",
      "destination": "/api/dashboard?order=:id"
    },
    {
      "source": "/track/:token",
      "destination": "/api/track?t=:token"
    }
  ],
  "regions": [
    "bom1"
  ]
}
