# ---- noon Rider on Demand ----
# Staging: https://food-api-team.noonstg.team   Production: https://food-api-team.noon.team
NOON_BASE_URL=https://food-api-team.noonstg.team
NOON_API_KEY=
# Pickup point code for the Plaay warehouse (from GET /public/v1/outlets or pickup-points/create)
NOON_OUTLET_CODE=
NOON_LOCALE=en-ae
# A random secret you choose and give to noon; they send it as X-API-Key when calling our webhooks
NOON_WEBHOOK_KEY=

# ---- Shopify ----
SHOPIFY_SHOP=plaay.myshopify.com
SHOPIFY_API_VERSION=2026-07
# Either a static Admin API token (shpat_...) ...
SHOPIFY_ADMIN_TOKEN=
# ... or the Dev Dashboard app's client credentials (token is fetched and refreshed automatically)
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
# Secret used to sign Shopify webhooks; defaults to SHOPIFY_CLIENT_SECRET
SHOPIFY_WEBHOOK_SECRET=

# ---- This app ----
# Public URL of the deployment, no trailing slash (used for tracking links and webhook registration)
APP_URL=https://plaay-noon.vercel.app
# Password for the dispatch dashboard (username: plaay)
DASHBOARD_PASSWORD=
# Random secret used to sign customer tracking links
TRACKING_SECRET=
# Orders whose shipping method title/code matches this (case-insensitive regex) are noon express orders
EXPRESS_SHIPPING_MATCH=express|noon
# Payment gateway names that mean cash on delivery (case-insensitive regex)
COD_GATEWAY_MATCH=cash on delivery|\bcod\b
# true = book a rider as soon as an express order is placed; false = staff press Dispatch when packed
AUTO_DISPATCH=false
