{%- layout none -%}
{%- comment -%}
  Web app manifest, served at /?view=manifest (linked from snippets/pl-app-head.liquid).
  A theme cannot put a file at the site root, and the manifest's start_url must be on
  shopplaay.com, so it is an alternate home page template. Icons: assets/pl-app-icon-*.png.
  Launches open the home page tagged utm_source=homescreen so app visits show in analytics.
{%- endcomment -%}
{
  "id": "/",
  "name": "Plaay",
  "short_name": "Plaay",
  "description": "Clean, nutritionist-founded chocolate. Order in a tap.",
  "lang": "en",
  "start_url": "/?utm_source=homescreen&utm_medium=app",
  "scope": "/",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#FFB600",
  "theme_color": "#081D48",
  "categories": ["food", "shopping"],
  "icons": [
    { "src": "https:{{ 'pl-app-icon-192.png' | asset_url }}", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "https:{{ 'pl-app-icon-512.png' | asset_url }}", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "https:{{ 'pl-app-icon-maskable-512.png' | asset_url }}", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    { "name": "Shop all", "url": "/collections/shop-all?utm_source=homescreen&utm_medium=app" },
    { "name": "Your bag", "url": "/cart?utm_source=homescreen&utm_medium=app" },
    { "name": "Orders", "url": "/account?utm_source=homescreen&utm_medium=app" }
  ]
}
