<!doctype html>
<html lang="{{ request.locale.iso_code }}">
  <head>
{% render 'fudge-head-start' %}
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width,initial-scale=1">

    <link
      rel="preconnect"
      href="https://cdn.shopify.com"
      crossorigin>
    {%- comment -%}
      Shopify caps resource hints at two per template, so only the origins that actually
      serve render-path assets get one. Hotjar and BugHerd hints removed with their scripts.
    {%- endcomment -%}
    {% if template contains 'collection' or template contains 'search' %}
      <link rel="dns-prefetch" href="https://gravity-apps.com">
    {% endif %}
    <link
      rel="preload"
      href="{{ 'bundle.theme.css' | asset_url }}"
      as="style">
    <link
      rel="preload"
      href="{{ 'custom.css' | asset_url }}"
      as="style">
    <link
      rel="preload"
      href="{{ 'bundle.theme.js' | asset_url }}"
      as="script">

    {%- if template -%}
      {%- capture file_name -%}bundle.{{- template | remove: 'customers/' -}}.js{%- endcapture -%}
      <link
        rel="preload"
        href="{{- file_name | asset_url -}}"
        as="script">
    {%- endif -%}

    {% if settings.favicon %}
      <link
        rel="shortcut icon"
        href="{{- settings.favicon | img_url: '32x32' -}}"
        type="image/png">
    {% endif %}

    {%- comment -%}
      /collections/all rendered as just "Products" - Shopify's default title for a
      collection with no SEO title set. Anything that already contains the shop name is
      left exactly as it is, so the hand-written product and page titles are untouched.
    {%- endcomment -%}
    <title>
      {{- page_title | escape -}}
      {%- if current_tags %} &ndash; tagged &ldquo;{{ current_tags | join: ', ' | escape }}&rdquo;{% endif -%}
      {%- if current_page != 1 %} &ndash; Page {{ current_page }}{% endif -%}
      {%- comment -%}
        Match on the first word of the shop name, not the whole thing. shop.name is
        "Plaay Store", and the hand-written product titles end in "- Plaay", so a
        `contains shop.name` test failed on every one of them and produced
        "... - Plaay - Plaay Store".
      {%- endcomment -%}
      {%- assign brand_token = shop.name | split: ' ' | first -%}
      {%- unless page_title contains brand_token %} &ndash; {{ shop.name | escape }}{% endunless -%}
    </title>

    {% if page_description %}
      <meta name="description" content="{{ page_description | escape }}">
    {% endif %}

    {{ 'bundle.theme.css' | asset_url | stylesheet_tag }}
    {{ 'custom.css' | asset_url | stylesheet_tag }}
    {% render 'head.fonts' %}

    {%- if template -%}
      {%- capture file_name -%}bundle.{{- template | remove: 'customers/' -}}.css{%- endcapture -%}
      {{ file_name | asset_url | stylesheet_tag }}
    {% endif %}

    {{ content_for_header }}

    {%- capture file -%}
      {{ 'site.webmanifest.json' | asset_url }}
    {%- endcapture -%}

    {%- liquid
      assign is_dev_theme = false

      if theme.name contains 'Development'
        assign is_dev_theme = true
      endif

      assign assets_path = file | split: 'site.webmanifest.json' | first

      if is_dev_theme
        assign assets_path = '/assets/'
      endif
    -%}

    <script>
      window.__webpack_public_path__ = "{{ assets_path }}"

      window.theme = {
        isDevTheme: {{ is_dev_theme }},
        customer: {
          isLoggedIn:{% if customer %}true
          {% else %}
            false
          {% endif %},
          id: {{ customer.id | default: 'null' }}
        },
        moneyFormat: {{ shop.money_format | json }}
        {% if template contains 'account' %},
          allCountryOptionTags : {{ all_country_option_tags | json }}
        {% endif %}
      }

      window.routes = {
        cart_add_url: '{{ routes.cart_add_url }}',
        cart_change_url: '{{ routes.cart_change_url }}',
        cart_update_url: '{{ routes.cart_update_url }}',
        cart_url: '{{ routes.cart_url }}'
      };
    </script>
  {% render 'delivery_coder' %} 
  {% render 'shogun-head' %}
</head>

    <body class="template-{{ template  | remove :"."}}">
    {%- render 'icon-sprite' -%}
    <a class="plaay-skip-link" href="#main">Skip to content</a>
    {% section 'announcement-bar' %}
    {% section 'header' %}
    <main id="main" role="main">
      <div class="page-overlay transition-all duration-300 bg-black w-full h-full fixed opacity-0 invisible z-10 left-1/2 top-1/2 transform -translate-x-1/2 -translate-y-1/2"></div>
      {{ content_for_layout }}
    </main>
    {% render 'cookie-banner' %}
    {%- render 'gift-js' -%}
    {%- render 'plaay-eid-countdown-js' -%}
    {%- render 'plaay-fd-countdown-js' -%}
    {%- render 'plaay-summer-countdown-js' -%}
    {%- render 'plaay-bts-countdown-js' -%}
    {%- render 'drawers' -%}
    {% section 'footer' %}

    <script defer src="{{ 'bundle.theme.js' | asset_url }}"></script>
    {%- if template -%}
      {%- capture file_name -%}bundle.{{- template | remove: 'customers/' -}}.js{%- endcapture -%}
      <script defer src="{{ file_name | asset_url }}"></script>
    {%- endif -%}
    <script defer src="{{ 'glide.static.min.js' | asset_url }}"></script>
    {% if template contains 'collection' or template contains 'search' %}
      <script defer src="https://gravity-apps.com/shopify/js/shopify/infinitescroll7349.js?v=a55687c0bba538cfea254c604eb054a4"></script>
    {% endif %}
    {% if template contains 'product' %}
      <script>var check_edd_data_from_liquid = '1';</script>{% render 'edd_read_data_from_liquid' %}
    {% endif %}
    {%- comment -%}
      Removed: Hotjar + BugHerd idle-loader. Hotjar was redundant with Microsoft Clarity
      (kept, via app embed) and BugHerd is a QA sidebar that was shipping to real customers
      on every page - it was excluded only in request.design_mode, which is the theme
      editor, not production.

      If a third-party script ever needs adding back, reuse the pattern that was here:
      window 'load' -> requestIdleCallback(fn, {timeout: 2000}) with a setTimeout fallback,
      wrapped in {% unless request.design_mode %}.
    {%- endcomment -%}

      {%- comment -%}
        Cart button. There used to be two handlers for this: one attached here at parse
        time, and a second further down that waited for `load`, then 1000 ms more, then
        cloned the button and replaced it - which silently destroyed the first. Between
        parse and load+1s the button behaved one way, after it another, and on a slow
        connection the gap was seconds long.

        The clone existed to strip listeners that Rebuy Smart Cart attached to the button.
        Smart Cart is disabled (see the destroy call below), and a capture-phase listener
        attached now runs before anything a later script binds, so stopImmediatePropagation
        does the same job without the clone or the timer.
      {%- endcomment -%}
      <script>
        document.addEventListener('click', function(e) {
          var trigger = e.target.closest && e.target.closest('.header__icon--cart');
          if (!trigger) return;

          e.preventDefault();
          e.stopImmediatePropagation();

          var sd = document.querySelector('site-drawers');
          /* If the Drawers custom-element has been upgraded, use its API */
          if (sd && sd.activeDrawer !== undefined) {
            sd.activeDrawer = 'cart';
            return;
          }
          /* Fallback: toggle classes directly so the cart opens regardless of bundle timing */
          var cd = document.querySelector('cart-drawer');
          if (!cd) return;
          cd.classList.add('active');
          document.body.classList.add('overflow-hidden');
          if (sd) {
            var ov = sd.querySelector('[data-overlay]');
            if (ov) {
              ov.classList.add('active');
              ov.addEventListener('click', function() {
                cd.classList.remove('active');
                document.body.classList.remove('overflow-hidden');
                ov.classList.remove('active');
              }, { once: true });
            }
          }
        }, true);
      </script>

      <!-- Widget : Custom Popup -->
{% comment %} <div data-rebuy-id="192197"></div> {% endcomment %}
<!-- End Widget : Custom Popup -->
{% unless template contains 'cart' or template contains 'checkout' or template contains 'product' %}

<a
