  class="plaay-wa-float"
  target="_blank"
  rel="noopener noreferrer"
  aria-label="Chat with Plaay on WhatsApp"
>
  <svg
    class="plaay-wa-icon"
    viewBox="0 0 32 32"
    aria-hidden="true"
    focusable="false"
  >
