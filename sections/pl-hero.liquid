{%- comment -%}
  Plaay 2026 — homepage hero. Full-bleed photo (mobile 4:5, desktop 16:7) with a navy
  gradient at the bottom and the headline, sub line and two buttons over it.
  The part of the heading matching "heading_accent" is shown in yellow on its own line.
{%- endcomment -%}
{{ 'pl-home.css' | asset_url | stylesheet_tag }}
{%- liquid
  assign s = section.settings
  assign img_m = s.image_mobile | default: s.image_desktop
  assign has_both = false
  if s.image_mobile != blank and s.image_desktop != blank
    assign has_both = true
  endif
  assign heading = s.heading | escape
  assign accent = s.heading_accent | strip | escape
  if accent != blank and heading contains accent
    assign accent_html = '<span class="pl-hero__accent">' | append: accent | append: '</span>'
    assign heading = heading | replace_first: accent, accent_html
  endif
  assign btn1_url = s.btn1_url | default: '/collections/shop-all'
  assign btn2_url = s.btn2_url | default: '/products/build-your-box'
-%}
<div class="pl pl-section pl-hero" id="pl-{{ section.id }}">
  {%- if img_m != blank -%}
    <div class="pl-hero__media">
      <picture>
        {%- if has_both -%}
          <source media="(min-width: 1024px)" sizes="100vw" srcset="{{ s.image_desktop | image_url: width: 1280 }} 1280w, {{ s.image_desktop | image_url: width: 1600 }} 1600w, {{ s.image_desktop | image_url: width: 2000 }} 2000w, {{ s.image_desktop | image_url: width: 2600 }} 2600w">
        {%- endif -%}
        {{ img_m | image_url: width: 1200 | image_tag: loading: 'eager', fetchpriority: 'high', widths: '480, 640, 828, 1080, 1200, 1600', sizes: '100vw', class: 'pl-hero__img' }}
      </picture>
    </div>
  {%- endif -%}
  <div class="pl-wrap pl-hero__body">
    {%- if s.eyebrow != blank -%}<span class="pl-eyebrow">{{ s.eyebrow | escape }}</span>{%- endif -%}
    {%- if s.heading != blank -%}<h1 class="pl-h pl-h--1 pl-hero__h">{{ heading }}</h1>{%- endif -%}
    {%- if s.sub != blank -%}<p class="pl-hero__sub">{{ s.sub | escape }}</p>{%- endif -%}
    {%- if s.btn1_label != blank or s.btn2_label != blank -%}
      <div class="pl-hero__btns">
        {%- if s.btn1_label != blank -%}<a class="pl-btn" href="{{ btn1_url }}">{{ s.btn1_label | escape }}</a>{%- endif -%}
        {%- if s.btn2_label != blank -%}<a class="pl-btn pl-btn--ghost" href="{{ btn2_url }}">{{ s.btn2_label | escape }}</a>{%- endif -%}
      </div>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Plaay hero",
  "settings": [
    {
      "type": "image_picker",
      "id": "image_mobile",
      "label": "Image (mobile, 4:5)"
    },
    {
      "type": "image_picker",
      "id": "image_desktop",
      "label": "Image (desktop, 16:7)"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Why Plaay"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "No guilt. All Plaay."
    },
    {
      "type": "text",
      "id": "heading_accent",
      "label": "Yellow part of the heading",
      "info": "Must appear inside the heading. Shown in yellow on its own line.",
      "default": "All Plaay."
    },
    {
      "type": "text",
      "id": "sub",
      "label": "Sub line",
      "default": "Zero refined sugar. 100% clean ingredients. Made in the UAE by a nutritionist."
    },
    {
      "type": "text",
      "id": "btn1_label",
      "label": "Button 1 label",
      "default": "Shop bestsellers"
    },
    {
      "type": "url",
      "id": "btn1_url",
      "label": "Button 1 link"
    },
    {
      "type": "text",
      "id": "btn2_label",
      "label": "Button 2 label",
      "default": "Build your box"
    },
    {
      "type": "url",
      "id": "btn2_url",
      "label": "Button 2 link"
    }
  ],
  "presets": [
    {
      "name": "Plaay hero",
      "category": "Plaay 2026"
    }
  ]
}
{% endschema %}
