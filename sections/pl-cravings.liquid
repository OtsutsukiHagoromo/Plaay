{%- comment -%}
  Plaay 2026 — "Shop by craving". Four image tiles (2x2 mobile, 4 across desktop) with the
  title overlaid bottom-left on a colour wash. Blocks: title, image, url, optional sub + wash colour.
{%- endcomment -%}
{{ 'pl-home.css' | asset_url | stylesheet_tag }}
{%- liquid
  assign s = section.settings
-%}
{%- if section.blocks.size > 0 -%}
<div class="pl pl-section pl-cravings" id="pl-{{ section.id }}">
  <div class="pl-wrap">
    <div class="pl-home-head">
      <div class="pl-home-head__t">
        {%- if s.eyebrow != blank -%}<span class="pl-eyebrow">{{ s.eyebrow | escape }}</span>{%- endif -%}
        {%- if s.heading != blank -%}<h2 class="pl-h pl-h--2">{{ s.heading | escape }}</h2>{%- endif -%}
      </div>
    </div>
    <div class="pl-grid pl-grid--2 pl-grid--d4">
      {%- for block in section.blocks -%}
        {%- liquid
          assign b = block.settings
          assign wash = b.wash | default: '#081D48'
        -%}
        <a class="pl-crave" {% if b.url != blank %}href="{{ b.url }}"{% endif %} style="--pl-wash: {{ wash }}" {{ block.shopify_attributes }}>
          {%- if b.image != blank -%}
            {{ b.image | image_url: width: 800 | image_tag: loading: 'lazy', widths: '320, 480, 640, 800', sizes: '(min-width: 1024px) 300px, 46vw', alt: b.title }}
          {%- endif -%}
          <span class="pl-crave__wash" aria-hidden="true"></span>
          <span class="pl-crave__body">
            {%- if b.title != blank -%}<span class="pl-crave__t">{{ b.title | escape }}</span>{%- endif -%}
            {%- if b.sub != blank -%}<span class="pl-crave__s">{{ b.sub | escape }}</span>{%- endif -%}
          </span>
        </a>
      {%- endfor -%}
    </div>
  </div>
</div>
{%- endif -%}

{% schema %}
{
  "name": "Plaay shop by craving",
  "max_blocks": 8,
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Shop by craving" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Not by category." }
  ],
  "blocks": [
    {
      "type": "tile",
      "name": "Craving tile",
      "settings": [
        { "type": "text", "id": "title", "label": "Title", "default": "The 3:30 pm reset" },
        { "type": "text", "id": "sub", "label": "Small line (optional)" },
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "url", "id": "url", "label": "Link" },
        { "type": "color", "id": "wash", "label": "Colour wash", "default": "#081D48" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Plaay shop by craving",
      "category": "Plaay 2026",
      "blocks": [
        { "type": "tile", "settings": { "title": "The 3:30 pm reset", "url": "/products/salted-caramel-bar-x12" } },
        { "type": "tile", "settings": { "title": "Post-workout", "url": "/products/bar-bunch" } },
        { "type": "tile", "settings": { "title": "Netflix o'clock", "url": "/products/truffle-mix" } },
        { "type": "tile", "settings": { "title": "The PMS kit", "url": "/products/triple-chocolate-truffle" } }
      ]
    }
  ]
}
{% endschema %}
