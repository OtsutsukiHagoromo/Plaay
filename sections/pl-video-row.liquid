{%- comment -%}
  Plaay 2026 — shared reel row (home + product templates). Horizontal snap row of 9:16 tiles.
  Block "reel": image, caption, video (optional mp4 URL), link (optional).
  With a video: the tile is a button; assets/pl-video-row.js plays it inline (tap = sound on
  mobile, hover = muted on desktop, click = sound, one at a time, paused when scrolled out).
  Without a video: the tile links to "link", or to the section link.
{%- endcomment -%}
{{ 'pl-home.css' | asset_url | stylesheet_tag }}
<script src="{{ 'pl-video-row.js' | asset_url }}" defer></script>
{%- liquid
  assign s = section.settings
  assign bg = s.bg | default: 'ground'
  assign sub_d = s.sub_desktop | default: s.sub
  assign row_link = s.link_url | default: 'https://www.instagram.com/shopplaay'
  assign row_link_ext = false
  if row_link contains '://'
    assign row_link_ext = true
  endif
-%}
{%- if section.blocks.size > 0 -%}
<div class="pl pl-section pl-video-row pl-video-row--{{ bg }}" id="pl-{{ section.id }}" data-pl-video-row>
  <div class="pl-wrap">
    <div class="pl-home-head">
      <div class="pl-home-head__t">
        {%- if s.heading != blank -%}<h2 class="pl-h pl-h--2">{{ s.heading | escape }}</h2>{%- endif -%}
        {%- if s.sub != blank -%}<p class="pl-small pl-mute pl-hide-d">{{ s.sub | escape }}</p>{%- endif -%}
        {%- if sub_d != blank -%}<p class="pl-small pl-mute pl-hide-m">{{ sub_d | escape }}</p>{%- endif -%}
      </div>
      {%- if s.link_label != blank -%}
        <a class="pl-home-head__link" href="{{ row_link }}"{% if row_link_ext %} target="_blank" rel="noopener"{% endif %}>{{ s.link_label | escape }}{%- render 'pl-icon', name: 'chev-right', size: 16, stroke: 2.2 -%}</a>
      {%- endif -%}
    </div>
    <div class="pl-scroll pl-video-row__row">
      {%- for block in section.blocks -%}
        {%- liquid
          assign b = block.settings
          assign href = b.link | default: row_link
          assign href_ext = false
          if href contains '://'
            assign href_ext = true
          endif
        -%}
        {%- capture inner -%}
          {%- if b.image != blank -%}
            {{ b.image | image_url: width: 720 | image_tag: loading: 'lazy', widths: '240, 360, 480, 600, 720', sizes: '(min-width: 1024px) 300px, 40vw', alt: b.caption }}
          {%- endif -%}
          <span class="pl-video__play" aria-hidden="true">{%- render 'pl-icon', name: 'play', size: 22 -%}</span>
          {%- if b.video != blank -%}<span class="pl-video__hint" aria-hidden="true">Click for sound</span>{%- endif -%}
          {%- if b.caption != blank -%}<span class="pl-video__cap">{{ b.caption | escape }}</span>{%- endif -%}
        {%- endcapture -%}
        {%- if b.video != blank -%}
          <button type="button" class="pl-video" data-pl-reel data-video="{{ b.video | strip | escape }}" aria-label="Play: {{ b.caption | default: 'reel' | escape }}" {{ block.shopify_attributes }}>{{ inner }}</button>
        {%- else -%}
          <a class="pl-video" data-pl-reel href="{{ href }}"{% if href_ext %} target="_blank" rel="noopener"{% endif %} aria-label="{{ b.caption | default: 'Watch on Instagram' | escape }}" {{ block.shopify_attributes }}>{{ inner }}</a>
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>
</div>
{%- endif -%}

{% schema %}
{
  "name": "Plaay video row",
  "max_blocks": 8,
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Plaay on camera" },
    { "type": "text", "id": "sub", "label": "Sub line (mobile)", "default": "Reels from the feed. Tap to watch with sound." },
    { "type": "text", "id": "sub_desktop", "label": "Sub line (desktop)", "default": "Reels from the feed. Hover plays silently, click for sound." },
    { "type": "text", "id": "link_label", "label": "Link label", "default": "More on Instagram" },
    { "type": "url", "id": "link_url", "label": "Link URL", "default": "https://www.instagram.com/shopplaay" },
    {
      "type": "select",
      "id": "bg",
      "label": "Background",
      "default": "ground",
      "options": [
        { "value": "ground", "label": "Ground" },
        { "value": "cream", "label": "Cream" },
        { "value": "navy", "label": "Navy" }
      ]
    }
  ],
  "blocks": [
    {
      "type": "reel",
      "name": "Reel",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Cover image (9:16)" },
        { "type": "text", "id": "caption", "label": "Caption" },
        { "type": "text", "id": "video", "label": "Video URL (mp4, optional)", "info": "Upload the file under Content > Files and paste its URL. Plays inline." },
        { "type": "url", "id": "link", "label": "Link (used when there is no video)" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Plaay video row",
      "category": "Plaay 2026",
      "blocks": [
        { "type": "reel", "settings": { "caption": "How the pour happens" } },
        { "type": "reel", "settings": { "caption": "Rashi: why I made Plaay" } },
        { "type": "reel", "settings": { "caption": "The 3:30 pm reset" } },
        { "type": "reel", "settings": { "caption": "Game night, Plaay style" } }
      ]
    }
  ]
}
{% endschema %}
