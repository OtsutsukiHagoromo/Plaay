{%- comment -%}
  Option A / Option B preview: reels row. Poster image + caption, each linking out (Instagram).
  A: centred white play button. B: yellow sticker play button in the corner.
{%- endcomment -%}
{%- assign s = section.settings -%}
<div class="pl plo plo-sec">
  <div class="plo-wrap">
    {%- render 'plo-head', eyebrow: s.eyebrow, bold: s.heading, light: s.heading_light, link_label: s.link_label, link_url: s.link_url -%}
    <div class="plo-vids">
      {%- for block in section.blocks -%}
        {%- assign b = block.settings -%}
        <a class="plo-vid" href="{{ b.url | default: s.link_url }}" target="_blank" rel="noopener" {{ block.shopify_attributes }}>
          {%- render 'plo-img', image: b.image, asset: b.image_asset, width: 480, alt: '' -%}
          <span class="plo-vid__play" aria-hidden="true">{%- render 'pl-icon', name: 'play', size: 20 -%}</span>
          <span class="plo-vid__c">{{ b.caption }}</span>
        </a>
      {%- endfor -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Preview: videos",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Label (Option A only)", "default": "On camera" },
    { "type": "text", "id": "heading", "label": "Heading, bold part", "default": "See it in" },
    { "type": "text", "id": "heading_light", "label": "Heading, light part", "default": "real life" },
    { "type": "text", "id": "link_label", "label": "Link label", "default": "Instagram" },
    { "type": "url", "id": "link_url", "label": "Link" }
  ],
  "blocks": [
    {
      "type": "reel",
      "name": "Reel",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Poster" },
        { "type": "text", "id": "image_asset", "label": "Poster fallback (theme asset file)" },
        { "type": "text", "id": "caption", "label": "Caption" },
        { "type": "url", "id": "url", "label": "Link" }
      ]
    }
  ]
}
{% endschema %}
