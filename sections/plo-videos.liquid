{%- comment -%}
  Option B: "See it in real life". Each reel can have:
    - a video (uploaded in Shopify Files, or an mp4 URL): plays muted on loop while on screen;
      a tap opens it large with sound;
    - an Instagram post / reel link: a tap with no video opens that exact post in a pop-up
      (Instagram's embed), and the pop-up links to the post;
    - neither: the tile links to the Instagram profile.
  Behaviour in assets/pl-opt.js (initReels).
{%- endcomment -%}
{%- assign s = section.settings -%}
<div class="pl plo plo-sec plo-reels" data-plo-reels>
  <div class="plo-wrap">
    {%- render 'plo-head', eyebrow: s.eyebrow, bold: s.heading, light: s.heading_light, link_label: s.link_label, link_url: s.link_url -%}
    <div class="plo-vids">
      {%- for block in section.blocks -%}
        {%- liquid
          assign b = block.settings
          assign src = ''
          if b.video != blank
            assign src = b.video.sources | where: 'format', 'mp4' | sort: 'height' | last | map: 'url' | first
          endif
          if src == blank and b.video_url != blank
            assign src = b.video_url
          endif
          assign post = b.url | default: ''
          assign embed = ''
          if post contains 'instagram.com/'
            assign parts = post | split: '?' | first | split: '/'
            assign kind = ''
            assign code = ''
            for x in parts
              if kind != '' and code == '' and x != blank
                assign code = x
              endif
              if x == 'p' or x == 'reel' or x == 'reels' or x == 'tv'
                assign kind = x
              endif
            endfor
            if code != ''
              assign embed = 'https://www.instagram.com/p/' | append: code | append: '/embed/'
            endif
          endif
        -%}
        <button type="button" class="plo-vid{% if src != blank %} has-video{% endif %}" data-plo-reel data-video="{{ src | escape }}" data-embed="{{ embed | escape }}" data-post="{{ post | default: s.link_url | escape }}" aria-label="Play: {{ b.caption | escape }}" {{ block.shopify_attributes }}>
          {%- render 'plo-img', image: b.image, asset: b.image_asset, width: 480, alt: '' -%}
          {%- if src != blank -%}<video muted loop playsinline preload="none" data-src="{{ src | escape }}"{% if b.image != blank %} poster="{{ b.image | image_url: width: 480 }}"{% endif %}></video>{%- endif -%}
          <span class="plo-vid__play" aria-hidden="true">{%- render 'pl-icon', name: 'play', size: 20 -%}</span>
          <span class="plo-vid__c">{{ b.caption }}</span>
        </button>
      {%- endfor -%}
    </div>
  </div>
  <div class="plo-lb" data-plo-lb hidden role="dialog" aria-modal="true" aria-label="Video">
    <div class="plo-lb__box">
      <button type="button" class="plo-lb__x" data-plo-lb-close aria-label="Close">{%- render 'pl-icon', name: 'close', size: 20, stroke: 2.4 -%}</button>
      <div class="plo-lb__media" data-plo-lb-media></div>
      <a class="plo-lb__ig" data-plo-lb-ig href="{{ s.link_url }}" target="_blank" rel="noopener">{%- render 'pl-icon', name: 'instagram', size: 16 -%}View on Instagram</a>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Preview: videos",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Label", "default": "On camera" },
    { "type": "text", "id": "heading", "label": "Heading, bold part", "default": "See it in" },
    { "type": "text", "id": "heading_light", "label": "Heading, light part", "default": "real life" },
    { "type": "text", "id": "link_label", "label": "Link label", "default": "Instagram" },
    { "type": "url", "id": "link_url", "label": "Instagram profile" }
  ],
  "blocks": [
    {
      "type": "reel",
      "name": "Reel",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Poster" },
        { "type": "text", "id": "image_asset", "label": "Poster fallback (theme asset file)" },
        { "type": "text", "id": "caption", "label": "Caption" },
        { "type": "video", "id": "video", "label": "Video (vertical, 6-15 s)" },
        { "type": "text", "id": "video_url", "label": "Or a video URL (.mp4)" },
        { "type": "url", "id": "url", "label": "Instagram post / reel link" }
      ]
    }
  ]
}
{% endschema %}
