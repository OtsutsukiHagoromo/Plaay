{%- comment -%}
  Option A / Option B preview: product page top. Gallery + buy box + a sticky add bar on mobile.
  Buy box: label, title, rating, short description, flavour row (sibling products from the flavour
  lists below, shown when this product is in one), pack size (variants), Subscribe & save /
  One-time, quantity and "Add to bag". assets/pl-opt.js adds to /cart/add.js with the chosen
  variant and selling plan, then opens the cart in the same option (?view=).
  A: white outlined gallery box, cream subscribe row, flat yellow button.
  B: flavour-tinted gallery with a sticker, sticker buttons, yellow selected flavour ring.
{%- endcomment -%}
{%- liquid
  assign s = section.settings
  assign v = product.selected_or_first_available_variant
  comment
    Default pack size: the variant whose title matches the "Default pack size" setting
    (spaces and case ignored), unless the URL already picked a variant.
  endcomment
  if product.selected_variant == blank and s.default_size != blank
    assign want = s.default_size | downcase | remove: ' '
    for variant in product.variants
      assign vt = variant.title | downcase | remove: ' '
      if vt == want and variant.available
        assign v = variant
      endif
    endfor
  endif
  assign view = template.suffix
  assign sub_pct = 0
  assign plan_id = ''
  for grp in product.selling_plan_groups
    for plan in grp.selling_plans
      for adj in plan.price_adjustments
        if adj.value_type == 'percentage' and adj.value > sub_pct
          assign sub_pct = adj.value
          assign plan_id = plan.id
        endif
      endfor
    endfor
  endfor
  comment
    Prefer the 4-week plan among the best-discount plans: the copy on the page says every 4 weeks.
  endcomment
  for grp in product.selling_plan_groups
    for plan in grp.selling_plans
      assign pname = plan.name | downcase
      if pname contains '4 week'
        for adj in plan.price_adjustments
          if adj.value_type == 'percentage' and adj.value == sub_pct
            assign plan_id = plan.id
          endif
        endfor
      endif
    endfor
  endfor
  assign keep = 100 | minus: sub_pct
  assign sub_price = v.price | times: keep | divided_by: 100
  assign save = v.price | minus: sub_price

  assign rating = shop.metafields.judgeme.all_reviews_rating | append: '' | times: 1.0
  assign count = shop.metafields.judgeme.all_reviews_count | append: '' | plus: 0
  if rating <= 0
    assign rating = settings.store_rating_value | append: '' | times: 1.0
  endif
  if count <= 0
    assign count = settings.store_rating_count | append: '' | plus: 0
  endif
  assign rating = rating | round: 1

  assign tint = s.tint_default
  assign tint_lines = s.tints | newline_to_br | split: '<br />'
  for l in tint_lines
    assign pair = l | strip | split: ':'
    if pair[0] == product.handle
      assign tint = pair[1] | strip
    endif
  endfor

  assign flavours = nil
  for p in s.flavours_1
    if p.id == product.id
      assign flavours = s.flavours_1
    endif
  endfor
  for p in s.flavours_2
    if p.id == product.id
      assign flavours = s.flavours_2
    endif
  endfor
  for p in s.flavours_3
    if p.id == product.id
      assign flavours = s.flavours_3
    endif
  endfor

  assign badge_text = ''
  for tag in product.tags
    assign tl = tag | downcase | strip
    if badge_text == ''
      case tl
        when 'badge:bestseller'
          assign badge_text = 'Best seller'
        when 'badge:new-launch', 'badge:new'
          assign badge_text = 'New'
        when 'badge:limited', 'limited edition'
          assign badge_text = 'Limited'
      endcase
    endif
  endfor
  assign eyebrow = badge_text

  assign desc = product.description | strip_html | strip | truncatewords: s.desc_words
  assign desc_full = product.description | strip_html | strip | truncatewords: 90
  assign has_sub = false
  if sub_pct > 0 and plan_id != ''
    assign has_sub = true
  endif
  assign cta_price = v.price
  if has_sub
    assign cta_price = sub_price
  endif
  capture pkey
    render 'plo-photo-key', handle: product.handle
  endcapture
  assign pkey = pkey | strip
-%}
<div class="pl plo plo-pdp" data-plo-pdp data-view="{{ view }}" data-pct="{{ sub_pct }}">
  <div class="plo-pdp__cols">
    {%- if pkey != blank -%}
      <div class="plo-gal plo-gal--photos" style="--tint: {{ tint }};" data-plo-photos>
        <div class="plo-gal__track" data-plo-phtrack>
          {%- for i in (1..8) -%}
            {%- assign ph = 'plo-ph-' | append: pkey | append: '-' | append: i | append: '.jpg' -%}
            <img src="{{ ph | asset_url }}" alt="{{ product.title | escape }}, photo {{ i }}" width="800" height="1000"{% if forloop.first %} loading="eager" fetchpriority="high"{% else %} loading="lazy"{% endif %}>
          {%- endfor -%}
        </div>
        {%- if badge_text != blank -%}<span class="plo-badge plo-gal__badge">{{ badge_text }}</span>{%- endif -%}
        <span class="plo-gal__count" aria-hidden="true"><b data-plo-count>1</b> / 8</span>
        <div class="plo-gal__thumbs" data-plo-thumbrow>
          {%- for i in (1..8) -%}
            {%- assign ph = 'plo-ph-' | append: pkey | append: '-' | append: i | append: '.jpg' -%}
            <button type="button" class="plo-gal__th{% if forloop.first %} is-on{% endif %}" data-plo-go="{{ forloop.index0 }}" aria-label="Photo {{ i }}"><img src="{{ ph | asset_url }}" alt="" loading="lazy" width="80" height="100"></button>
          {%- endfor -%}
        </div>
      </div>
    {%- else -%}
    <div class="plo-gal" style="--tint: {{ tint }};">
      <div class="plo-gal__main">
        {%- if product.featured_image -%}
          {{ product.featured_image | image_url: width: 1000 | image_tag: loading: 'eager', fetchpriority: 'high', sizes: '(min-width: 1024px) 50vw, 100vw', widths: '500, 750, 1000', alt: product.title, class: 'plo-gal__img' }}
        {%- endif -%}
        {%- if badge_text != blank -%}<span class="plo-badge plo-gal__badge">{{ badge_text }}</span>{%- endif -%}
      </div>
      {%- if product.images.size > 1 -%}
        <div class="plo-gal__thumbs">
          {%- for img in product.images limit: 5 -%}
            <button type="button" class="plo-gal__th{% if forloop.first %} is-on{% endif %}" data-plo-thumb data-src="{{ img | image_url: width: 1000 }}" aria-label="Image {{ forloop.index }}">
              {{ img | image_url: width: 160 | image_tag: loading: 'lazy', alt: '' }}
            </button>
          {%- endfor -%}
        </div>
      {%- endif -%}
    </div>
    {%- endif -%}

    <div class="plo-buy">
      {%- if eyebrow != blank -%}<p class="plo-eyebrow plo-eyebrow--sec">{{ eyebrow }}</p>{%- endif -%}
      {%- liquid
        comment
          Title in three parts so it reads smaller: the range ("70% Dark Chocolate") as a kicker,
          the name ("Hazelnut Slab") as the headline, and the pack size ("6 × 80g") as a tag.
          Titles without a range prefix or an "N x Ng" size just show as the headline.
        endcomment
        assign t_name = product.title | strip
        assign t_kick = ''
        assign t_size = ''
        assign kicks = '70% Dark Chocolate |Milk Chocolate |Dark Chocolate ' | split: '|'
        for k in kicks
          assign kl = k | size
          assign head = t_name | slice: 0, kl
          if t_kick == '' and head == k
            assign t_kick = k | strip
            assign t_name = t_name | slice: kl, 200 | strip
          endif
        endfor
        assign words = t_name | split: ' '
        assign cut = words.size
        for w in words reversed
          assign wl = w | downcase | remove: '0' | remove: '1' | remove: '2' | remove: '3' | remove: '4' | remove: '5' | remove: '6' | remove: '7' | remove: '8' | remove: '9' | remove: '.' | remove: 'gm' | remove: 'g' | remove: 'x'
          if wl == ''
            assign cut = cut | minus: 1
          else
            break
          endif
        endfor
        if cut < words.size and cut > 0
          assign tail = ''
          assign front = ''
          for w in words
            if forloop.index0 < cut
              assign front = front | append: w | append: ' '
            else
              assign tail = tail | append: w | append: ' '
            endif
          endfor
          assign tl = tail | downcase
          if tl contains 'x '
            assign t_name = front | strip
            assign t_size = tail | strip | replace: ' x ', ' × ' | replace: ' X ', ' × ' | replace: 'Gm', 'g' | replace: 'G', 'g' | replace: ' g', 'g'
          endif
        endif
        assign name_words = t_name | split: ' '
        if t_kick != '' and name_words.size < 2
          assign t_name = t_kick | append: ' ' | append: t_name
          assign t_kick = ''
        endif
      -%}
      <h1 class="plo-buy__t">
        {%- if t_kick != blank -%}<span class="plo-buy__kick">{{ t_kick }}</span>{%- endif -%}
        <span class="plo-buy__name">{{ t_name }}</span>
        {%- if t_size != blank -%}<span class="plo-buy__size">{{ t_size }}</span>{%- endif -%}
      </h1>
      {%- if rating > 0 -%}
        <a class="plo-buy__rate" href="#plo-reviews">{%- render 'plo-stars', size: 14 -%}<span>{{ rating }} · {{ count }} reviews</span></a>
      {%- endif -%}
      {%- comment -%}
        Two lines of the description; "More" (shown only when it overflows) expands it in place.
        A custom.tagline metafield, when set, is used instead as a one-liner.
      {%- endcomment -%}
      {%- assign tagline = product.metafields.custom.tagline.value | default: product.metafields.custom.tagline -%}
      {%- if tagline != blank -%}
        <p class="plo-buy__d">{{ tagline | strip_html }}</p>
      {%- elsif desc != blank -%}
        <div class="plo-buy__dw" data-plo-more>
          <p class="plo-buy__d plo-buy__d--clamp" id="plo-desc-{{ section.id }}">{{ desc_full }}</p>
          <button type="button" class="plo-buy__more" aria-expanded="false" aria-controls="plo-desc-{{ section.id }}" hidden>More</button>
        </div>
      {%- endif -%}

      {%- form 'product', product, class: 'plo-form', data-plo-form: '', autocomplete: 'off' -%}
        <input type="hidden" name="id" value="{{ v.id }}" data-plo-variant>
        {%- if has_sub -%}<input type="hidden" name="selling_plan" value="{{ plan_id }}" data-plo-plan>{%- endif -%}

        {%- if flavours != nil and flavours.size > 1 -%}
          <div class="plo-opt">
            <p class="plo-opt__l">Flavour: <b>{%- render 'plo-flavour-name', title: product.title, strip: s.strip_words, fallback: s.flavour_fallback -%}</b></p>
            <div class="plo-flav">
              {%- for f in flavours -%}
                {%- capture fname -%}{%- render 'plo-flavour-name', title: f.title, strip: s.strip_words, fallback: s.flavour_fallback -%}{%- endcapture -%}
                <a class="plo-flav__i{% if f.id == product.id %} is-on{% endif %}" href="{{ f.url }}{% if view != blank %}?view={{ view }}{% endif %}"{% if f.id == product.id %} aria-current="true"{% endif %}>
                  {%- capture fkey -%}{%- render 'plo-photo-key', handle: f.handle -%}{%- endcapture -%}{%- assign fkey = fkey | strip -%}
                  <span class="plo-flav__pic">{%- if fkey != blank -%}{%- assign ph = 'plo-ph-' | append: fkey | append: '-1.jpg' -%}<img src="{{ ph | asset_url }}" alt="" loading="lazy" width="80" height="100" class="is-photo">{%- elsif f.featured_image -%}{{ f.featured_image | image_url: width: 160 | image_tag: loading: 'lazy', alt: '' }}{%- endif -%}</span>
                  <span class="plo-flav__n">{{ fname }}</span>
                </a>
              {%- endfor -%}
            </div>
          </div>
        {%- endif -%}

        {%- if product.has_only_default_variant == false -%}
          <div class="plo-opt">
            <p class="plo-opt__l">{{ product.options.first }}</p>
            {%- liquid
              comment
                Pack sizes like "10 X 60G": count × grams. For truffles (one piece = the
                "Piece weight" setting) each chip shows the price per truffle, and the lowest
                per-truffle price gets a "Best value" badge.
              endcomment
              assign per_unit = false
              if s.piece_g > 0 and product.title contains 'Truffle'
                assign per_unit = true
              endif
              assign best_per = 0
              assign best_id = 0
              if per_unit
                for variant in product.variants
                  assign tt = variant.title | downcase | remove: ' ' | split: 'x'
                  assign n = tt[0] | plus: 0
                  assign g = tt[1] | remove: 'g' | plus: 0
                  assign pcs = n | times: g | divided_by: s.piece_g
                  if pcs > 0 and variant.available
                    assign per = variant.price | divided_by: pcs
                    if best_per == 0 or per < best_per
                      assign best_per = per
                      assign best_id = variant.id
                    endif
                  endif
                endfor
              endif
            -%}
            <div class="plo-sizes{% if per_unit %} plo-sizes--units{% endif %}">
              {%- for variant in product.variants -%}
                {%- liquid
                  assign label = variant.title
                  assign pcs = 0
                  if per_unit
                    assign tt = variant.title | downcase | remove: ' ' | split: 'x'
                    assign n = tt[0] | plus: 0
                    assign g = tt[1] | remove: 'g' | plus: 0
                    assign pcs = n | times: g | divided_by: s.piece_g
                    if pcs > 0
                      assign label = n | append: ' × ' | append: g | append: 'g'
                    endif
                  endif
                -%}
                <label class="plo-size{% if variant.id == best_id %} is-best{% endif %}">
                  <input type="radio" name="plo-size-{{ section.id }}" value="{{ variant.id }}" data-price="{{ variant.price }}"{% if pcs > 0 %} data-pcs="{{ pcs }}"{% endif %}{% if variant.id == v.id %} checked{% endif %}{% unless variant.available %} disabled{% endunless %} data-plo-size>
                  <span>
                    {%- if variant.id == best_id -%}<em class="plo-size__tag">Best value</em>{%- endif -%}
                    <b>{{ label }}</b>
                    {%- if pcs > 0 -%}
                      {%- liquid
                        assign eff = variant.price
                        if has_sub
                          assign eff = variant.price | times: keep | divided_by: 100
                        endif
                        assign per = eff | times: 1.0 | divided_by: pcs | round | times: 1
                      -%}
                      <small data-plo-per>{%- render 'plaay-aed', fils: per -%} / truffle</small>
                    {%- endif -%}
                  </span>
                </label>
              {%- endfor -%}
            </div>
          </div>
        {%- endif -%}

        {%- if has_sub -%}
          <div class="plo-modes">
            <label class="plo-mode plo-mode--sub">
              <input type="radio" name="plo-mode-{{ section.id }}" value="sub" checked data-plo-mode>
              <span class="plo-mode__r" aria-hidden="true"></span>
              <span class="plo-mode__b">
                <span class="plo-mode__h"><b>Subscribe &amp; save {{ sub_pct }}%</b><span class="plo-mode__tag">Most popular</span></span>
                <span class="plo-mode__p"><b data-plo-sub>{%- render 'plaay-aed', fils: sub_price -%}</b> <s data-plo-was>{%- render 'plaay-aed', fils: v.price -%}</s> <em data-plo-save>save {% render 'plaay-aed', fils: save %}</em></span>
                <span class="plo-mode__n">{{ s.sub_note }}</span>
              </span>
            </label>
            <label class="plo-mode">
              <input type="radio" name="plo-mode-{{ section.id }}" value="one" data-plo-mode>
              <span class="plo-mode__r" aria-hidden="true"></span>
              <span class="plo-mode__b"><span class="plo-mode__h"><b>One-time</b><span data-plo-one>{%- render 'plaay-aed', fils: v.price -%}</span></span></span>
            </label>
          </div>
        {%- else -%}
          <p class="plo-buy__price" data-plo-one>{%- render 'plaay-aed', fils: v.price -%}</p>
        {%- endif -%}

        <div class="plo-buy__row">
          <div class="plo-step plo-step--lg">
            <button type="button" data-plo-q="-1" aria-label="One less">{%- render 'pl-icon', name: 'minus', size: 16, stroke: 2.2 -%}</button>
            <input type="number" name="quantity" value="1" min="1" max="20" inputmode="numeric" aria-label="Quantity" data-plo-qty>
            <button type="button" data-plo-q="1" aria-label="One more">{%- render 'pl-icon', name: 'plus', size: 16, stroke: 2.2 -%}</button>
          </div>
          <button type="submit" class="plo-btn plo-btn--full plo-buy__add" data-plo-add{% unless v.available %} disabled{% endunless %}>
            {%- if v.available -%}<span class="plo-buy__lbl">Add to bag</span><span class="plo-buy__p" data-plo-cta>{%- render 'plaay-aed', fils: cta_price -%}</span>{%- else -%}Sold out{%- endif -%}
          </button>
        </div>
        {%- if s.trust != blank -%}<p class="plo-buy__trust">{{ s.trust }}</p>{%- endif -%}
      {%- endform -%}
      {%- liquid
        capture d_ingredients
          render 'pl-mf-text', mf: product.metafields.arena.exact_ingredients
        endcapture
        capture d_allergens
          render 'pl-mf-text', mf: product.metafields.custom.allergens
        endcapture
        capture d_nutrition
          render 'pl-mf-text', mf: product.metafields.custom.nutrition_facts
        endcapture
        capture d_suitable
          render 'pl-mf-text', mf: product.metafields.custom.suitable_for
        endcapture
        capture d_shipping
          echo product.metafields.custom.shipping_policy | metafield_tag
        endcapture
        assign d_nutrition = d_nutrition | strip
        if d_nutrition == blank and pkey != blank
          capture d_nutrition
            render 'plo-photo-facts', key: pkey, want: 'nutrition'
          endcapture
        endif
        if d_allergens == blank and pkey != blank
          capture d_allergens
            render 'plo-photo-facts', key: pkey, want: 'allergens'
          endcapture
          if d_allergens != blank
            assign d_allergens = '<p>' | append: d_allergens | append: '</p>'
          endif
        endif
        assign d_storage = 'Keep refrigerated. Best at room temperature.'
        if product.title contains 'Truffle'
          assign d_storage = 'Keep refrigerated. Best cold.'
        endif
      -%}
      {%- liquid
        capture p_desc
          echo product.description
        endcapture
        capture p_nutrition
          echo d_nutrition
        endcapture
        capture p_storage
          echo '<p>' | append: d_storage | append: '</p>'
        endcapture
        capture p_shipping
          if d_shipping != blank
            echo d_shipping
          else
            echo '<p>Free delivery on orders over AED 75. 1–2 days across the UAE, 3–5 days to the GCC.</p>'
          endif
        endcapture
        assign t_names = 'Description|Ingredients|Allergens|Nutrition|Storage|Suitable for|Shipping' | split: '|'
        assign t_kinds = 'desc|ingredients|allergens|nutrition|storage|suitable|shipping' | split: '|'
      -%}
      <div class="plo-details" id="plo-details" data-plo-tabs>
        <div class="plo-tabs" role="tablist" aria-label="Product details">
          {%- assign on = true -%}
          {%- for name in t_names -%}
            {%- liquid
              case forloop.index
                when 1
                  assign body = p_desc
                when 2
                  assign body = d_ingredients
                when 3
                  assign body = d_allergens
                when 4
                  assign body = p_nutrition
                when 5
                  assign body = p_storage
                when 6
                  assign body = d_suitable
                when 7
                  assign body = p_shipping
              endcase
            -%}
            {%- if body != blank -%}
              <button type="button" class="plo-tab{% if on %} is-on{% endif %}" role="tab" id="plo-tab-{{ forloop.index }}" aria-controls="plo-pan-{{ forloop.index }}" aria-selected="{{ on }}" data-plo-tab="{{ forloop.index }}">{{ name }}</button>
              {%- assign on = false -%}
            {%- endif -%}
          {%- endfor -%}
        </div>
        {%- assign on = true -%}
        {%- for name in t_names -%}
          {%- liquid
            case forloop.index
              when 1
                assign body = p_desc
              when 2
                assign body = d_ingredients
              when 3
                assign body = d_allergens
              when 4
                assign body = p_nutrition
              when 5
                assign body = p_storage
              when 6
                assign body = d_suitable
              when 7
                assign body = p_shipping
            endcase
          -%}
          {%- if body != blank -%}
            <div class="plo-pan plo-rte" role="tabpanel" id="plo-pan-{{ forloop.index }}" aria-labelledby="plo-tab-{{ forloop.index }}" data-kind="{{ t_kinds[forloop.index0] }}"{% unless on %} hidden{% endunless %}>{{ body }}</div>
            {%- assign on = false -%}
          {%- endif -%}
        {%- endfor -%}
      </div>
    </div>
  </div>

  {%- if v.available -%}
    <div class="plo-sticky" data-plo-sticky>
      <span class="plo-sticky__pic" style="--tint: {{ tint }};">{%- if pkey != blank -%}{%- assign ph = 'plo-ph-' | append: pkey | append: '-1.jpg' -%}<img src="{{ ph | asset_url }}" alt="" loading="lazy" width="80" height="100" class="is-photo">{%- elsif product.featured_image -%}{{ product.featured_image | image_url: width: 120 | image_tag: loading: 'lazy', alt: '' }}{%- endif -%}</span>
      <span class="plo-sticky__t"><b>{{ product.title }}</b><span data-plo-sticky-p>{%- render 'plaay-aed', fils: cta_price -%}{% if has_sub %} · every 4 weeks{% endif %}</span></span>
      <button type="button" class="plo-btn" data-plo-sticky-add>Add to bag</button>
    </div>
  {%- endif -%}
</div>

{% schema %}
{
  "name": "Preview: product",
  "tag": "section",
  "settings": [
    { "type": "range", "id": "desc_words", "label": "Description length (words)", "min": 10, "max": 60, "step": 5, "default": 20 },
    { "type": "text", "id": "sub_note", "label": "Subscribe note", "default": "Every 4 weeks · free delivery · skip or cancel any time" },
    { "type": "text", "id": "trust", "label": "Line under the button", "default": "Halal · Made in the UAE · 1–2 day delivery" },
    { "type": "text", "id": "default_size", "label": "Default pack size (variant title)", "default": "10 x 60g" },
    { "type": "range", "id": "piece_g", "label": "Truffle piece weight (g), for the per-truffle price", "min": 0, "max": 30, "step": 1, "default": 15 },
    { "type": "product_list", "id": "flavours_1", "label": "Flavour set 1", "limit": 10 },
    { "type": "product_list", "id": "flavours_2", "label": "Flavour set 2", "limit": 10 },
    { "type": "product_list", "id": "flavours_3", "label": "Flavour set 3", "limit": 10 },
    { "type": "text", "id": "strip_words", "label": "Words dropped from flavour names (| separated)", "default": " Bar 12 x 35g| Bar x 12| Chocolate Truffles| Truffles| Slab 6 x 80g| Slab 6 x 35g|70% Dark Chocolate |Milk Chocolate |70% Dark Chocolate| Mousse" },
    { "type": "text", "id": "flavour_fallback", "label": "Flavour name when nothing is left", "default": "70% Dark" },
    { "type": "color", "id": "tint_default", "label": "Gallery tint (Option B)", "default": "#FFF7DD" },
    { "type": "textarea", "id": "tints", "label": "Gallery tint per product (handle:#hex, one per line)" }
  ]
}
{% endschema %}
