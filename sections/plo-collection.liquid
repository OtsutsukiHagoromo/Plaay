{%- comment -%}
  Option B collection page. Banner (uploaded banner metafield, else a theme photo per handle, with the
  backdrop colour behind the title and a few fact pills; Shop all shows the range tiles), range
  chips with counts, count + sort, a one-line Subscribe & Save strip, then the grid
  (snippets/plo-card) with load-more. Shop all without a sort shows one row per range.
  Every link keeps ?view= so the shopper stays in the option being previewed.
{%- endcomment -%}
{%- liquid
  assign s = section.settings
  assign view = template.suffix
  assign view_q = ''
  if view != blank
    assign view_q = 'view=' | append: view
  endif

  assign intro = s.intro
  if intro == blank and collection.description != blank
    assign intro = collection.description | strip_html | strip | truncatewords: 30
  endif
  assign current_sort = collection.sort_by | default: collection.default_sort_by

  comment
    Banner settings for this handle from "Banners" (handle|theme asset|backdrop colour|photo
    focus|fact;fact).
  endcomment
  assign b_asset = ''
  assign b_ink = '#081D48'
  assign b_tint = '#FFF6DE'
  assign b_pos = '85% 50%'
  assign b_facts = ''
  assign b_layout = ''
  assign b_mobile = ''
  assign b_lines = s.banners | newline_to_br | split: '<br />'
  for l in b_lines
    assign f = l | strip | split: '|'
    if f[0] == collection.handle
      assign b_asset = f[1] | strip
      if f[2] != blank
        assign b_tint = f[2] | strip
      endif
      if f[3] != blank
        assign b_pos = f[3] | strip
      endif
      assign b_facts = f[4] | split: ';'
      if f[5] != blank
        assign b_ink = f[5] | strip
      endif
      comment
        7th field "art": the photo fills the right of a rounded panel in its own backdrop colour
        (no tilted card); on phones it sits under the title.
      endcomment
      if f[6] != blank
        assign b_layout = f[6] | strip
      endif
      comment
        "image": a finished banner (headline in the artwork) shown whole, in a rounded frame;
        the 8th field is an optional mobile version of the artwork.
      endcomment
      assign b_mobile = f[7] | strip
    endif
  endfor
  assign min_price = collection.products | map: 'price' | sort | first
  comment
    Banner priority: collection metafields custom.banner (+ custom.banner_mobile) > the theme photo
    for this handle > a plain colour banner. (The old collection images were not made for banners.)
  endcomment
  assign banner_d = collection.metafields.custom.banner.value
  assign banner_m = collection.metafields.custom.banner_mobile.value
  assign has_photo = false
  if banner_d != blank or b_asset != blank
    assign has_photo = true
  endif

  assign is_all = false
  if collection.handle == s.all_handle or collection.handle == 'all'
    assign is_all = true
  endif
  comment
    Shop all, page 1, no sort picked: one row per range instead of one long grid.
  endcomment
  assign grouped = false
  if is_all and s.group_all and collection.sort_by == blank
    assign grouped = true
  endif

  assign chip_labels = s.chip_labels | split: '|'
  assign chip_handles = s.chip_handles | split: '|'
-%}
<div class="pl plo plo-coll">
  {%- paginate collection.products by s.per_page -%}
    {%- if b_layout == 'image' and b_asset != blank -%}
    <header class="plo-hero plo-hero--image{% if is_all %} plo-hero--all{% endif %}">
      <div class="plo-wrap">
        <h1 class="pl-vh">{{ collection.title }}</h1>
        <picture class="plo-hero__banner">
          {%- if b_mobile != blank -%}<source media="(max-width: 767px)" srcset="{{ b_mobile | asset_img_url: '600x' }} 600w, {{ b_mobile | asset_img_url: '900x' }} 900w, {{ b_mobile | asset_url }} 1200w" sizes="100vw">{%- endif -%}
          <img src="{{ b_asset | asset_img_url: '1400x' }}" srcset="{{ b_asset | asset_img_url: '800x' }} 800w, {{ b_asset | asset_img_url: '1200x' }} 1200w, {{ b_asset | asset_img_url: '1600x' }} 1600w, {{ b_asset | asset_url }} 1942w" sizes="(min-width: 1360px) 1280px, calc(100vw - 32px)" alt="{{ collection.title | escape }}" width="1942" height="809" loading="eager" fetchpriority="high">
        </picture>
      </div>
      {%- comment -%} No range tiles under an artwork banner: the range tabs below do that job. {%- endcomment -%}
    </header>
    {%- else -%}
    <header class="plo-hero{% if has_photo %} plo-hero--photo{% endif %}{% if is_all %} plo-hero--all{% endif %}{% if b_layout == 'art' and has_photo %} plo-hero--art{% endif %}" style="--tint: {{ b_tint }}; --ink: {{ b_ink }}; --pos: {{ b_pos }};">
      <div class="plo-wrap plo-hero__in">
        <div class="plo-hero__copy">
          <h1 class="plo-hero__t">{{ collection.title }}</h1>
          {%- if b_facts.size > 0 -%}
            <ul class="plo-hero__usps">
              {%- for x in b_facts -%}
                {%- assign x = x | strip -%}
                {%- if x == blank -%}{%- continue -%}{%- endif -%}
                {%- assign ux = x | split: ':' -%}
                {%- if ux.size > 1 -%}{%- assign ic = ux[0] -%}{%- assign lb = ux[1] -%}{%- else -%}{%- assign ic = 'check' -%}{%- assign lb = x -%}{%- endif -%}
                <li style="--i: {{ forloop.index }}">{{ lb }}</li>
              {%- endfor -%}
            </ul>
          {%- endif -%}
        </div>
        {%- if has_photo and b_layout == 'art' -%}
          <div class="plo-hero__art" aria-hidden="true">
            {%- if banner_d != blank -%}
              {{ banner_d | image_url: width: 1400 | image_tag: class: 'plo-hero__img', loading: 'eager', fetchpriority: 'high', sizes: '(min-width: 1024px) 640px, 100vw', widths: '600, 900, 1400', alt: '' }}
            {%- else -%}
              <img class="plo-hero__img" src="{{ b_asset | asset_url }}" srcset="{{ b_asset | asset_img_url: '600x' }} 600w, {{ b_asset | asset_img_url: '900x' }} 900w, {{ b_asset | asset_url }} 1055w" sizes="(min-width: 1024px) 640px, 100vw" alt="" width="1055" height="1491" loading="eager" fetchpriority="high">
            {%- endif -%}
          </div>
        {%- elsif has_photo -%}
          <div class="plo-hero__card">
            {%- if banner_d != blank -%}
              <picture>
                {%- if banner_m != blank -%}<source media="(max-width: 767px)" srcset="{{ banner_m | image_url: width: 800 }} 800w, {{ banner_m | image_url: width: 1200 }} 1200w" sizes="50vw">{%- endif -%}
                {{ banner_d | image_url: width: 1600 | image_tag: class: 'plo-hero__img', loading: 'eager', fetchpriority: 'high', sizes: '(min-width: 1024px) 50vw, 40vw', widths: '600, 1000, 1600', alt: '' }}
              </picture>
            {%- else -%}
              <img class="plo-hero__img" src="{{ b_asset | asset_img_url: '900x' }}" srcset="{{ b_asset | asset_img_url: '600x' }} 600w, {{ b_asset | asset_img_url: '900x' }} 900w, {{ b_asset | asset_url }} 1448w" sizes="(min-width: 1024px) 50vw, 100vw" alt="" width="1448" height="1086" loading="eager" fetchpriority="high">
            {%- endif -%}
          </div>
        {%- endif -%}
      </div>
      {%- if is_all -%}
        <div class="plo-wrap plo-hero__tiles">{%- render 'pl-menu-tiles', size: 'lg' -%}</div>
      {%- endif -%}
    </header>
    {%- endif -%}

    <div class="plo-wrap">
      <nav class="plo-chips" aria-label="Shop by type">
        {%- for h in chip_handles -%}
          {%- assign i = forloop.index0 -%}
          <a href="{{ routes.collections_url }}/{{ h }}{% if view_q != blank %}?{{ view_q }}{% endif %}"{% if collection.handle == h %} aria-current="page"{% endif %}>{{ chip_labels[i] }}<small>{{ collections[h].products_count }}</small></a>
        {%- endfor -%}
      </nav>

      {%- liquid
        comment
          Toolbar: product count, Filter (filters run in the page, assets/pl-opt.js initCollFilter)
          and Sort (a short list of the sorts shoppers use; each is a plain link).
          Filter groups: Subscribe & save, a price range slider, and optional tags
          (from "Filter tags"). Options that match nothing in this collection are hidden by the
          script, and so is the Filter button when nothing is left.
        endcomment
        assign sort_keys = 'manual|best-selling|price-ascending|price-descending|created-descending' | split: '|'
        assign sort_names = 'Featured|Best selling|Price: low to high|Price: high to low|Newest' | split: '|'
        assign sort_label = sort_names[0]
        for k in sort_keys
          if k == current_sort
            assign sort_label = sort_names[forloop.index0]
          endif
        endfor
        assign ftags = s.filter_tags | split: '|'
        assign sort_base = collection.url | append: '?'
        if view_q != blank
          assign sort_base = sort_base | append: view_q | append: '&'
        endif
      -%}
      <div class="plo-tools" data-plo-filter>
        <span class="plo-tools__n" data-plo-fcount data-total="{{ collection.products_count }}">{{ collection.products_count }} product{% if collection.products_count != 1 %}s{% endif %}</span>
        <div class="plo-tools__btns">
          <details class="plo-pop plo-pop--filter" data-plo-pop>
            <summary class="plo-tools__btn" data-plo-fbtn>{%- render 'pl-icon', name: 'filter', size: 15, stroke: 2.4 -%}<span>Filter</span><b data-plo-fbadge hidden></b></summary>
            <div class="plo-pop__panel plo-fpanel" role="group" aria-label="Filter products">
              <div class="plo-fpanel__head"><b>Filter</b><button type="button" class="plo-fpanel__x" data-plo-pop-close aria-label="Close">{%- render 'pl-icon', name: 'close', size: 18, stroke: 2.4 -%}</button></div>
              <div class="plo-fpanel__body">
                <fieldset class="plo-fgroup">
                  <legend>Save more</legend>
                  <label class="plo-fopt"><input type="checkbox" value="sub" data-plo-fopt data-label="Subscribe &amp; save"><span>Subscribe &amp; save<small data-plo-fn></small></span></label>
                </fieldset>
                <fieldset class="plo-fgroup plo-fprice" data-plo-fprice hidden>
                  <legend>Price</legend>
                  <div class="plo-fprice__hist" data-plo-hist aria-hidden="true"></div>
                  <div class="plo-fprice__track">
                    <input type="range" step="1" data-plo-pmin aria-label="Lowest price (AED)">
                    <input type="range" step="1" data-plo-pmax aria-label="Highest price (AED)">
                  </div>
                  <div class="plo-fprice__vals"><span data-plo-pminv></span><span data-plo-pmaxv></span></div>
                </fieldset>
                {%- if s.filter_tags != blank -%}
                  <fieldset class="plo-fgroup" data-group="tag">
                    <legend>{{ s.filter_tags_label | default: 'Dietary' }}</legend>
                    {%- for t in ftags -%}
                      {%- assign tl = t | strip -%}
                      <label class="plo-fopt"><input type="checkbox" value="t:{{ tl | handleize }}" data-plo-fopt data-label="{{ tl | escape }}"><span>{{ tl }}<small data-plo-fn></small></span></label>
                    {%- endfor -%}
                  </fieldset>
                {%- endif -%}
              </div>
              <div class="plo-fpanel__foot">
                <button type="button" class="plo-fpanel__clear" data-plo-fclear>Clear</button>
                <button type="button" class="plo-btn plo-btn--navy plo-fpanel__go" data-plo-pop-close>Show <span data-plo-fshow>{{ collection.products_count }}</span> products</button>
              </div>
            </div>
          </details>
          {%- if collection.sort_options.size > 0 -%}
            <details class="plo-pop plo-pop--sort" data-plo-pop>
              <summary class="plo-tools__btn"><span class="plo-tools__k">Sort:</span><span>{{ sort_label }}</span>{%- render 'pl-icon', name: 'chev-down', size: 13, stroke: 2.6 -%}</summary>
              <ul class="plo-pop__panel plo-sortlist" role="list">
                {%- for k in sort_keys -%}
                  <li><a href="{{ sort_base }}sort_by={{ k }}" rel="nofollow"{% if k == current_sort %} aria-current="true"{% endif %}>{{ sort_names[forloop.index0] }}{% if k == current_sort %}{% render 'pl-icon', name: 'check', size: 14, stroke: 3 %}{% endif %}</a></li>
                {%- endfor -%}
              </ul>
            </details>
          {%- endif -%}
        </div>
        <div class="plo-tools__active" data-plo-factive hidden></div>
      </div>

      {%- if s.show_promo -%}
        <a class="plo-substrip" href="{{ s.promo_url | default: '/pages/subscribe-save' }}">
          <span class="plo-substrip__ic" aria-hidden="true">{%- render 'pl-icon', name: 'refresh', size: 16, stroke: 2.2 -%}</span>
          <span class="plo-substrip__t"><b>{{ s.promo_heading }}</b> {{ s.promo_body }}</span>
          <span class="plo-substrip__go">{{ s.promo_btn }}</span>
        </a>
      {%- endif -%}

      {%- if grouped -%}
        {%- for h in chip_handles -%}
          {%- assign gc = collections[h] -%}
          {%- if h == collection.handle or gc == blank or gc.products_count == 0 -%}{%- continue -%}{%- endif -%}
          <section class="plo-range">
            <div class="plo-range__head">
              <h2 class="plo-range__t">{{ chip_labels[forloop.index0] }} <small>{{ gc.products_count }}</small></h2>
              <a class="plo-range__all" href="{{ gc.url }}{% if view_q != blank %}?{{ view_q }}{% endif %}">See all {% render 'pl-icon', name: 'arrow-right', size: 14, stroke: 2.4 %}</a>
            </div>
            <div class="plo-rel__row plo-range__row">
              {%- for product in gc.products limit: 50 -%}
                {%- render 'plo-card', product: product, eager: false, skip_new: true, view: template.suffix -%}
              {%- endfor -%}
            </div>
          </section>
        {%- endfor -%}
      {%- elsif collection.products.size > 0 -%}
        <div class="plo-lgrid">
          <div class="plo-grid">
            {%- liquid
              comment
                Shop all on "Featured": cards run range by range in tab order (Slabs, Truffles, Bars,
                Variety, Limited), anything in no range last. Other sorts keep Shopify's order.
              endcomment
              assign passes = 'all'
              if is_all and current_sort == 'manual'
                assign passes = chip_handles | join: ',' | remove_first: s.all_handle | append: ',other' | remove_first: ','
              endif
              assign passes = passes | split: ','
              assign last_range = passes.size | minus: 1
              assign placed = ','
              assign n = 0
            -%}
            {%- for pass in passes -%}
              {%- for product in collection.products -%}
                {%- liquid
                  assign key = ',' | append: product.id | append: ','
                  if placed contains key
                    continue
                  endif
                  if pass != 'all'
                    comment
                      The product's range: its first range in tab order, but Limited (the last tab)
                      wins, so limited editions sit together at the end.
                    endcomment
                    assign prange = 'other'
                    assign hi = 0
                    for h in passes
                      assign hi = hi | plus: 1
                      for col in product.collections
                        if col.handle == h
                          if prange == 'other'
                            assign prange = h
                          endif
                          if hi == last_range
                            assign prange = h
                          endif
                        endif
                      endfor
                    endfor
                    if prange != pass
                      continue
                    endif
                  endif
                  assign placed = placed | append: product.id | append: ','
                  assign n = n | plus: 1
                  assign eager = false
                  if n <= 4
                    assign eager = true
                  endif
                -%}
                {%- render 'plo-card', product: product, eager: eager, skip_new: true, view: template.suffix -%}
              {%- endfor -%}
            {%- endfor -%}
          </div>
        </div>
      {%- else -%}
        <p class="plo-empty">Nothing here yet. <a class="plo-u" href="{{ routes.collections_url }}/shop-all{% if view_q != blank %}?{{ view_q }}{% endif %}">Shop all</a></p>
      {%- endif -%}

      <p class="plo-empty" data-plo-fempty hidden>No products match these filters. <button type="button" class="plo-u" data-plo-fclear>Clear filters</button></p>

      {%- if paginate.next and grouped == false -%}
        {%- liquid
          assign shown = paginate.current_page | times: paginate.page_size
          assign next_url = paginate.next.url
          assign has_view = false
          if next_url contains 'view='
            assign has_view = true
          endif
          if view_q != blank and has_view == false
            if next_url contains '?'
              assign next_url = next_url | append: '&' | append: view_q
            else
              assign next_url = next_url | append: '?' | append: view_q
            endif
          endif
        -%}
        <div class="plo-more">
          <span>Showing {{ shown }} of {{ paginate.items }}</span>
          <a class="plo-btn plo-btn--sec" href="{{ next_url }}">Load more</a>
        </div>
      {%- endif -%}
    </div>
  {%- endpaginate -%}
</div>

{% schema %}
{
  "name": "Preview: collection",
  "tag": "section",
  "settings": [
    {
      "type": "textarea",
      "id": "intro",
      "label": "Intro (blank = collection description)"
    },
    {
      "type": "range",
      "id": "per_page",
      "label": "Products per page",
      "min": 8,
      "max": 48,
      "step": 4,
      "default": 16
    },
    {
      "type": "text",
      "id": "chip_labels",
      "label": "Chip labels (| separated)",
      "default": "All|Slabs|Truffles|Bars|Variety|Limited"
    },
    {
      "type": "text",
      "id": "chip_handles",
      "label": "Chip collection handles (| separated)",
      "default": "shop-all|new-chocolate-slabs|chocolate-truffles|chocolate-bars|variety-packs|limited-editions"
    },
    {
      "type": "textarea",
      "id": "banners",
      "label": "Range banners",
      "info": "One line per collection: handle|photo asset|colour|photo focus|icon:USP;icon:USP|text colour. A banner uploaded to the collection (metafield custom.banner) replaces the photo."
    },
    {
      "type": "text",
      "id": "all_handle",
      "label": "Shop all collection handle",
      "default": "shop-all"
    },
    {
      "type": "checkbox",
      "id": "group_all",
      "label": "Shop all: one row per range (until a sort is picked)",
      "default": true
    },
    {
      "type": "text",
      "id": "bars_handle",
      "label": "Collection that shows the bar-pack row",
      "default": "chocolate-bars"
    },
    {
      "type": "text",
      "id": "filter_tags",
      "label": "Filter: product tags (| separated)",
      "info": "e.g. Vegan|Keto-Friendly. Leave blank to hide. Only add tags that are set correctly on every product."
    },
    {
      "type": "text",
      "id": "filter_tags_label",
      "label": "Filter: tags group name",
      "default": "Dietary"
    },
    {
      "type": "checkbox",
      "id": "show_promo",
      "label": "Show Subscribe & Save strip",
      "default": true
    },
    {
      "type": "text",
      "id": "promo_heading",
      "label": "Strip, bold part",
      "default": "Subscribe & save 15%"
    },
    {
      "type": "text",
      "id": "promo_body",
      "label": "Strip, text",
      "default": "on every order, with free delivery. Skip or cancel any time."
    },
    {
      "type": "text",
      "id": "promo_btn",
      "label": "Strip, link label",
      "default": "How it works"
    },
    {
      "type": "url",
      "id": "promo_url",
      "label": "Promo link"
    }
  ]
}
{% endschema %}
