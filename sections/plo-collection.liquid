{%- comment -%}
  Option A / Option B preview: collection page. Head (label, title, intro, and for the bars
  collection a row of bar packs), type chips, count + sort, a one-line Subscribe & Save strip,
  product grid (snippets/plo-card) and a load-more link.
  Every link keeps ?view= so the shopper stays in the option being previewed.
{%- endcomment -%}
{%- liquid
  assign s = section.settings
  assign view = template.suffix
  assign view_q = ''
  if view != blank
    assign view_q = 'view=' | append: view
  endif

  assign intro = s.intro
  if intro == blank and collection.description != blank
    assign intro = collection.description | strip_html | strip | truncatewords: 30
  endif
  assign is_bars = false
  if collection.handle == s.bars_handle
    assign is_bars = true
  endif
  assign current_sort = collection.sort_by | default: collection.default_sort_by

  assign chip_labels = s.chip_labels | split: '|'
  assign chip_handles = s.chip_handles | split: '|'
  assign bars = 'plo-bar-caramel.png,plo-bar-cookies.png,plo-bar-mocha.png,plo-bar-peanut.png,plo-bar-pistachio.png' | split: ','
-%}
<div class="pl plo">
  {%- paginate collection.products by s.per_page -%}
    <header class="plo-lhead{% if is_bars %} plo-lhead--bars{% endif %}">
      <div class="plo-wrap" style="display:flex;flex-direction:column;gap:10px">
        <p class="plo-eyebrow plo-eyebrow--sec">{{ collection.products_count }} products</p>
        <h1 class="plo-title"><b>{{ collection.title }}</b></h1>
        {%- if intro != blank -%}<p class="plo-lhead__p">{{ intro }}</p>{%- endif -%}
        {%- if is_bars -%}
          <div class="plo-lhead__bars plo-box" aria-hidden="true">
            {%- for f in bars -%}<img src="{{ f | asset_url }}" alt="" loading="eager" width="160" height="260">{%- endfor -%}
          </div>
        {%- endif -%}
      </div>
    </header>

    <div class="plo-wrap">
      <nav class="plo-chips" aria-label="Shop by type">
        {%- for h in chip_handles -%}
          {%- assign i = forloop.index0 -%}
          <a href="{{ routes.collections_url }}/{{ h }}{% if view_q != blank %}?{{ view_q }}{% endif %}"{% if collection.handle == h %} aria-current="page"{% endif %}>{{ chip_labels[i] }}</a>
        {%- endfor -%}
      </nav>

      <div class="plo-sortbar plo-box">
        <span class="plo-sortbar__n">{{ collection.products_count }} products</span>
        {%- if collection.sort_options.size > 0 -%}
          <form method="get" action="{{ collection.url }}">
            {%- if view != blank -%}<input type="hidden" name="view" value="{{ view }}">{%- endif -%}
            <label for="plo-sort-{{ section.id }}">Sort:</label>
            <select id="plo-sort-{{ section.id }}" name="sort_by" onchange="this.form.submit()">
              {%- for option in collection.sort_options -%}
                <option value="{{ option.value | escape }}"{% if option.value == current_sort %} selected{% endif %}>{{ option.name | escape }}</option>
              {%- endfor -%}
            </select>
            <noscript><button type="submit">Go</button></noscript>
          </form>
        {%- endif -%}
      </div>

      {%- if s.show_promo -%}
        <a class="plo-substrip" href="{{ s.promo_url | default: '/pages/subscribe-save' }}">
          <span class="plo-substrip__ic" aria-hidden="true">{%- render 'pl-icon', name: 'refresh', size: 16, stroke: 2.2 -%}</span>
          <span class="plo-substrip__t"><b>{{ s.promo_heading }}</b> {{ s.promo_body }}</span>
          <span class="plo-substrip__go">{{ s.promo_btn }}</span>
        </a>
      {%- endif -%}

      {%- if collection.products.size > 0 -%}
        <div class="plo-lgrid">
          <div class="plo-grid">
            {%- for product in collection.products -%}
              {%- liquid
                assign eager = false
                if forloop.index <= 4
                  assign eager = true
                endif
              -%}
              {%- render 'plo-card', product: product, eager: eager, skip_new: true, view: template.suffix -%}
            {%- endfor -%}
          </div>
        </div>
      {%- else -%}
        <p class="plo-empty">Nothing here yet. <a class="plo-u" href="{{ routes.collections_url }}/shop-all{% if view_q != blank %}?{{ view_q }}{% endif %}">Shop all</a></p>
      {%- endif -%}

      {%- if paginate.next -%}
        {%- liquid
          assign shown = paginate.current_page | times: paginate.page_size
          assign next_url = paginate.next.url
          if view_q != blank
            if next_url contains '?'
              assign next_url = next_url | append: '&' | append: view_q
            else
              assign next_url = next_url | append: '?' | append: view_q
            endif
          endif
        -%}
        <div class="plo-more">
          <span>Showing {{ shown }} of {{ paginate.items }}</span>
          <a class="plo-btn plo-btn--sec" href="{{ next_url }}">Load more</a>
        </div>
      {%- endif -%}
    </div>
  {%- endpaginate -%}
</div>

{% schema %}
{
  "name": "Preview: collection",
  "tag": "section",
  "settings": [
    {
      "type": "textarea",
      "id": "intro",
      "label": "Intro (blank = collection description)"
    },
    {
      "type": "range",
      "id": "per_page",
      "label": "Products per page",
      "min": 8,
      "max": 48,
      "step": 4,
      "default": 16
    },
    {
      "type": "text",
      "id": "chip_labels",
      "label": "Chip labels (| separated)",
      "default": "All|Slabs|Truffles|Bars|Variety|Limited"
    },
    {
      "type": "text",
      "id": "chip_handles",
      "label": "Chip collection handles (| separated)",
      "default": "shop-all|new-chocolate-slabs|chocolate-truffles|chocolate-bars|variety-packs|limited-editions"
    },
    {
      "type": "text",
      "id": "bars_handle",
      "label": "Collection that shows the bar-pack row",
      "default": "chocolate-bars"
    },
    {
      "type": "checkbox",
      "id": "show_promo",
      "label": "Show Subscribe & Save strip",
      "default": true
    },
    {
      "type": "text",
      "id": "promo_heading",
      "label": "Strip, bold part",
      "default": "Subscribe & save 15%"
    },
    {
      "type": "text",
      "id": "promo_body",
      "label": "Strip, text",
      "default": "on every order, with free delivery. Skip or cancel any time."
    },
    {
      "type": "text",
      "id": "promo_btn",
      "label": "Strip, link label",
      "default": "How it works"
    },
    {
      "type": "url",
      "id": "promo_url",
      "label": "Promo link"
    }
  ]
}
{% endschema %}
