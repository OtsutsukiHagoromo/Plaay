{%- comment -%}
  Option B: "Made by a nutritionist". Navy band: founder card (photo, quote, name, Read our
  story) on the left, a grid of USP tiles on the right (icon, big claim, one line). USP blocks
  are editable; defaults are the claims the packs back up.
{%- endcomment -%}
{%- assign s = section.settings -%}
<div class="pl plo plo-fillb plo-whysec plo-why2{% if s.touch_prev %} plo-fillb-touch{% endif %}">
  <div class="plo-wrap plo-why2__grid">
    <div class="plo-why2__founder">
      <h2 class="plo-why2__h">{{ s.heading }} <span>{{ s.heading_light }}</span></h2>
      <figure class="plo-why2__card">
        {%- render 'plo-img', image: s.image, asset: s.image_asset, width: 600, alt: s.byline, class: 'plo-why2__pic' -%}
        <figcaption>
          <blockquote>{{ s.quote }}</blockquote>
          <p class="plo-why2__by">{{ s.byline }}</p>
          {%- if s.link_label != blank -%}<a class="plo-why2__link" href="{{ s.link_url | default: '/pages/for-the-geeks-1' }}">{{ s.link_label }} {% render 'pl-icon', name: 'arrow-right', size: 16, stroke: 2.4 %}</a>{%- endif -%}
        </figcaption>
      </figure>
    </div>
    <ul class="plo-why2__usps">
      {%- for block in section.blocks -%}
        {%- assign b = block.settings -%}
        <li class="plo-why2__usp" style="--c: {{ b.color }}; --i: {{ forloop.index }}" {{ block.shopify_attributes }}>
          <b>{{ b.big }}</b>
          <span>{{ b.small }}</span>
        </li>
      {%- endfor -%}
    </ul>
  </div>
</div>

{% schema %}
{
  "name": "Preview: why Plaay",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading, bold part", "default": "Made by a" },
    { "type": "text", "id": "heading_light", "label": "Heading, light part", "default": "nutritionist" },
    { "type": "image_picker", "id": "image", "label": "Founder photo" },
    { "type": "text", "id": "image_asset", "label": "Founder photo fallback (theme asset)", "default": "plo-rashi.jpg" },
    { "type": "text", "id": "quote", "label": "Quote", "default": "“You don’t need to earn chocolate.”" },
    { "type": "text", "id": "byline", "label": "Byline", "default": "Rashi Chowdhary, nutritionist and founder" },
    { "type": "text", "id": "link_label", "label": "Link label", "default": "Read our story" },
    { "type": "url", "id": "link_url", "label": "Link" },
    { "type": "checkbox", "id": "touch_prev", "label": "Sit flush against the band above", "default": false }
  ],
  "blocks": [
    { "type": "usp", "name": "USP", "settings": [
      { "type": "select", "id": "icon", "label": "Icon", "default": "sparkle", "options": [
        { "value": "sparkle", "label": "Sparkle" }, { "value": "leaf", "label": "Leaf" }, { "value": "heart", "label": "Heart" },
        { "value": "check", "label": "Check" }, { "value": "pin", "label": "Pin" }, { "value": "clock", "label": "Clock" }, { "value": "gift", "label": "Gift" } ] },
      { "type": "text", "id": "big", "label": "Claim", "default": "0 g refined sugar" },
      { "type": "text", "id": "small", "label": "Line", "default": "Sweetened with dates and coconut sugar" },
      { "type": "color", "id": "color", "label": "Icon colour", "default": "#FFB600" } ] }
  ]
}
{% endschema %}
