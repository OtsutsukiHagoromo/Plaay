{%- comment -%}
  Option A / Option B preview: shop by category. A: white outlined tiles with a packshot on the
  left. B: flavour-colour tiles with the packshot bleeding off the corner and a sticker arrow.
  Packshot = the block image, else the chosen product's featured image. A block with a
  full-bleed photo (theme asset) fills the tile instead, its backdrop matching the tile colour.
{%- endcomment -%}
{%- assign s = section.settings -%}
<div class="pl plo plo-sec">
  <div class="plo-wrap">
    {%- render 'plo-head', eyebrow: s.eyebrow, bold: s.heading, light: s.heading_light -%}
    <div class="plo-cats">
      {%- for block in section.blocks -%}
        {%- liquid
          assign b = block.settings
          assign pic = b.image
          if pic == blank and b.product != blank
            assign pic = b.product.featured_image
          endif
          assign href = b.url | default: '/collections/shop-all'
        -%}
        <a class="plo-cat plo-box{% if b.photo_asset != blank %} plo-cat--photo{% endif %}" href="{{ href }}" style="--tint: {{ b.tint }};{% if b.photo_pos != blank %} --pos: {{ b.photo_pos }};{% endif %}" {{ block.shopify_attributes }}>
          {%- if b.photo_asset != blank -%}
            <img class="plo-cat__photo" src="{{ b.photo_asset | asset_url }}" alt="" loading="lazy" width="1448" height="1086">
          {%- elsif pic != blank -%}{{ pic | image_url: width: 300 | image_tag: loading: 'lazy', alt: '' }}{%- endif -%}
          <span><span class="plo-cat__n">{{ b.title }}</span></span>
        </a>
      {%- endfor -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Preview: categories",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Label (Option A only)", "default": "Shop" },
    { "type": "text", "id": "heading", "label": "Heading, bold part", "default": "Find your" },
    { "type": "text", "id": "heading_light", "label": "Heading, light part", "default": "favourite" }
  ],
  "blocks": [
    {
      "type": "cat",
      "name": "Category",
      "settings": [
        { "type": "text", "id": "title", "label": "Title", "default": "Slabs" },
        { "type": "text", "id": "sub", "label": "Sub line", "default": "7 flavours" },
        { "type": "url", "id": "url", "label": "Link" },
        { "type": "product", "id": "product", "label": "Packshot from product" },
        { "type": "image_picker", "id": "image", "label": "Packshot (overrides product)" },
        { "type": "color", "id": "tint", "label": "Tile colour (Option B)", "default": "#FFF0B3" },
        { "type": "text", "id": "photo_asset", "label": "Full-bleed photo (theme asset file)", "info": "Fills the tile; set the tile colour to the photo's backdrop." },
        { "type": "text", "id": "photo_pos", "label": "Photo focus (CSS object-position)", "default": "85% 50%" }
      ]
    }
  ]
}
{% endschema %}
