{%- comment -%}
  Option A / Option B preview: a heading and a grid of product cards (snippets/plo-card).
  On a product page the product being viewed is left out, and at most `limit` cards show.
{%- endcomment -%}
{%- liquid
  assign s = section.settings
  assign current_id = 0
  if product
    assign current_id = product.id
  endif
  assign shown = 0
-%}
<div class="pl plo plo-sec">
  <div class="plo-wrap">
    {%- render 'plo-head', eyebrow: s.eyebrow, bold: s.heading, light: s.heading_light, link_label: s.link_label, link_url: s.link_url -%}
    <div class="plo-grid">
      {%- for p in s.products -%}
        {%- if p.id != current_id and shown < s.limit -%}
          {%- render 'plo-card', product: p, eager: false, view: template.suffix -%}
          {%- assign shown = shown | plus: 1 -%}
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Preview: product grid",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Label (Option A only)", "default": "Bestsellers" },
    { "type": "text", "id": "heading", "label": "Heading, bold part", "default": "What everyone" },
    { "type": "text", "id": "heading_light", "label": "Heading, light part (Option B)", "default": "buys" },
    { "type": "product_list", "id": "products", "label": "Products", "limit": 8 },
    { "type": "range", "id": "limit", "label": "Cards to show", "min": 2, "max": 8, "step": 2, "default": 4 },
    { "type": "text", "id": "link_label", "label": "Link label", "default": "Shop all" },
    { "type": "url", "id": "link_url", "label": "Link" }
  ]
}
{% endschema %}
