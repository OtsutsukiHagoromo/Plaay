{%- comment -%}
  Option B Wishlist page (templates/page.wishlist.json, /pages/wishlist).
  The saved list lives in the browser (localStorage "plaay_wishlist": product handles, written by
  the product page heart). assets/pl-opt.js (initWishlist) fetches each product and renders the
  same card as the collections (card v3) with a remove button; "+" uses the sitewide quick add.
  Empty list: a friendly note and a Shop all button. Bestsellers render below either way.
{%- endcomment -%}
{%- assign s = section.settings -%}
<div class="pl plo plo-wl" data-plo-wl>
  <header class="plo-cnt__hero" style="--tint: {{ s.tint }};">
    <div class="plo-wrap">
      <div class="plo-cnt__box plo-wl__box">
        {%- if s.eyebrow != blank -%}<span class="plo-cnt__tag">{{ s.eyebrow }}</span>{%- endif -%}
        <h1 class="plo-cnt__t">{{ s.heading }}</h1>
        <p class="plo-cnt__p" data-plo-wl-count>{{ s.intro }}</p>
      </div>
    </div>
  </header>

  <div class="plo-wrap plo-wl__body">
    <div class="plo-wl__loading" data-plo-wl-loading aria-live="polite">
      <span class="plo-wl__dot"></span><span class="plo-wl__dot"></span><span class="plo-wl__dot"></span>
      <span class="pl-vh">Loading your wishlist</span>
    </div>
    <div class="plo-grid plo-wl__grid" data-plo-wl-grid></div>
    <div class="plo-wl__empty" data-plo-wl-empty hidden>
      <i aria-hidden="true">{%- render 'pl-icon', name: 'heart', size: 28, stroke: 2.4 -%}</i>
      <h2>{{ s.empty_heading }}</h2>
      <p>{{ s.empty_text }}</p>
      <a class="plo-btn plo-btn--navy" href="{{ s.empty_url | default: '/collections/shop-all' }}">{{ s.empty_label }} {% render 'pl-icon', name: 'arrow-right', size: 16, stroke: 2.6 %}</a>
    </div>
  </div>

  {%- if s.products != blank -%}
    <div class="plo-wrap plo-wl__more">
      {%- render 'plo-head', bold: s.more_heading, light: s.more_heading_light, link_label: 'Shop all', link_url: '/collections/shop-all' -%}
      <div class="plo-grid">
        {%- for p in s.products limit: 4 -%}
          {%- render 'plo-card', product: p, eager: false, view: '' -%}
        {%- endfor -%}
      </div>
    </div>
  {%- endif -%}
</div>

{% schema %}
{
  "name": "Preview: wishlist page",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Tag", "default": "Saved" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "My Wishlist" },
    { "type": "text", "id": "intro", "label": "Intro", "default": "Your saved favourites, all in one place." },
    { "type": "color", "id": "tint", "label": "Hero colour", "default": "#F8A7D6" },
    { "type": "text", "id": "empty_heading", "label": "Empty heading", "default": "Nothing Saved Yet" },
    { "type": "text", "id": "empty_text", "label": "Empty text", "default": "Tap the heart on any product to save it here for later." },
    { "type": "text", "id": "empty_label", "label": "Empty button", "default": "Shop all" },
    { "type": "url", "id": "empty_url", "label": "Empty button link" },
    { "type": "text", "id": "more_heading", "label": "Suggestions heading, bold part", "default": "Our" },
    { "type": "text", "id": "more_heading_light", "label": "Suggestions heading, light part", "default": "Bestsellers" },
    { "type": "product_list", "id": "products", "label": "Suggestions", "limit": 4 }
  ],
  "presets": [{ "name": "Preview: wishlist page" }]
}
{% endschema %}
