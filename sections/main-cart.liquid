{%- comment -%}
  Cart page. [data-cart-page-root] is refreshed wholesale by assets/plaay-cart-gift-prompt.js
  (window.plaayRefreshCartPage fetches /cart?section_id=main-cart and swaps the root's innerHTML),
  and the <cart-items> host inside it is re-rendered by bundle.cart-items.js from the `cart-items`
  section. Both render snippets/cart-drawer-content.liquid with page: true.
{%- endcomment -%}
{{ 'pl-cart.css' | asset_url | stylesheet_tag }}

<quick-add data-module="quick-add" hidden></quick-add>

<div class="pl pl-cartpage" data-cart-page-root>
  <div class="pl-wrap">
    <header class="pl-cartpage__head">
      <h1 class="pl-h pl-h--2">Your bag{% if cart.item_count > 0 %} <span class="pl-cartpage__count">({{ cart.item_count }})</span>{% endif %}</h1>
    </header>
    {%- render 'cart-drawer-content', page: true -%}
  </div>
</div>

<script defer src="{{ 'plaay-cart-gift-prompt.js' | asset_url }}"></script>
<script defer src="{{ 'pl-cart.js' | asset_url }}"></script>

{% schema %}
{
  "name": "Cart",
  "settings": []
}
{% endschema %}
