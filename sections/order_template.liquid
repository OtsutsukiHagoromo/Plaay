{{ 'pl-account.css' | asset_url | stylesheet_tag }}
<script src="{{ 'pl-account.js' | asset_url }}" defer></script>

{%- liquid
  if order.cancelled
    assign o_status = 'Cancelled'
    assign o_status_cls = 'pl-tag--red'
  elsif order.fulfillment_status == 'fulfilled'
    assign o_status = 'Delivered'
    assign o_status_cls = 'pl-tag--green'
  elsif order.fulfillment_status == 'partial'
    assign o_status = 'Partly delivered'
    assign o_status_cls = 'pl-tag--yellow'
  else
    assign o_status = 'Processing'
    assign o_status_cls = 'pl-tag--navy'
  endif

  assign reorder_items = ''
  for item in order.line_items
    if item.variant_id != blank and item.quantity > 0
      if reorder_items != ''
        assign reorder_items = reorder_items | append: ','
      endif
      assign reorder_items = reorder_items | append: '{"id":' | append: item.variant_id | append: ',"quantity":' | append: item.quantity | append: '}'
    endif
  endfor
  assign order_reorder_json = '[' | append: reorder_items | append: ']'

  assign tracking_url = ''
  for item in order.line_items
    if tracking_url == '' and item.fulfillment.tracking_url != blank
      assign tracking_url = item.fulfillment.tracking_url
    endif
  endfor
-%}

<div class="pl pl-account">
  <div class="pl-wrap pl-acct">

    <aside class="pl-acct__rail pl-hide-m">
      <nav class="pl-card pl-acct-nav" aria-label="Account">
        <a href="{{ routes.account_url }}" class="pl-acct-nav__a">Overview</a>
        <a href="{{ routes.account_url }}#orders" class="pl-acct-nav__a is-on" aria-current="page">Orders {% render 'pl-icon', name: 'chev-right', size: 16, stroke: 2.2 %}</a>
        <a href="{{ routes.account_url }}#subscription" class="pl-acct-nav__a">Subscription</a>
        <a href="{{ routes.account_url }}#rewards" class="pl-acct-nav__a">Rewards</a>
        <a href="/pages/wishlist" class="pl-acct-nav__a">Saved flavours</a>
        <a href="{{ routes.account_addresses_url }}" class="pl-acct-nav__a">Addresses</a>
        <a href="{{ routes.account_url }}#details" class="pl-acct-nav__a">Your details</a>
        <a href="{{ routes.account_url }}#alerts" class="pl-acct-nav__a">Alerts</a>
        <a href="{{ routes.account_logout_url }}" class="pl-acct-nav__a pl-acct-nav__a--out">Sign out</a>
      </nav>
    </aside>

    <div class="pl-acct__main">
      <a href="{{ routes.account_url }}#orders" class="pl-acct__back">{% render 'pl-icon', name: 'chev-left', size: 16, stroke: 2.2 %} Back to account</a>

      <header class="pl-acct__head pl-acct__head--row">
        <div class="pl-col pl-gap1">
          <h1 class="pl-h pl-acct__title">Order {{ order.name }}</h1>
          <p class="pl-body pl-mute">Placed {{ order.created_at | date: '%d %b %Y' }} · {{ order.item_count }} {% if order.item_count == 1 %}item{% else %}items{% endif %}</p>
        </div>
        <div class="pl-row">
          <span class="pl-tag {{ o_status_cls }}">{{ o_status }}</span>
          {%- if order.financial_status != 'paid' and order.financial_status_label != blank -%}
            <span class="pl-tag pl-tag--mute">{{ order.financial_status_label }}</span>
          {%- endif -%}
        </div>
      </header>

      {%- if order.cancelled -%}
        <div class="pl-card pl-card--flat pl-order__notice">
          <p class="pl-b">This order was cancelled on {{ order.cancelled_at | date: '%d %b %Y' }}.</p>
          {%- if order.cancel_reason_label != blank -%}<p class="pl-small pl-mute">Reason: {{ order.cancel_reason_label }}</p>{%- endif -%}
        </div>
      {%- endif -%}

      <div class="pl-order">
        <section class="pl-card pl-acct-card" aria-labelledby="pl-order-items-h">
          <div class="pl-acct-card__head pl-acct-card__head--between">
            <h2 class="pl-h--4" id="pl-order-items-h">Items</h2>
            {%- if tracking_url != '' -%}
              <a href="{{ tracking_url }}" class="pl-small pl-b" target="_blank" rel="noopener">Track delivery</a>
            {%- elsif order.order_status_url != blank -%}
              <a href="{{ order.order_status_url }}" class="pl-small pl-b">Track order</a>
            {%- endif -%}
          </div>
          <ul class="pl-order__list" role="list">
            {%- for item in order.line_items -%}
              <li class="pl-order__item">
                <div class="pl-order__img">
                  {%- if item.image -%}
                    {%- assign item_alt = item.title | escape -%}
                    {{ item.image | image_url: width: 128 | image_tag: loading: 'lazy', widths: '64, 128', sizes: '64px', alt: item_alt }}
                  {%- else -%}
                    {{ 'product-1' | placeholder_svg_tag }}
                  {%- endif -%}
                </div>
                <div class="pl-order__meta">
                  <p class="pl-b">
                    {%- if item.product -%}<a href="{{ item.product.url }}">{{ item.product.title }}</a>{%- else -%}{{ item.title }}{%- endif -%}
                  </p>
                  {%- if item.variant.title != blank and item.variant.title != 'Default Title' -%}
                    <p class="pl-small pl-mute">{{ item.variant.title }}</p>
                  {%- endif -%}
                  {%- if item.selling_plan_allocation -%}
                    <span class="pl-tag pl-tag--yellow">{{ item.selling_plan_allocation.selling_plan.name }}</span>
                  {%- endif -%}
                  <p class="pl-small pl-mute">{{ item.quantity }} × {{ item.final_price | money_without_trailing_zeros }}</p>
                  {%- if item.fulfillment.tracking_number != blank -%}
                    <p class="pl-tiny pl-mute">Tracking {{ item.fulfillment.tracking_number }}</p>
                  {%- endif -%}
                </div>
                <p class="pl-order__line">{{ item.final_line_price | money_without_trailing_zeros }}</p>
              </li>
            {%- endfor -%}
          </ul>
        </section>

        <aside class="pl-order__side">
          <section class="pl-card pl-acct-card" aria-labelledby="pl-order-sum-h">
            <h2 class="pl-h--4" id="pl-order-sum-h">Summary</h2>
            <div class="pl-sum">
              <div class="pl-sum__row"><span class="pl-mute">Subtotal</span><span>{{ order.subtotal_price | money_without_trailing_zeros }}</span></div>
              {%- for d in order.discount_applications -%}
                <div class="pl-sum__row"><span class="pl-mute">{{ d.title | default: 'Discount' }}</span><span class="pl-green">− {{ d.total_allocated_amount | money_without_trailing_zeros }}</span></div>
              {%- endfor -%}
              <div class="pl-sum__row"><span class="pl-mute">Delivery</span><span>{% if order.shipping_price > 0 %}{{ order.shipping_price | money_without_trailing_zeros }}{% else %}Free{% endif %}</span></div>
              {%- if order.total_tax > 0 -%}
                <div class="pl-sum__row"><span class="pl-mute">VAT</span><span>{{ order.total_tax | money_without_trailing_zeros }}</span></div>
              {%- endif -%}
              <div class="pl-sum__row pl-sum__row--total"><span>Total</span><span>{{ order.total_price | money_without_trailing_zeros }}</span></div>
            </div>
            {%- if reorder_items != '' -%}
              <div class="pl-acct-card__actions">
                <button type="button" class="pl-btn pl-btn--md" data-plaay-reorder='{{ order_reorder_json | strip }}'><span data-label>Reorder</span></button>
              </div>
            {%- endif -%}
          </section>

          <section class="pl-card pl-acct-card" aria-labelledby="pl-order-addr-h">
            <h2 class="pl-h--4" id="pl-order-addr-h">Delivery and payment</h2>
            <div class="pl-order__addr">
              <div>
                <p class="pl-label">Delivery address</p>
                {%- if order.shipping_address -%}{{ order.shipping_address | format_address }}{%- else -%}<p class="pl-mute">Not needed</p>{%- endif -%}
              </div>
              <div>
                <p class="pl-label">Billing address</p>
                {%- if order.billing_address -%}{{ order.billing_address | format_address }}{%- else -%}<p class="pl-mute">Same as delivery</p>{%- endif -%}
              </div>
              {%- if order.shipping_methods.size > 0 -%}
                <div>
                  <p class="pl-label">Delivery method</p>
                  {%- for m in order.shipping_methods -%}<p>{{ m.title }}</p>{%- endfor -%}
                </div>
              {%- endif -%}
              {%- if order.payment_details.credit_card_company != blank -%}
                <div>
                  <p class="pl-label">Payment</p>
                  <p>{{ order.payment_details.credit_card_company }}{% if order.payment_details.credit_card_last_four_digits != blank %} ending {{ order.payment_details.credit_card_last_four_digits }}{% endif %}</p>
                </div>
              {%- endif -%}
            </div>
          </section>
        </aside>
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Order",
  "settings": []
}
{% endschema %}
