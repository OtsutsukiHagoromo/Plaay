{{ 'pl-account.css' | asset_url | stylesheet_tag }}

<div class="pl pl-account pl-account--auth">
  <div class="pl-wrap">
    <div class="pl-card pl-auth">
      <div class="pl-auth__intro">
        <h1 class="pl-h pl-h--2">Reset your password</h1>
        <p class="pl-body pl-mute">Choose a new password{% if email != blank %} for {{ email }}{% endif %}.</p>
      </div>

      {%- form 'reset_customer_password', class: 'pl-auth__form' -%}
        {%- if form.errors -%}
          <div class="pl-form-errors" role="alert" tabindex="-1" autofocus>{{ form.errors | default_errors }}</div>
        {%- endif -%}
        <label class="pl-auth__field" for="password">
          <span class="pl-label">New password</span>
          <input class="pl-input" type="password" name="customer[password]" id="password" autocomplete="new-password" placeholder="At least 5 characters" required {% if form.errors contains 'password' %}aria-invalid="true"{% endif %}>
        </label>
        <label class="pl-auth__field" for="password_confirmation">
          <span class="pl-label">Confirm password</span>
          <input class="pl-input" type="password" name="customer[password_confirmation]" id="password_confirmation" autocomplete="new-password" placeholder="Type it again" required {% if form.errors contains 'password_confirmation' %}aria-invalid="true"{% endif %}>
        </label>
        <button type="submit" class="pl-btn pl-btn--full">Reset password</button>
      {%- endform -%}

      <p class="pl-auth__alt pl-center pl-small">Remembered it? <a href="{{ routes.account_login_url }}">Sign in</a></p>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Reset password",
  "settings": []
}
{% endschema %}
