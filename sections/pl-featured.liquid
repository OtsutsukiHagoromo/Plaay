{%- comment -%}
  Plaay 2026 — featured products ("Bestsellers · 4 picks"). Product list (max 8) rendered
  as pl-tile, 2 columns on mobile / 4 on desktop. The head link appends the product count
  of the linked collection ("See all 27").
{%- endcomment -%}
{{ 'pl-home.css' | asset_url | stylesheet_tag }}
{%- liquid
  assign s = section.settings
  assign products = s.product_list
  assign col = s.link_collection | default: collections['shop-all']
  assign link_text = s.link_label
  assign link_href = s.link_url
  if col != blank
    if col.products_count > 0
      assign link_text = link_text | append: ' ' | append: col.products_count
    endif
    if link_href == blank
      assign link_href = col.url
    endif
  endif
  if link_href == blank
    assign link_href = '/collections/shop-all'
  endif
-%}
{%- if products.size > 0 or request.design_mode -%}
<div class="pl pl-section pl-featured" id="pl-{{ section.id }}">
  <div class="pl-wrap">
    <div class="pl-home-head">
      <div class="pl-home-head__t">
        {%- if s.eyebrow != blank -%}<span class="pl-eyebrow">{{ s.eyebrow | escape }}</span>{%- endif -%}
        {%- if s.heading != blank -%}<h2 class="pl-h pl-h--2">{{ s.heading | escape }}</h2>{%- endif -%}
      </div>
      {%- if s.link_label != blank -%}
        <a class="pl-home-head__link" href="{{ link_href }}">{{ link_text | escape }}{%- render 'pl-icon', name: 'chev-right', size: 16, stroke: 2.2 -%}</a>
      {%- endif -%}
    </div>
    {%- if products.size > 0 -%}
      <div class="pl-grid pl-grid--2 pl-grid--d4">
        {%- for product in products -%}
          {%- if forloop.index <= 2 -%}
            {%- render 'pl-tile', product: product, eager: true -%}
          {%- else -%}
            {%- render 'pl-tile', product: product, eager: false -%}
          {%- endif -%}
        {%- endfor -%}
      </div>
    {%- else -%}
      <div class="pl-card pl-card--cream pl-card--flat pl-featured__empty pl-small pl-mute">Pick up to 8 products in the section settings.</div>
    {%- endif -%}
  </div>
</div>
{%- endif -%}

{% schema %}
{
  "name": "Plaay featured products",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Bestsellers" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "4 picks" },
    { "type": "product_list", "id": "product_list", "label": "Products", "limit": 8 },
    { "type": "text", "id": "link_label", "label": "Link label", "info": "The product count of the linked collection is appended, e.g. \"See all 27\".", "default": "See all" },
    { "type": "collection", "id": "link_collection", "label": "Link collection (for the count and the link)" },
    { "type": "url", "id": "link_url", "label": "Link URL override" }
  ],
  "presets": [
    { "name": "Plaay featured products", "category": "Plaay 2026" }
  ]
}
{% endschema %}
