{%- comment -%}
  Fetched by assets/pl-cart.js (loadRecs):
  /recommendations/products?section_id=cart-page-recommendations&product_id=<id>&limit=4&intent=related
  pl-cart.js copies this section's innerHTML into [data-cart-page-recommendations] on the cart page.
{%- endcomment -%}
{%- if recommendations.performed and recommendations.products_count > 0 -%}
  {%- for product in recommendations.products limit: 4 -%}
    {%- render 'pl-tile', product: product, sizes: '(min-width: 1024px) 240px, 46vw' -%}
  {%- endfor -%}
{%- endif -%}
