{{ 'pl-account.css' | asset_url | stylesheet_tag }}
<script src="{{ 'pl-account.js' | asset_url }}" defer></script>

{%- liquid
  assign first_name = customer.first_name | strip
  if first_name != blank
    assign greet_name = first_name
  else
    assign greet_name = 'Plaayer'
  endif

  assign customer_tags_string = customer.tags | join: ' '
  assign is_subscriber = false
  if customer_tags_string contains 'Active Subscriber'
    assign is_subscriber = true
  endif

  # rewards ladder (same settings the cart ladder reads)
  assign ship_aed = settings.cart_tier_ship | default: 75
  assign a1 = settings.cart_tier_1_spend | default: 250
  assign l1 = settings.cart_tier_1_label | default: '7% off'
  assign a2 = settings.cart_tier_2_spend | default: 350
  assign l2 = settings.cart_tier_2_label | default: '10% off + Mystery Gift'
  assign a3 = settings.cart_tier_3_spend | default: 500
  assign l3 = settings.cart_tier_3_label | default: '15% off + Mystery Gift'
  assign ladder_amounts = ship_aed | append: ',' | append: a1 | append: ',' | append: a2 | append: ',' | append: a3 | split: ','
  assign ladder_labels = 'Free delivery|' | append: l1 | append: '|' | append: l2 | append: '|' | append: l3 | split: '|'
  assign cart_total = cart.original_total_price
  assign reached = -1
  for amt in ladder_amounts
    assign amt_fils = amt | times: 100
    if cart_total >= amt_fils
      assign reached = forloop.index0
    endif
  endfor
  assign next_index = reached | plus: 1
  assign last_index = ladder_amounts | size | minus: 1
  assign top_fils = ladder_amounts[last_index] | times: 100
  assign ladder_pct = 0
  if top_fils > 0
    assign ladder_pct = cart_total | times: 100 | divided_by: top_fils
  endif
  if ladder_pct > 100
    assign ladder_pct = 100
  endif
-%}

<div class="pl pl-account">
  <account-area data-module="account-area">
    <div class="pl-wrap pl-acct">

      <aside class="pl-acct__rail pl-hide-m">
        <nav class="pl-card pl-acct-nav" aria-label="Account">
          <a href="{{ routes.account_url }}" class="pl-acct-nav__a is-on" aria-current="page">Overview {% render 'pl-icon', name: 'chev-right', size: 16, stroke: 2.2 %}</a>
          <a href="{{ routes.account_url }}#orders" class="pl-acct-nav__a">Orders</a>
          <a href="{{ routes.account_url }}#subscription" class="pl-acct-nav__a">Subscription</a>
          <a href="{{ routes.account_url }}#rewards" class="pl-acct-nav__a">Rewards</a>
          <a href="/pages/wishlist" class="pl-acct-nav__a">Saved flavours</a>
          <a href="{{ routes.account_addresses_url }}" class="pl-acct-nav__a">Addresses</a>
          <a href="{{ routes.account_url }}#details" class="pl-acct-nav__a">Your details</a>
          <a href="{{ routes.account_url }}#alerts" class="pl-acct-nav__a">Alerts</a>
          <a href="{{ routes.account_logout_url }}" class="pl-acct-nav__a pl-acct-nav__a--out">Sign out</a>
        </nav>
      </aside>

      <div class="pl-acct__main">
        <header class="pl-acct__head">
          <h1 class="pl-h pl-acct__title">Hey, {{ greet_name }}.</h1>
          <p class="pl-body pl-mute">Orders, your subscription, rewards and alerts, in one place.</p>
        </header>

        <div class="pl-acct__grid">
          {%- comment -%} ---------- Your last order ---------- {%- endcomment -%}
          {%- if customer.orders.size > 0 -%}
            {%- liquid
              assign lo = customer.orders.first
              assign lo_count = lo.line_items.size
              assign lo_names = ''
              for li in lo.line_items limit: 2
                assign li_name = li.product.title | default: li.title
                if forloop.first
                  assign lo_names = li_name
                else
                  assign lo_names = lo_names | append: ' + ' | append: li_name
                endif
              endfor
              if lo_count > 2
                assign lo_extra = lo_count | minus: 2
                assign lo_names = lo_names | append: ' + ' | append: lo_extra | append: ' more'
              endif
              if lo.cancelled
                assign lo_status = 'Cancelled'
                assign lo_status_cls = 'pl-tag--red'
              elsif lo.fulfillment_status == 'fulfilled'
                assign lo_status = 'Delivered'
                assign lo_status_cls = 'pl-tag--green'
              elsif lo.fulfillment_status == 'partial'
                assign lo_status = 'Partly delivered'
                assign lo_status_cls = 'pl-tag--yellow'
              else
                assign lo_status = 'Processing'
                assign lo_status_cls = 'pl-tag--navy'
              endif
              assign reorder_items = ''
              for item in lo.line_items
                if item.variant_id != blank and item.quantity > 0
                  if reorder_items != ''
                    assign reorder_items = reorder_items | append: ','
                  endif
                  assign reorder_items = reorder_items | append: '{"id":' | append: item.variant_id | append: ',"quantity":' | append: item.quantity | append: '}'
                endif
              endfor
              assign latest_reorder_json = '[' | append: reorder_items | append: ']'
            -%}
            <article class="pl-card pl-acct-card" id="last-order">
              <div class="pl-acct-card__head">
                <span class="pl-acct-card__ic">{% render 'pl-icon', name: 'bag', size: 20 %}</span>
                <div class="pl-flex1">
                  <h2 class="pl-h--4">Your last order</h2>
                  <p class="pl-small pl-mute">{{ lo.name }} · {{ lo.created_at | date: '%d %b %Y' }}</p>
                </div>
                <span class="pl-tag {{ lo_status_cls }}">{{ lo_status }}</span>
              </div>
              <div class="pl-acct-order">
                <div class="pl-acct-thumbs" aria-hidden="true">
                  {%- for li in lo.line_items limit: 2 -%}
                    <span class="pl-acct-thumb">
                      {%- if li.image -%}
                        {{ li.image | image_url: width: 112 | image_tag: loading: 'lazy', widths: '56, 112', sizes: '56px', alt: '' }}
                      {%- endif -%}
                    </span>
                  {%- endfor -%}
                  {%- if lo_count > 2 -%}<span class="pl-acct-thumb">+{{ lo_count | minus: 2 }}</span>{%- endif -%}
                </div>
                <div class="pl-flex1">
                  <p class="pl-b">{{ lo_names }}</p>
                  <p class="pl-small pl-mute">{{ lo.item_count }} {% if lo.item_count == 1 %}item{% else %}items{% endif %} · {{ lo.total_price | money_without_trailing_zeros }}</p>
                </div>
              </div>
              <div class="pl-acct-card__actions">
                {%- if reorder_items != '' -%}
                  <button type="button" class="pl-btn pl-btn--md" data-plaay-reorder='{{ latest_reorder_json | strip }}'><span data-label>Reorder</span></button>
                {%- endif -%}
                <a href="{{ lo.customer_url }}" class="pl-btn pl-btn--md pl-btn--ghost">View order</a>
              </div>
            </article>
          {%- else -%}
            <article class="pl-card pl-acct-card" id="last-order">
              <div class="pl-acct-card__head">
                <span class="pl-acct-card__ic">{% render 'pl-icon', name: 'bag', size: 20 %}</span>
                <div class="pl-flex1">
                  <h2 class="pl-h--4">Your last order</h2>
                  <p class="pl-small pl-mute">No orders yet</p>
                </div>
              </div>
              <p class="pl-body pl-mute">Your first box is one tap away.</p>
              <div class="pl-acct-card__actions">
                <a href="{{ routes.collections_url }}/shop-all" class="pl-btn pl-btn--md">Shop bestsellers</a>
              </div>
            </article>
          {%- endif -%}

          {%- comment -%} ---------- Your subscription ---------- {%- endcomment -%}
          <article class="pl-card pl-acct-card" id="subscription">
            <div class="pl-acct-card__head">
              <span class="pl-acct-card__ic">{% render 'pl-icon', name: 'refresh', size: 20 %}</span>
              <div class="pl-flex1">
                <h2 class="pl-h--4">Your subscription</h2>
                <p class="pl-small pl-mute">{% if is_subscriber %}15% off every delivery{% else %}No subscription yet{% endif %}</p>
              </div>
              {%- if is_subscriber -%}<span class="pl-tag pl-tag--green">Active</span>{%- endif -%}
            </div>
            {%- if is_subscriber -%}
              <div>
                <p class="pl-b">Next delivery</p>
                <p class="pl-small pl-mute">Dates, skips and swaps live in your subscription portal. Skip, swap or cancel anytime.</p>
              </div>
              <div class="pl-acct-card__actions">
                <a href="/tools/recurring/login" class="pl-btn pl-btn--md">Manage subscription</a>
              </div>
            {%- else -%}
              <p class="pl-body pl-mute">Your favourites, every 4 weeks. 15% off every delivery, free delivery, always. Skip, swap or cancel anytime.</p>
              <div class="pl-acct-card__actions">
                <a href="/products/build-your-box" class="pl-btn pl-btn--md">Build your box</a>
              </div>
            {%- endif -%}
          </article>

          {%- comment -%} ---------- Rewards ladder ---------- {%- endcomment -%}
          <article class="pl-card pl-card--navy pl-acct-card" id="rewards">
            <div class="pl-acct-card__head">
              <span class="pl-acct-card__ic">{% render 'pl-icon', name: 'gift', size: 20 %}</span>
              <div class="pl-flex1">
                <span class="pl-eyebrow">Plaay rewards</span>
                <h2 class="pl-h--4">Rewards</h2>
              </div>
            </div>
            <div class="pl-ladder__track" aria-hidden="true"><div class="pl-ladder__fill" style="width: {{ ladder_pct }}%"></div></div>
            <ol class="pl-ladder">
              {%- for amt in ladder_amounts -%}
                {%- assign i = forloop.index0 -%}
                <li class="pl-ladder__row{% if i <= reached %} is-done{% elsif i == next_index %} is-next{% endif %}">
                  <span class="pl-ladder__dot" aria-hidden="true">
                    {%- if i <= reached -%}{% render 'pl-icon', name: 'check', size: 12, stroke: 3 %}{%- elsif i == next_index -%}{% render 'pl-icon', name: 'arrow-right', size: 12, stroke: 2.6 %}{%- endif -%}
                  </span>
                  <span class="pl-ladder__amt">AED {{ amt }}</span>
                  <span class="pl-ladder__lbl">{{ ladder_labels[i] }}</span>
                </li>
              {%- endfor -%}
            </ol>
            {%- if cart.item_count > 0 and reached < last_index -%}
              {%- assign remaining_fils = ladder_amounts[next_index] | times: 100 | minus: cart_total -%}
              <p class="pl-small pl-mute">{% render 'plaay-aed', fils: remaining_fils %} more in your bag unlocks {{ ladder_labels[next_index] }}. Applied automatically at checkout.</p>
            {%- else -%}
              <p class="pl-small pl-mute">Applied automatically at checkout.</p>
            {%- endif -%}
          </article>

          {%- comment -%} ---------- Saved flavours ---------- {%- endcomment -%}
          <article class="pl-card pl-acct-card pl-acct-card--link" id="saved">
            <a href="/pages/wishlist" class="pl-acct-card__head">
              <span class="pl-acct-card__ic pl-acct-card__ic--cream">{% render 'pl-icon', name: 'heart', size: 20 %}</span>
              <div class="pl-flex1">
                <h2 class="pl-h--4">Saved flavours</h2>
                <p class="pl-small pl-mute" data-pl-wishlist-count>Your wishlist</p>
              </div>
              <span class="pl-acct-row__r">{% render 'pl-icon', name: 'chev-right', size: 18 %}</span>
            </a>
            <p class="pl-body pl-mute">Tap the heart on any flavour and it lands here, ready to add to your next box.</p>
          </article>
        </div>

        {%- comment -%} ---------- Alerts ---------- {%- endcomment -%}
        <section class="pl-card pl-acct-card" id="alerts" aria-labelledby="pl-alerts-h">
          <div class="pl-acct-card__head pl-acct-card__head--between">
            <h2 class="pl-h--4" id="pl-alerts-h">Alerts</h2>
            <span class="pl-small pl-mute">Only if you want them</span>
          </div>
          <div class="pl-acct-rows">
            <a href="/pages/contact" class="pl-acct-row">
              <span class="pl-flex1">
                <span class="pl-acct-row__t">New drops</span>
                <span class="pl-acct-row__s">Limited editions and new slabs</span>
              </span>
              <span class="pl-acct-row__r">
                {%- if customer.accepts_marketing -%}<span class="pl-tag pl-tag--green">On</span>{%- endif -%}
                {% render 'pl-icon', name: 'chev-right', size: 18 %}
              </span>
            </a>
            <a href="/pages/contact" class="pl-acct-row">
              <span class="pl-flex1">
                <span class="pl-acct-row__t">Back in stock</span>
                <span class="pl-acct-row__s">Your saved flavours</span>
              </span>
              <span class="pl-acct-row__r">{% render 'pl-icon', name: 'chev-right', size: 18 %}</span>
            </a>
            <a href="/pages/contact" class="pl-acct-row">
              <span class="pl-flex1">
                <span class="pl-acct-row__t">The 3:30 pm reset</span>
                <span class="pl-acct-row__s">One nudge a day, on weekdays</span>
              </span>
              <span class="pl-acct-row__r">{% render 'pl-icon', name: 'chev-right', size: 18 %}</span>
            </a>
          </div>
          <details class="pl-acc pl-acct-pwa">
            <summary>
              <span class="pl-acct-pwa__ic" aria-hidden="true">{% render 'pl-icon', name: 'share', size: 18 %}</span>
              <span class="pl-flex1">
                <span class="pl-acc__t">Add Plaay to your Home Screen</span>
                <span class="pl-acc__s">Opens like an app, no App Store</span>
              </span>
              <span class="pl-btn pl-btn--navy pl-btn--sm pl-acct-pwa__cta">Show me how</span>
            </summary>
            <div class="pl-acc__body">
              <ol>
                <li><b>iPhone</b><span>In Safari, tap Share, then Add to Home Screen.</span></li>
                <li><b>Android</b><span>In Chrome, tap the menu, then Add to Home screen.</span></li>
              </ol>
            </div>
          </details>
        </section>

        {%- comment -%} ---------- Orders ---------- {%- endcomment -%}
        <section class="pl-card pl-acct-card" id="orders" aria-labelledby="pl-orders-h">
          <div class="pl-acct-card__head pl-acct-card__head--between">
            <h2 class="pl-h--4" id="pl-orders-h">Orders</h2>
            <span class="pl-small pl-mute">{{ customer.orders_count }} {% if customer.orders_count == 1 %}order{% else %}orders{% endif %}</span>
          </div>
          {%- if customer.orders.size > 0 -%}
            {%- paginate customer.orders by 20 -%}
              <div class="pl-orders">
                <div class="pl-orders__hd" aria-hidden="true">
                  <span class="pl-label">Items</span>
                  <span class="pl-label">Status</span>
                  <span class="pl-label">Total</span>
                  <span></span>
                </div>
                {%- for o in customer.orders -%}
                  {%- liquid
                    assign o_count = o.line_items.size
                    assign o_names = ''
                    for li in o.line_items limit: 2
                      assign li_name = li.product.title | default: li.title
                      if forloop.first
                        assign o_names = li_name
                      else
                        assign o_names = o_names | append: ' + ' | append: li_name
                      endif
                    endfor
                    if o_count > 2
                      assign o_extra = o_count | minus: 2
                      assign o_names = o_names | append: ' + ' | append: o_extra | append: ' more'
                    endif
                    if o.cancelled
                      assign o_status = 'Cancelled'
                      assign o_status_cls = 'pl-tag--red'
                    elsif o.fulfillment_status == 'fulfilled'
                      assign o_status = 'Delivered'
                      assign o_status_cls = 'pl-tag--green'
                    elsif o.fulfillment_status == 'partial'
                      assign o_status = 'Partly delivered'
                      assign o_status_cls = 'pl-tag--yellow'
                    else
                      assign o_status = 'Processing'
                      assign o_status_cls = 'pl-tag--navy'
                    endif
                  -%}
                  <a href="{{ o.customer_url }}" class="pl-orders__row" aria-label="Order {{ o.name }}, {{ o_status }}, {{ o.total_price | money_without_trailing_zeros }}">
                    <span class="pl-orders__items">
                      <span class="pl-b">{{ o_names }}</span>
                      <span class="pl-small pl-mute">{{ o.item_count }} {% if o.item_count == 1 %}item{% else %}items{% endif %} · {{ o.name }} · {{ o.created_at | date: '%d %b %Y' }}<span class="pl-orders__sub-total"> · {{ o.total_price | money_without_trailing_zeros }}</span></span>
                    </span>
                    <span class="pl-orders__status"><span class="pl-tag {{ o_status_cls }}">{{ o_status }}</span></span>
                    <span class="pl-orders__total">{{ o.total_price | money_without_trailing_zeros }}</span>
                    <span class="pl-orders__chev">{% render 'pl-icon', name: 'chev-right', size: 18 %}</span>
                  </a>
                {%- endfor -%}
              </div>
              {%- if paginate.pages > 1 -%}
                <nav class="pl-pager" aria-label="Orders pages">
                  {%- if paginate.previous -%}<a href="{{ paginate.previous.url }}#orders" class="pl-btn pl-btn--sm pl-btn--ghost">Newer</a>{%- endif -%}
                  <span class="pl-small pl-mute">Page {{ paginate.current_page }} of {{ paginate.pages }}</span>
                  {%- if paginate.next -%}<a href="{{ paginate.next.url }}#orders" class="pl-btn pl-btn--sm pl-btn--ghost">Older</a>{%- endif -%}
                </nav>
              {%- endif -%}
            {%- endpaginate -%}
          {%- else -%}
            <p class="pl-body pl-mute">No orders yet. Your first box will show up here.</p>
            <div class="pl-acct-card__actions">
              <a href="{{ routes.collections_url }}/shop-all" class="pl-btn pl-btn--md pl-btn--ghost">Shop all</a>
            </div>
          {%- endif -%}
        </section>

        {%- comment -%} ---------- Your details ---------- {%- endcomment -%}
        <section class="pl-card pl-acct-card" id="details" aria-labelledby="pl-details-h">
          <div class="pl-acct-card__head pl-acct-card__head--between">
            <h2 class="pl-h--4" id="pl-details-h">Your details</h2>
            <a href="{{ routes.account_addresses_url }}" class="pl-small pl-b">Manage addresses</a>
          </div>
          <dl class="pl-acct-dl">
            <div>
              <dt>Name</dt>
              <dd>{{ customer.name | default: 'Not added' }}</dd>
            </div>
            <div>
              <dt>Email</dt>
              <dd>{{ customer.email }}</dd>
            </div>
            <div>
              <dt>Phone</dt>
              <dd>{{ customer.phone | default: 'Not added' }}</dd>
            </div>
            <div>
              <dt>Default address</dt>
              <dd>{% if customer.default_address %}{{ customer.default_address | format_address }}{% else %}No address yet{% endif %}</dd>
            </div>
          </dl>
        </section>

        {%- comment -%} ---------- Mobile nav list ---------- {%- endcomment -%}
        <nav class="pl-card pl-acct-card pl-hide-d" aria-label="Account pages">
          <div class="pl-acct-rows pl-acct-rows--nav">
            <a href="#orders" class="pl-acct-row"><span class="pl-acct-row__t">Orders</span><span class="pl-acct-row__r">{% render 'pl-icon', name: 'chev-right', size: 18 %}</span></a>
            <a href="{{ routes.account_addresses_url }}" class="pl-acct-row"><span class="pl-acct-row__t">Addresses</span><span class="pl-acct-row__r">{% render 'pl-icon', name: 'chev-right', size: 18 %}</span></a>
            <a href="#details" class="pl-acct-row"><span class="pl-acct-row__t">Your details</span><span class="pl-acct-row__r">{% render 'pl-icon', name: 'chev-right', size: 18 %}</span></a>
            <a href="{{ routes.account_logout_url }}" class="pl-acct-row"><span class="pl-acct-row__t">Sign out</span><span class="pl-acct-row__r">{% render 'pl-icon', name: 'chev-right', size: 18 %}</span></a>
          </div>
        </nav>
      </div>
    </div>
  </account-area>
</div>

{% schema %}
{
  "name": "Account",
  "settings": []
}
{% endschema %}
