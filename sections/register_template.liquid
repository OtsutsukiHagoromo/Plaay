{{ 'pl-account.css' | asset_url | stylesheet_tag }}

<div class="pl pl-account pl-account--auth">
  <div class="pl-wrap">
    <div class="pl-card pl-auth">
      <div class="pl-auth__intro">
        <h1 class="pl-h pl-h--2">Create an account</h1>
        <p class="pl-body pl-mute">Reorder in one tap, follow every delivery and climb the rewards ladder.</p>
      </div>

      {%- form 'create_customer', class: 'pl-auth__form', novalidate: 'novalidate' -%}
        {%- if form.errors -%}
          <div class="pl-form-errors" role="alert" tabindex="-1" autofocus>{{ form.errors | default_errors }}</div>
        {%- endif -%}
        <input type="hidden" name="return_to" value="{{ routes.account_url }}">
        <label class="pl-auth__field" for="RegisterFirstName">
          <span class="pl-label">First name</span>
          <input class="pl-input" type="text" name="customer[first_name]" id="RegisterFirstName" value="{{ form.first_name }}" autocomplete="given-name" placeholder="First name" required>
        </label>
        <label class="pl-auth__field" for="RegisterLastName">
          <span class="pl-label">Last name</span>
          <input class="pl-input" type="text" name="customer[last_name]" id="RegisterLastName" value="{{ form.last_name }}" autocomplete="family-name" placeholder="Last name" required>
        </label>
        <label class="pl-auth__field" for="RegisterEmail">
          <span class="pl-label">Email</span>
          <input class="pl-input" type="email" name="customer[email]" id="RegisterEmail" value="{{ form.email }}" autocomplete="email" autocorrect="off" autocapitalize="off" placeholder="you@email.com" required {% if form.errors contains 'email' %}aria-invalid="true"{% endif %}>
        </label>
        <label class="pl-auth__field" for="RegisterPassword">
          <span class="pl-label">Password</span>
          <input class="pl-input" type="password" name="customer[password]" id="RegisterPassword" autocomplete="new-password" placeholder="At least 5 characters" required {% if form.errors contains 'password' %}aria-invalid="true"{% endif %}>
        </label>
        <button type="submit" class="pl-btn pl-btn--full">Sign up</button>
      {%- endform -%}

      <p class="pl-auth__alt pl-center pl-small">Already have an account? <a href="{{ routes.account_login_url }}">Sign in</a></p>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Sign up",
  "settings": [],
  "blocks": [
    {
      "type": "account_benefit",
      "name": "Account benefit (legacy, not shown)",
      "settings": [
        { "type": "image_picker", "id": "benefit_image", "label": "Benefit image" },
        { "type": "text", "id": "benefit_label", "label": "Benefit label" }
      ]
    }
  ]
}
{% endschema %}
