{%- comment -%}
  Option B Terms / policies page (templates/page.terms.json, /pages/terms-conditions).
  A rounded hero (.plo-cnt__box), then each policy as a readable document card. Desktop: a
  sticky contents list on the left; mobile: the contents as text tabs (jump links) above.
  Ends with links to the Shipping, Returns and Contact pages.
  Any text in the page's own content (Shopify admin) shows as the first card.
{%- endcomment -%}
{%- liquid
  assign s = section.settings
  assign docs = section.blocks | where: 'type', 'policy'
-%}
<div class="pl plo plo-terms">
  <header class="plo-cnt__hero" style="--tint: {{ s.tint }};">
    <div class="plo-wrap">
      <div class="plo-cnt__box">
        {%- if s.eyebrow != blank -%}<span class="plo-cnt__tag">{{ s.eyebrow }}</span>{%- endif -%}
        <h1 class="plo-cnt__t">{{ s.heading | default: page.title }}</h1>
        {%- if s.intro != blank -%}<p class="plo-cnt__p">{{ s.intro }}</p>{%- endif -%}
      </div>
    </div>
  </header>

  <div class="plo-wrap plo-terms__body">
    <nav class="plo-terms__nav" aria-label="On this page">
      <span class="plo-terms__k">On this page</span>
      <ul>
        {%- for block in docs -%}<li><a href="#policy-{{ block.settings.title | handleize }}">{{ block.settings.title }}</a></li>{%- endfor -%}
      </ul>
    </nav>
    <div class="plo-terms__docs">
      {%- if page.content != blank -%}<article class="plo-terms__doc"><div class="plo-terms__rte">{{ page.content }}</div></article>{%- endif -%}
      {%- for block in docs -%}
        <article class="plo-terms__doc" id="policy-{{ block.settings.title | handleize }}" {{ block.shopify_attributes }}>
          <h2>{{ block.settings.title }}</h2>
          <div class="plo-terms__rte">{{ block.settings.content }}</div>
        </article>
      {%- endfor -%}
    </div>
  </div>

  {%- if s.links_heading != blank -%}
    <div class="plo-wrap plo-terms__more">
      <h2 class="plo-shp__h">{{ s.links_heading }}</h2>
      <ul class="plo-terms__links">
        {%- assign links = s.links | newline_to_br | split: '<br />' -%}
        {%- for row in links -%}
          {%- assign p = row | strip | split: '|' -%}
          {%- if p.size < 2 -%}{%- continue -%}{%- endif -%}
          <li><a href="{{ p[1] | strip }}"><span>{{ p[0] | strip }}</span>{%- render 'pl-icon', name: 'arrow-right', size: 18, stroke: 2.6 -%}</a></li>
        {%- endfor -%}
      </ul>
    </div>
  {%- endif -%}
</div>

{% schema %}
{
  "name": "Preview: terms page",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Tag", "default": "Policies" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Terms & Policies" },
    { "type": "textarea", "id": "intro", "label": "Intro", "default": "The small print, kept simple. Questions? Our team is happy to help." },
    { "type": "color", "id": "tint", "label": "Hero colour", "default": "#EADCF6" },
    { "type": "text", "id": "links_heading", "label": "Links heading", "default": "More Help" },
    { "type": "textarea", "id": "links", "label": "Links (label|url per line)", "default": "Shipping & Delivery|/pages/shipping-policy\nReturns & Refunds|/pages/returns-refunds\nFAQs|/pages/faqs\nContact Us|/pages/contact" }
  ],
  "blocks": [
    { "type": "policy", "name": "Policy", "settings": [
      { "type": "text", "id": "title", "label": "Title" },
      { "type": "richtext", "id": "content", "label": "Text" } ] }
  ],
  "presets": [{ "name": "Preview: terms page" }]
}
{% endschema %}
