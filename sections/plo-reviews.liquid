{%- comment -%}
  Option A / Option B preview: reviews. Store rating + star breakdown, then photo and text
  review cards in a swipe row, then a link to all reviews. Rating and count come from the
  Judge.me shop metafields (falling back to theme settings); the breakdown counts are settings.
  A: labelled heading, white outlined boxes, navy stars. B: cream band, lifted cards, yellow stars.
{%- endcomment -%}
{%- liquid
  assign s = section.settings
  assign rating = shop.metafields.judgeme.all_reviews_rating | append: '' | times: 1.0
  assign count = shop.metafields.judgeme.all_reviews_count | append: '' | plus: 0
  if rating <= 0
    assign rating = settings.store_rating_value | append: '' | times: 1.0
  endif
  if count <= 0
    assign count = settings.store_rating_count | append: '' | plus: 0
  endif
  assign rating = rating | round: 1
  assign counts = s.breakdown | split: ','
  assign total = 0
  for c in counts
    assign total = total | plus: c
  endfor
  if total == 0
    assign total = 1
  endif
-%}
<div class="pl plo plo-fillb plo-revsec" id="plo-reviews">
  <div class="plo-wrap">
    {%- liquid
      assign count_s = count | append: ''
      assign h_bold = s.heading | replace: '[count]', count_s
      assign h_light = s.heading_light | replace: '[count]', count_s
    -%}
    {%- render 'plo-head', eyebrow: s.eyebrow, bold: h_bold, light: h_light, link_label: s.write_label, link_url: s.all_url -%}
    <div class="plo-revwrap">
      <div>
        <div class="plo-revsum plo-box">
          <div class="plo-revsum__score">
            <div class="plo-revsum__n">{{ rating }}<small>/5</small></div>
            {%- capture lbl -%}{{ rating }} out of 5 stars{%- endcapture -%}
            {%- render 'plo-stars', size: 15, label: lbl -%}
            <div class="plo-revsum__c">from <b>{{ count }}</b> reviews</div>
          </div>
          <div class="plo-revsum__bars">
            {%- for c in counts limit: s.rows -%}
              {%- liquid
                assign star = 6 | minus: forloop.index
                assign cn = c | plus: 0
                assign pct = cn | times: 100 | divided_by: total
                assign pct_label = pct | append: '%'
                if pct == 0 and cn > 0
                  assign pct_label = '<1%'
                endif
              -%}
              <div class="plo-hbar"><b>{{ star }}</b>{%- render 'pl-icon', name: 'star', size: 11 -%}<span class="plo-hbar__t"><i style="width: {{ pct }}%"></i></span><span>{{ pct_label | escape }}</span></div>
            {%- endfor -%}
          </div>
        </div>
      </div>
      <div class="plo-revs">
        {%- for block in section.blocks -%}
          {%- assign b = block.settings -%}
          <figure class="plo-rev plo-box{% if block.type == 'text' %} plo-rev--text{% endif %}" style="margin:0" {{ block.shopify_attributes }}>
            {%- if block.type == 'photo' -%}{%- render 'plo-img', image: b.image, asset: b.image_asset, width: 600, alt: b.name -%}{%- endif -%}
            <figcaption class="plo-rev__b">
              <div class="plo-rev__top">{%- render 'plo-stars', size: 12 -%}{%- if block.type == 'text' -%}<span class="plo-rev__ver">{%- render 'pl-icon', name: 'check', size: 12, stroke: 2.6 -%}Verified buyer</span>{%- endif -%}</div>
              <p class="plo-rev__q">“{{ b.quote }}”</p>
              <p class="plo-rev__w"><b>{{ b.name }}</b> · {{ b.product }}</p>
            </figcaption>
          </figure>
        {%- endfor -%}
      </div>
    </div>
    {%- if s.all_url != blank -%}
      <div class="plo-revs__all"><a class="plo-btn plo-btn--sec plo-btn--full" href="{{ s.all_url }}" style="height:50px">Read all {{ count }} reviews</a></div>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Preview: reviews",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Label (Option A only)",
      "default": "Reviews"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading, bold part",
      "default": "Loved by",
      "info": "[count] = live review count"
    },
    {
      "type": "text",
      "id": "heading_light",
      "label": "Heading, light part",
      "default": "[count] Plaayers"
    },
    {
      "type": "text",
      "id": "breakdown",
      "label": "Share of reviews for 5,4,3,2,1 stars (counts)",
      "default": "104,5,5,1,7"
    },
    {
      "type": "range",
      "id": "rows",
      "label": "Star rows to show",
      "min": 3,
      "max": 5,
      "step": 1,
      "default": 4
    },
    {
      "type": "text",
      "id": "write_label",
      "label": "Link label",
      "default": "Write a review"
    },
    {
      "type": "url",
      "id": "all_url",
      "label": "All reviews page"
    }
  ],
  "blocks": [
    {
      "type": "photo",
      "name": "Photo review",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Photo"
        },
        {
          "type": "text",
          "id": "image_asset",
          "label": "Photo fallback (theme asset file)"
        },
        {
          "type": "textarea",
          "id": "quote",
          "label": "Quote"
        },
        {
          "type": "text",
          "id": "name",
          "label": "Name"
        },
        {
          "type": "text",
          "id": "product",
          "label": "Product"
        }
      ]
    },
    {
      "type": "text",
      "name": "Text review",
      "settings": [
        {
          "type": "textarea",
          "id": "quote",
          "label": "Quote"
        },
        {
          "type": "text",
          "id": "name",
          "label": "Name"
        },
        {
          "type": "text",
          "id": "product",
          "label": "Product"
        }
      ]
    }
  ]
}
{% endschema %}
