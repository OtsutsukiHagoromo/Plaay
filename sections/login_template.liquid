{{ 'pl-account.css' | asset_url | stylesheet_tag }}
<script src="{{ 'pl-account.js' | asset_url }}" defer></script>

{%- comment -%}
  The recover form is rendered first (into a capture) so its posted / error state is known
  before the panel that holds it decides whether to start hidden. bundle.login-template.js
  toggles the "hidden" class on [data-forgotten-password] when [data-forgotten-password-btn] is clicked.
{%- endcomment -%}
{%- capture recover_form -%}
  {%- form 'recover_customer_password', class: 'pl-auth__form' -%}
    {%- assign recover_success = form.posted_successfully? -%}
    {%- if form.errors -%}
      {%- assign recover_has_errors = true -%}
      <div class="pl-form-errors" role="alert">{{ form.errors | default_errors }}</div>
    {%- endif -%}
    <label class="pl-auth__field" for="RecoverEmail">
      <span class="pl-label">Email</span>
      <input class="pl-input" type="email" name="email" id="RecoverEmail" value="" autocorrect="off" autocapitalize="off" autocomplete="email" placeholder="you@email.com" required>
    </label>
    <button type="submit" class="pl-btn pl-btn--full">Send reset link</button>
  {%- endform -%}
{%- endcapture -%}

<div class="pl pl-account pl-account--auth">
  <login-template data-module="login-template">
    <div class="pl-wrap">
      <div class="pl-card pl-auth">
        <div class="pl-auth__intro">
          <h1 class="pl-h pl-h--2">Sign in</h1>
          <p class="pl-body pl-mute">Orders, your subscription, rewards and alerts, in one place.</p>
        </div>

        {%- if recover_success -%}
          <p class="pl-form-ok" role="status" tabindex="-1" autofocus>{{ 'account.successful_password_reset' | t }}</p>
        {%- endif -%}

        {%- form 'customer_login', class: 'pl-auth__form', novalidate: 'novalidate' -%}
          {%- if form.errors -%}
            <div class="pl-form-errors" role="alert" tabindex="-1" autofocus>{{ form.errors | default_errors }}</div>
          {%- endif -%}
          <label class="pl-auth__field" for="CustomerEmail">
            <span class="pl-label">Email</span>
            <input class="pl-input" type="email" name="customer[email]" id="CustomerEmail" autocomplete="email" autocorrect="off" autocapitalize="off" placeholder="you@email.com" required {% if form.errors contains 'form' %}aria-invalid="true"{% endif %}>
          </label>
          <label class="pl-auth__field" for="CustomerPassword">
            <span class="pl-label">Password</span>
            <input class="pl-input" type="password" name="customer[password]" id="CustomerPassword" autocomplete="current-password" placeholder="Your password" required {% if form.errors contains 'form' %}aria-invalid="true"{% endif %}>
          </label>
          <button type="submit" class="pl-btn pl-btn--full">Sign in</button>
          <a href="#recover" class="pl-auth__link" data-forgotten-password-btn aria-controls="recover">Forgot your password?</a>
        {%- endform -%}

        <div id="recover" class="pl-auth__recover{% unless recover_has_errors %} hidden{% endunless %}" data-forgotten-password>
          <div>
            <h2 class="pl-h--4">Reset your password</h2>
            <p class="pl-small pl-mute">We will email you a link to set a new one.</p>
          </div>
          {{ recover_form }}
        </div>

        <p class="pl-auth__alt pl-center pl-small">Don't have an account? <a href="{{ routes.account_register_url }}">Sign up</a></p>
      </div>
    </div>
  </login-template>
</div>

{% schema %}
{
  "name": "Sign in",
  "settings": []
}
{% endschema %}
