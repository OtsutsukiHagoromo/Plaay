{%- comment -%}
  Plaay 2026 Build Your Box.

  Runs on a PRODUCT template (templates/product.byob.json). The product IS the box:
  each variant is one box size, and the variant price is the box price. There is no
  discount involved anywhere — the price the shopper sees is the variant price, and the
  per-unit line under it is that price divided by the unit count. That keeps the box out
  of the automatic-discount ladder entirely, so it can never compete with the 7/10/15%
  order discounts or the subscription plan.

  Unit count per size is read from the VARIANT TITLE's leading number, e.g. "5 slabs" -> 5.
  A variant whose title carries no number falls back to the matching tier_N_qty setting.

  Chosen flavours ride to the cart as visible line-item properties on the single box line.
  They are labels only: no component variant is ever added to the cart, so component stock
  is not decremented. Shopify's native bundles would decrement it but cannot carry a
  selling plan (docs: "Bundles can't be sold with selling plans"), and subscription was
  the priority, so the box is a plain product exactly like the Mix Pack of 5.
{%- endcomment -%}

{%- liquid
  assign s = section.settings
  assign sub_pct = 0
  assign default_plan_id = ''
  for group in product.selling_plan_groups
    for plan in group.selling_plans
      if default_plan_id == ''
        assign default_plan_id = plan.id
      endif
      for adj in plan.price_adjustments
        if adj.value_type == 'percentage' and adj.value > sub_pct
          assign sub_pct = adj.value
        endif
      endfor
    endfor
  endfor
  assign has_sub = false
  if default_plan_id != '' and sub_pct > 0
    assign has_sub = true
  endif
-%}

<div class="pl pl-byob" data-pl-byob
  data-has-sub="{% if has_sub %}true{% else %}false{% endif %}"
  data-plan="{{ default_plan_id }}"
  data-sub-pct="{{ sub_pct }}">

  <section class="pl-byob__hero">
    <div class="pl-wrap">
      {%- if s.eyebrow != blank -%}<span class="pl-eyebrow pl-byob__eyebrow">{{ s.eyebrow }}</span>{%- endif -%}
      <h1 class="pl-h pl-h--1 pl-byob__title">{{ s.heading | default: 'Build your box' }}</h1>
      {%- if s.subheading != blank -%}<p class="pl-byob__sub">{{ s.subheading }}</p>{%- endif -%}
    </div>
  </section>

  <div class="pl-wrap pl-byob__body">

    {%- comment -%} ---------- Step 1: box size ---------- {%- endcomment -%}
    <section class="pl-byob__step">
      <h2 class="pl-byob__steph"><span class="pl-byob__num">1</span>{{ s.size_heading | default: 'Choose your box size' }}</h2>
      <div class="pl-byob__sizes" role="tablist" aria-label="Box size">
        {%- for v in product.variants -%}
          {%- liquid
            assign n = v.title | split: ' ' | first | times: 1
            if n == 0
              assign key = 'tier_' | append: forloop.index | append: '_qty'
              assign n = s[key] | default: 0 | times: 1
            endif
            if n == 0
              continue
            endif
            assign unit_price = v.price | divided_by: n
            assign sub_price = 0
            if has_sub
              assign keep = 100 | minus: sub_pct
              assign sub_price = v.price | times: keep | divided_by: 100
            endif
            assign is_first = false
            if forloop.first
              assign is_first = true
            endif
          -%}
          <button type="button"
            class="pl-pack pl-byob__size{% if is_first %} is-on{% endif %}{% unless v.available %} is-off{% endunless %}"
            role="tab" aria-selected="{% if is_first %}true{% else %}false{% endif %}"
            data-pl-size
            data-variant="{{ v.id }}"
            data-qty="{{ n }}"
            data-price="{{ v.price }}"
            data-sub-price="{{ sub_price }}"
            {% unless v.available %}disabled{% endunless %}>
            {%- if s.best_value_index == forloop.index -%}
              <span class="pl-tag pl-tag--green pl-pack__tag">Best value</span>
            {%- endif -%}
            <span class="pl-check">{%- render 'pl-icon', name: 'check', size: 10, stroke: 3 -%}</span>
            <span class="pl-pack__l">{{ v.title }}</span>
            <span class="pl-pack__p">{%- render 'plaay-aed', fils: v.price -%}</span>
            <span class="pl-byob__unit">{%- render 'plaay-aed', fils: unit_price -%} each</span>
          </button>
        {%- endfor -%}
      </div>
      {%- if product.variants.size == 0 -%}
        <p class="pl-byob__warn">This box has no sizes yet. Add one variant per box size, titled with the unit count first, for example &ldquo;5 slabs&rdquo;.</p>
      {%- endif -%}
    </section>

    {%- comment -%} ---------- Step 2: flavours ---------- {%- endcomment -%}
    <section class="pl-byob__step">
      <h2 class="pl-byob__steph"><span class="pl-byob__num">2</span>{{ s.pick_heading | default: 'Fill your box' }}</h2>

      {%- assign tab_count = 0 -%}
      {%- for i in (1..3) -%}
        {%- assign ck = 'cat_' | append: i | append: '_collection' -%}
        {%- if s[ck] != blank -%}{%- assign tab_count = tab_count | plus: 1 -%}{%- endif -%}
      {%- endfor -%}

      {%- if tab_count > 1 -%}
        <div class="pl-tabs pl-byob__tabs" role="tablist" aria-label="Flavour type">
          <button type="button" class="pl-tab is-on" role="tab" aria-selected="true" data-pl-cat="all">All</button>
          {%- for i in (1..3) -%}
            {%- assign ck = 'cat_' | append: i | append: '_collection' -%}
            {%- assign lk = 'cat_' | append: i | append: '_label' -%}
            {%- if s[ck] != blank -%}
              <button type="button" class="pl-tab" role="tab" aria-selected="false" data-pl-cat="c{{ i }}">{{ s[lk] | default: collections[s[ck]].title }}</button>
            {%- endif -%}
          {%- endfor -%}
        </div>
      {%- endif -%}

      <div class="pl-byob__grid" data-pl-grid>
        {%- for i in (1..3) -%}
          {%- assign ck = 'cat_' | append: i | append: '_collection' -%}
          {%- if s[ck] == blank -%}{%- continue -%}{%- endif -%}
          {%- for p in collections[s[ck]].products limit: 40 -%}
            {%- liquid
              assign nm = p.title | replace: 'PLAAY ', '' | replace: 'Plaay ', ''
              assign nm = nm | split: ' Slab' | first | split: ' Bar' | first | split: ' Truffle' | first
              assign nm = nm | split: ' 12 x' | first | split: ' 10 x' | first | split: ' 6 x' | first | split: ' 2 x' | first
              assign nm = nm | split: ' 150' | first | strip
              if nm == blank
                assign nm = p.title
              endif
            -%}
            <div class="pl-byob__item" data-pl-item data-cat="c{{ i }}" data-name="{{ nm | escape }}">
              <div class="pl-byob__pic">
                {%- if p.featured_image -%}
                  {{ p.featured_image | image_url: width: 240 | image_tag: loading: 'lazy', widths: '120, 240', sizes: '110px', alt: '' }}
                {%- else -%}
                  {{ 'product-1' | placeholder_svg_tag: 'pl-byob__ph' }}
                {%- endif -%}
                <span class="pl-byob__qty" data-pl-badge hidden>0</span>
              </div>
              <span class="pl-byob__name">{{ nm }}</span>
              <div class="pl-byob__step2">
                <button type="button" class="pl-byob__pm" data-pl-dec aria-label="Remove one {{ nm | escape }}" disabled>
                  {%- render 'pl-icon', name: 'minus', size: 15, stroke: 2.6 -%}
                </button>
                <span class="pl-byob__n" data-pl-n>0</span>
                <button type="button" class="pl-byob__pm" data-pl-inc aria-label="Add one {{ nm | escape }}">
                  {%- render 'pl-icon', name: 'plus', size: 15, stroke: 2.6 -%}
                </button>
              </div>
            </div>
          {%- endfor -%}
        {%- endfor -%}
      </div>
      {%- if tab_count == 0 -%}
        <p class="pl-byob__warn">No flavour collections are set. Pick at least one collection in the theme editor.</p>
      {%- endif -%}
    </section>

    {%- comment -%} ---------- Step 3: how to buy ---------- {%- endcomment -%}
    {%- if has_sub -%}
      <section class="pl-byob__step">
        <h2 class="pl-byob__steph"><span class="pl-byob__num">3</span>{{ s.buy_heading | default: 'How often?' }}</h2>
        <div class="pl-buybox">
          <div class="pl-buy is-sub" data-pl-buy>
            <label class="pl-buy__opt pl-buy__opt--sub">
              <span class="pl-buy__head">
                <input type="radio" name="pl-byob-plan" value="sub" checked data-pl-plan-opt>
                <span class="pl-radio" aria-hidden="true"></span>
                <span class="pl-buy__title">Subscribe &amp; Save {{ sub_pct }}%</span>
                <span class="pl-tag">Most popular</span>
              </span>
              <span class="pl-buy__detail">
                <span class="pl-buy__prices">
                  <span class="pl-buy__now" data-pl-sub-price></span>
                  <span class="pl-buy__was" data-pl-sub-was></span>
                  <span class="pl-buy__save" data-pl-sub-save></span>
                </span>
                <span class="pl-buy__note">Free delivery &middot; skip, swap or cancel anytime</span>
              </span>
            </label>
            <label class="pl-buy__opt pl-buy__opt--one">
              <span class="pl-buy__head">
                <input type="radio" name="pl-byob-plan" value="one" data-pl-plan-opt>
                <span class="pl-radio" aria-hidden="true"></span>
                <span class="pl-buy__title">One-time</span>
                <span class="pl-buy__price" data-pl-one-price></span>
              </span>
            </label>
          </div>
        </div>
      </section>
    {%- endif -%}

    {%- if s.note != blank -%}<p class="pl-byob__note">{{ s.note }}</p>{%- endif -%}
  </div>

  {%- comment -%} ---------- sticky bar ---------- {%- endcomment -%}
  <div class="pl-sticky pl-byob__bar is-on" data-pl-bar>
    <div class="pl-byob__prog">
      <div class="pl-byob__progtop">
        <span class="pl-byob__count" data-pl-progress>0 of 0 chosen</span>
        <span class="pl-byob__total" data-pl-total></span>
      </div>
      <div class="pl-byob__track"><span class="pl-byob__fill" data-pl-fill style="width:0%"></span></div>
    </div>
    <button type="button" class="pl-btn pl-btn--navy pl-byob__add" data-pl-add disabled>
      <span data-pl-add-label>Add to bag</span>
    </button>
  </div>
</div>

{{ 'pl-byob.css' | asset_url | stylesheet_tag }}
<script src="{{ 'pl-byob.js' | asset_url }}" defer></script>

{% schema %}
{
  "name": "Build your box",
  "tag": "section",
  "settings": [
    { "type": "header", "content": "Intro" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Mix and match" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Build your box" },
    { "type": "textarea", "id": "subheading", "label": "Subheading", "default": "Pick any flavours you like. Same price as our ready-made packs." },
    { "type": "header", "content": "Step headings" },
    { "type": "text", "id": "size_heading", "label": "Step 1 heading", "default": "Choose your box size" },
    { "type": "text", "id": "pick_heading", "label": "Step 2 heading", "default": "Fill your box" },
    { "type": "text", "id": "buy_heading", "label": "Step 3 heading", "default": "How often?" },
    { "type": "header", "content": "Box sizes" },
    { "type": "paragraph", "content": "Sizes and prices come from the product's variants. Title each variant with the unit count first, for example \"5 slabs\". Prices are the box price, never a discount." },
    { "type": "range", "id": "best_value_index", "min": 0, "max": 5, "step": 1, "default": 3, "label": "Show 'Best value' on variant number (0 for none)" },
    { "type": "range", "id": "tier_1_qty", "min": 0, "max": 36, "step": 1, "default": 0, "label": "Variant 1 unit count (only if not in the title)" },
    { "type": "range", "id": "tier_2_qty", "min": 0, "max": 36, "step": 1, "default": 0, "label": "Variant 2 unit count (only if not in the title)" },
    { "type": "range", "id": "tier_3_qty", "min": 0, "max": 36, "step": 1, "default": 0, "label": "Variant 3 unit count (only if not in the title)" },
    { "type": "header", "content": "Flavours" },
    { "type": "text", "id": "cat_1_label", "label": "Tab 1 label", "default": "Slabs" },
    { "type": "collection", "id": "cat_1_collection", "label": "Tab 1 collection" },
    { "type": "text", "id": "cat_2_label", "label": "Tab 2 label", "default": "Truffles" },
    { "type": "collection", "id": "cat_2_collection", "label": "Tab 2 collection" },
    { "type": "text", "id": "cat_3_label", "label": "Tab 3 label" },
    { "type": "collection", "id": "cat_3_collection", "label": "Tab 3 collection" },
    { "type": "header", "content": "Footnote" },
    { "type": "textarea", "id": "note", "label": "Note under the picker", "default": "Every box ships free. Skip, swap or cancel a subscription any time." }
  ]
}
{% endschema %}
