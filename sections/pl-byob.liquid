{%- comment -%}
  Plaay 2026 Build Your Box.

  Runs on a PRODUCT template (templates/product.byob.json). The product carries one variant per
  piece type, and the variant price is the price of one piece:
    - a variant whose title contains "truffle" (e.g. "Truffle 60g", AED 24.20)
    - a variant whose title contains "slab"    (e.g. "Slab 80g",    AED 26.00)
  The shopper picks any number of flavours of either type (at least min_qty pieces in total, no
  upper limit). The box goes to the cart as one line per type: the type's variant at the number
  of pieces, so Shopify charges exactly pieces x piece price. Both lines carry the same hidden
  `_box` id and a visible "Flavours" property listing what goes in; the bag shows a box as a
  fixed set (no steppers) and removes all of its lines together (assets/pl-cart.js).

  Flavours are picker labels only: no flavour variant is added, so flavour stock is not
  decremented. That keeps the box a plain product that can carry a selling plan.
{%- endcomment -%}

{%- liquid
  assign s = section.settings
  assign min_qty = s.min_qty | default: 6

  assign v_truffle = nil
  assign v_slab = nil
  for v in product.variants
    assign vt = v.title | downcase
    if vt contains 'truffle' and v_truffle == nil
      assign v_truffle = v
    elsif vt contains 'slab' and v_slab == nil
      assign v_slab = v
    endif
  endfor

  assign sub_pct = 0
  assign default_plan_id = ''
  for group in product.selling_plan_groups
    for plan in group.selling_plans
      if default_plan_id == ''
        assign default_plan_id = plan.id
      endif
      for adj in plan.price_adjustments
        if adj.value_type == 'percentage' and adj.value > sub_pct
          assign sub_pct = adj.value
        endif
      endfor
    endfor
  endfor
  assign has_sub = false
  if s.offer_subscribe and default_plan_id != '' and sub_pct > 0
    assign has_sub = true
  endif

  comment
    The two tabs: type, label, collection and the variant that prices it.
  endcomment
  assign types = 'truffle,slab' | split: ','
-%}

<div class="pl pl-byob" data-pl-byob
  data-min="{{ min_qty }}"
  data-has-sub="{% if has_sub %}true{% else %}false{% endif %}"
  data-plan="{{ default_plan_id }}"
  data-sub-pct="{{ sub_pct }}">

  <section class="pl-byob__hero">
    <div class="pl-wrap">
      {%- if s.eyebrow != blank -%}<span class="pl-eyebrow pl-byob__eyebrow">{{ s.eyebrow }}</span>{%- endif -%}
      <h1 class="pl-h pl-h--1 pl-byob__title">{{ s.heading | default: 'Build your box' }}</h1>
      {%- if s.subheading != blank -%}<p class="pl-byob__sub">{{ s.subheading }}</p>{%- endif -%}
      <ul class="pl-byob__prices">
        {%- if v_truffle -%}<li><b>Truffle {{ s.truffle_size }}</b><span>{%- render 'plaay-aed', fils: v_truffle.price -%} each</span></li>{%- endif -%}
        {%- if v_slab -%}<li><b>Slab {{ s.slab_size }}</b><span>{%- render 'plaay-aed', fils: v_slab.price -%} each</span></li>{%- endif -%}
        <li><b>Any mix</b><span>{{ min_qty }} or more pieces</span></li>
      </ul>
    </div>
  </section>

  <div class="pl-wrap pl-byob__body">

    {%- comment -%} ---------- Step 1: flavours ---------- {%- endcomment -%}
    <section class="pl-byob__step">
      <h2 class="pl-byob__steph"><span class="pl-byob__num">1</span>{{ s.pick_heading | default: 'Fill your box' }}</h2>

      {%- if v_truffle and v_slab -%}
        <div class="pl-tabs pl-byob__tabs" role="tablist" aria-label="Piece type">
          <button type="button" class="pl-tab is-on" role="tab" aria-selected="true" data-pl-cat="all">All</button>
          <button type="button" class="pl-tab" role="tab" aria-selected="false" data-pl-cat="truffle">{{ s.truffle_label | default: 'Truffles' }}</button>
          <button type="button" class="pl-tab" role="tab" aria-selected="false" data-pl-cat="slab">{{ s.slab_label | default: 'Slabs' }}</button>
        </div>
      {%- endif -%}

      <div class="pl-byob__grid" data-pl-grid>
        {%- for type in types -%}
          {%- liquid
            if type == 'truffle'
              assign tv = v_truffle
              assign col = collections[s.truffle_collection]
            else
              assign tv = v_slab
              assign col = collections[s.slab_collection]
            endif
            if tv == nil or col == blank
              continue
            endif
            assign sub_price = 0
            if has_sub
              assign keep = 100 | minus: sub_pct
              assign sub_price = tv.price | times: keep | divided_by: 100
            endif
            assign seen = ''
          -%}
          {%- for p in col.products limit: 40 -%}
            {%- comment -%}
              These are retail collections, so one flavour arrives several times at different pack
              sizes, plus ready-made mix packs. Fold the pack wording away (case-insensitively),
              drop the mixes and keep the first tile per flavour.
            {%- endcomment -%}
            {%- liquid
              assign low = p.title | downcase
              assign nm = low | replace: 'plaay ', ''
              assign nm = nm | split: ' slab' | first | split: ' bar' | first | split: ' truffle' | first
              assign nm = nm | split: ' 12 x' | first | split: ' 10 x' | first | split: ' 6 x' | first | split: ' 2 x' | first
              assign nm = nm | split: ' 150' | first | split: ' 80gm' | first | split: ' 30g' | first | split: ' 60g' | first
              assign nm = nm | strip
              if nm == blank
                assign nm = low | strip
              endif
              assign key = '|' | append: nm | append: '|'
            -%}
            {%- if low contains 'mix pack' or low contains 'exclusive mix' or low contains 'variety' or low contains ' mix' -%}{%- continue -%}{%- endif -%}
            {%- if p.available == false -%}{%- continue -%}{%- endif -%}
            {%- if seen contains key -%}{%- continue -%}{%- endif -%}
            {%- assign seen = seen | append: key -%}
            <div class="pl-byob__item" data-pl-item
              data-cat="{{ type }}"
              data-name="{{ nm | escape }}"
              data-variant="{{ tv.id }}"
              data-price="{{ tv.price }}"
              data-sub-price="{{ sub_price }}">
              {%- liquid
                comment
                  One piece per tile, never a multipack:
                  - Truffles: the "2 x 60g" pack shot (two 60g boxes, truffles stacked by the left one),
                    cropped on Shopify's CDN to the clean right-hand box. Dense Chocolate Fudge has no
                    such shot, so its "10 x 60g" shot is cropped to the single 60g box instead.
                  - Slabs: the single-slab studio shot (theme assets plo-ph-<key>-1.jpg), no 6-pack badge.
                  Anything without one of these falls back to the product photo.
                endcomment
                assign pic = ''
                if type == 'truffle'
                  assign src = nil
                  assign want = '2 x 60'
                  assign cx = 0.582
                  assign cy = 0.09
                  assign cw = 0.308
                  assign ch = 0.83
                  if p.handle == 'dense-chocolate-fudge-truffle'
                    assign want = '10 x 60'
                    assign cx = 0.42
                    assign cy = 0.16
                    assign cw = 0.195
                    assign ch = 0.69
                  endif
                  for pv in p.variants
                    assign pvt = pv.title | downcase
                    if pvt contains want and pv.featured_image
                      assign src = pv.featured_image
                      break
                    endif
                  endfor
                  if src == nil and p.variants.size == 1 and want == '2 x 60'
                    assign src = p.featured_image
                  endif
                  if src
                    assign c_l = src.width | times: cx | round
                    assign c_t = src.height | times: cy | round
                    assign c_w = src.width | times: cw | round
                    assign c_h = src.height | times: ch | round
                    assign pic = src | image_url: height: 480, crop: 'region', crop_left: c_l, crop_top: c_t, crop_width: c_w, crop_height: c_h
                  endif
                else
                  assign pkey = ''
                  if nm contains 'hazelnut'
                    assign pkey = 'hazel'
                  elsif nm contains 'sea salt'
                    assign pkey = 'seasalt'
                  elsif nm contains 'caramel'
                    assign pkey = 'caramel'
                  elsif nm contains 'cheesecake'
                    assign pkey = 'cheese'
                  elsif nm contains 'toffee'
                    assign pkey = 'toffee'
                  elsif nm contains 'dark chocolate'
                    assign pkey = 'dark'
                  endif
                  if pkey != ''
                    assign pic = 'plo-ph-' | append: pkey | append: '-1.jpg' | asset_img_url: '480x'
                  endif
                endif
              -%}
              <div class="pl-byob__pic{% if pic != '' %} is-one{% if type == 'slab' %} is-studio{% endif %}{% endif %}">
                {%- if pic != '' -%}
                  <img src="{{ pic }}" alt="" loading="lazy" width="240" height="240">
                {%- elsif p.featured_image -%}
                  {{ p.featured_image | image_url: width: 240 | image_tag: loading: 'lazy', widths: '120, 240', sizes: '110px', alt: '' }}
                {%- else -%}
                  {{ 'product-1' | placeholder_svg_tag: 'pl-byob__ph' }}
                {%- endif -%}
                <span class="pl-byob__qty" data-pl-badge hidden>0</span>
              </div>
              <span class="pl-byob__name">{{ nm }}</span>
              <span class="pl-byob__each">{% if type == 'truffle' %}Truffle {{ s.truffle_size }}{% else %}Slab {{ s.slab_size }}{% endif %} · {% render 'plaay-aed', fils: tv.price %}</span>
              <div class="pl-byob__step2">
                <button type="button" class="pl-byob__pm" data-pl-dec aria-label="Remove one {{ nm | escape }}" disabled>
                  {%- render 'pl-icon', name: 'minus', size: 15, stroke: 2.6 -%}
                </button>
                <span class="pl-byob__n" data-pl-n>0</span>
                <button type="button" class="pl-byob__pm" data-pl-inc aria-label="Add one {{ nm | escape }}">
                  {%- render 'pl-icon', name: 'plus', size: 15, stroke: 2.6 -%}
                </button>
              </div>
            </div>
          {%- endfor -%}
        {%- endfor -%}
      </div>

      {%- if v_truffle == nil or v_slab == nil -%}
        <p class="pl-byob__warn">This box needs two variants: one titled with &ldquo;Truffle&rdquo; (priced per truffle) and one titled with &ldquo;Slab&rdquo; (priced per slab).{% if v_truffle or v_slab %} Only one was found, so only that type is shown.{% endif %}</p>
      {%- endif -%}
    </section>

    {%- comment -%} ---------- Step 2: how to buy ---------- {%- endcomment -%}
    {%- if has_sub -%}
      <section class="pl-byob__step">
        <h2 class="pl-byob__steph"><span class="pl-byob__num">2</span>{{ s.buy_heading | default: 'How often?' }}</h2>
        <div class="pl-buybox">
          <div class="pl-buy is-sub" data-pl-buy>
            <label class="pl-buy__opt pl-buy__opt--sub">
              <span class="pl-buy__head">
                <input type="radio" name="pl-byob-plan" value="sub" checked data-pl-plan-opt>
                <span class="pl-radio" aria-hidden="true"></span>
                <span class="pl-buy__title">Subscribe &amp; Save {{ sub_pct }}%</span>
                <span class="pl-tag">Most popular</span>
              </span>
              <span class="pl-buy__detail">
                <span class="pl-buy__prices">
                  <span class="pl-buy__now" data-pl-sub-price></span>
                  <span class="pl-buy__was" data-pl-sub-was></span>
                  <span class="pl-buy__save" data-pl-sub-save></span>
                </span>
                <span class="pl-buy__note">Free delivery &middot; skip, swap or cancel anytime</span>
              </span>
            </label>
            {%- comment -%} A subscription-only product (Shopify "requires selling plan") gets no one-time option. {%- endcomment -%}
            {%- unless product.requires_selling_plan -%}
            <label class="pl-buy__opt pl-buy__opt--one">
              <span class="pl-buy__head">
                <input type="radio" name="pl-byob-plan" value="one" data-pl-plan-opt>
                <span class="pl-radio" aria-hidden="true"></span>
                <span class="pl-buy__title">One-time</span>
                <span class="pl-buy__price" data-pl-one-price></span>
              </span>
            </label>
            {%- endunless -%}
          </div>
        </div>
      </section>
    {%- endif -%}

    {%- if s.note != blank -%}<p class="pl-byob__note">{{ s.note }}</p>{%- endif -%}
  </div>

  {%- comment -%} ---------- sticky bar ---------- {%- endcomment -%}
  <div class="pl-sticky pl-byob__bar is-on" data-pl-bar>
    <div class="pl-byob__prog">
      <div class="pl-byob__progtop">
        <span class="pl-byob__count" data-pl-progress>Pick {{ min_qty }} or more</span>
        <span class="pl-byob__total" data-pl-total></span>
      </div>
      <div class="pl-byob__track"><span class="pl-byob__fill" data-pl-fill style="width:0%"></span></div>
    </div>
    <button type="button" class="pl-btn pl-btn--navy pl-byob__add" data-pl-add disabled>
      <span data-pl-add-label>Add to bag</span>
    </button>
  </div>
</div>

{{ 'pl-byob.css' | asset_url | stylesheet_tag }}
<script src="{{ 'pl-byob.js' | asset_url }}" defer></script>

{% schema %}
{
  "name": "Build your box",
  "tag": "section",
  "settings": [
    { "type": "header", "content": "Intro" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Mix and match" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Build your box" },
    { "type": "textarea", "id": "subheading", "label": "Subheading", "default": "Pick any truffles and slabs you like, as many as you want." },
    { "type": "header", "content": "Step headings" },
    { "type": "text", "id": "pick_heading", "label": "Step 1 heading", "default": "Fill your box" },
    { "type": "text", "id": "buy_heading", "label": "Step 2 heading", "default": "How often?" },
    { "type": "header", "content": "Pieces" },
    { "type": "paragraph", "content": "Prices come from the product's variants: one titled with \"Truffle\" (price of one truffle) and one titled with \"Slab\" (price of one slab)." },
    { "type": "checkbox", "id": "offer_subscribe", "label": "Offer Subscribe & Save", "info": "Off: boxes are bought once, at the piece prices. On: the product's subscription plans are offered too.", "default": false },
    { "type": "range", "id": "min_qty", "min": 1, "max": 24, "step": 1, "default": 6, "label": "Fewest pieces in a box" },
    { "type": "text", "id": "truffle_label", "label": "Truffles tab label", "default": "Truffles" },
    { "type": "text", "id": "truffle_size", "label": "Truffle size", "default": "60g" },
    { "type": "collection", "id": "truffle_collection", "label": "Truffle flavours collection" },
    { "type": "text", "id": "slab_label", "label": "Slabs tab label", "default": "Slabs" },
    { "type": "text", "id": "slab_size", "label": "Slab size", "default": "80g" },
    { "type": "collection", "id": "slab_collection", "label": "Slab flavours collection" },
    { "type": "header", "content": "Footnote" },
    { "type": "textarea", "id": "note", "label": "Note under the picker", "default": "Boxes of 6 or more ship free." }
  ]
}
{% endschema %}
