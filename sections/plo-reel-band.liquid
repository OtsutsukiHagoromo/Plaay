{%- comment -%}
  Option B homepage: one looping brand video. Video only by default; adding a heading shows a
  short copy panel beside it (desktop) / over it (mobile).
  Mobile: the video card with the copy over a soft gradient at the bottom.
  Desktop: copy panel on the left, the video card on the right (same height).
  The clip is muted, loops, plays only while on screen (assets/pl-opt.js initReelBand) and stays
  on its poster for visitors who prefer reduced motion. Video: a Shopify-hosted video setting wins,
  otherwise the theme asset file.
{%- endcomment -%}
{%- liquid
  assign s = section.settings
  assign src = s.video_asset | asset_url
  if s.video != blank
    assign mp4 = s.video.sources | where: 'format', 'mp4' | first
    if mp4
      assign src = mp4.url
    endif
  endif
  assign poster = s.poster_asset | asset_url
  if s.video != blank and s.video.preview_image
    assign poster = s.video.preview_image | image_url: width: 900
  endif
-%}
<div class="pl plo plo-sec plo-rband{% if s.heading == blank %} plo-rband--solo{% endif %}" style="--panel: {{ s.panel }};">
  <div class="plo-wrap plo-rband__grid">
    {%- if s.heading != blank -%}
      <div class="plo-rband__copy">
        {%- if s.eyebrow != blank -%}<span class="plo-rband__tag">{{ s.eyebrow }}</span>{%- endif -%}
        <h2 class="plo-rband__t">{{ s.heading }}</h2>
        {%- if s.text != blank -%}<p class="plo-rband__p">{{ s.text }}</p>{%- endif -%}
        {%- if s.btn_label != blank -%}<a class="plo-btn plo-rband__btn" href="{{ s.btn_url | default: '/collections/shop-all' }}">{{ s.btn_label }} {% render 'pl-icon', name: 'arrow-right', size: 16, stroke: 2.6 %}</a>{%- endif -%}
      </div>
    {%- endif -%}
    {%- if s.btn_url != blank and s.heading == blank -%}<a class="plo-rband__media" href="{{ s.btn_url }}" aria-label="{{ s.btn_label | default: 'Shop now' | escape }}">{%- else -%}<div class="plo-rband__media">{%- endif -%}
      <video class="plo-rband__v" src="{{ src }}" poster="{{ poster }}" muted loop playsinline preload="metadata" aria-hidden="true" data-plo-rband></video>
    {%- if s.btn_url != blank and s.heading == blank -%}</a>{%- else -%}</div>{%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Preview: video band",
  "tag": "section",
  "settings": [
    { "type": "video", "id": "video", "label": "Video (Shopify)" },
    { "type": "text", "id": "video_asset", "label": "Video fallback (theme asset file)", "default": "plo-home-reel.mp4" },
    { "type": "text", "id": "poster_asset", "label": "Poster (theme asset file)", "default": "plo-home-reel-poster.jpg" },
    { "type": "text", "id": "eyebrow", "label": "Tag" },
    { "type": "text", "id": "heading", "label": "Heading (blank = video only)" },
    { "type": "textarea", "id": "text", "label": "Text" },
    { "type": "text", "id": "btn_label", "label": "Button label" },
    { "type": "url", "id": "btn_url", "label": "Button link" },
    { "type": "color", "id": "panel", "label": "Panel colour (desktop)", "default": "#FED8B4" }
  ],
  "presets": [{ "name": "Preview: video band" }]
}
{% endschema %}
