{%- comment -%} Bag drawer shell: assets/pl-cart.js opens and closes it (no webpack drawer module). {%- endcomment -%}
<site-drawers>
  {%- unless template.name == 'cart' -%}
    {%- render 'drawer-cart' -%}
  {%- endunless -%}

  <div class="fixed inset-0 w-full h-full bg-black bg-opacity-60 z-[15000] transition-all duration-500 opacity-0 invisible active:opacity-100 active:visible cursor-pointer" data-overlay></div>
</site-drawers>