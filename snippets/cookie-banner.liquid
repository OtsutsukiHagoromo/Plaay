{%- comment -%}
  Cookie notice: a small strip at the bottom, never a dialog. One short line, "OK" and a large ✕.
  It does not cover the page or stop scrolling, and it only shows once: tapping OK or ✕ hides it,
  and if the visitor simply carries on to another page it counts as seen and stays away.
  It is a notice only. Tracking is not gated by it (it never was: the old Accept and Dismiss
  both just stored the same cookie); consent itself is handled by Shopify's Customer Privacy settings.
  Phones: sits just above the tab bar. Desktop: a small card at the bottom left. On product pages it
  lifts above the sticky add-to-bag bar while that bar is showing.
{%- endcomment -%}
<style>
  .pl-cookie { position: fixed; z-index: 60; left: 12px; right: 12px; bottom: calc(var(--pl-tab-offset, var(--pl-tabbar-h, 64px)) + 10px + env(safe-area-inset-bottom)); display: flex; align-items: center; gap: 10px; padding: 8px 8px 8px 14px; border-radius: 14px; background: var(--pl-navy, #081D48); color: #fff; box-shadow: 0 8px 24px rgba(8, 29, 72, .28); font-size: 12.5px; line-height: 1.35; transform: translateY(0); opacity: 1; transition: transform .25s ease, opacity .25s ease, bottom .25s ease; }
  .pl-cookie[hidden] { display: none; }
  .pl-cookie.is-out { transform: translateY(12px); opacity: 0; pointer-events: none; }
  .pl-cookie p { flex: 1; margin: 0; min-width: 0; }
  .pl-cookie a { color: #fff; text-decoration: underline; text-underline-offset: 2px; }
  .pl-cookie__ok { flex: 0 0 auto; height: 32px; padding: 0 14px; border: 0; border-radius: 999px; background: var(--pl-yellow, #FFB600); color: var(--pl-navy, #081D48); font: inherit; font-size: 12.5px; font-weight: 800; cursor: pointer; }
  .pl-cookie__x { flex: 0 0 auto; display: inline-flex; align-items: center; justify-content: center; width: 36px; height: 36px; margin-left: -2px; border: 0; border-radius: 50%; background: rgba(255, 255, 255, .12); color: #fff; cursor: pointer; }
  .pl-cookie button:focus-visible { outline: 2px solid var(--pl-yellow, #FFB600); outline-offset: 2px; }
  @media (min-width: 1024px) {
    .pl-cookie { left: 20px; right: auto; bottom: 20px; max-width: 420px; }
  }
</style>

<div class="pl-cookie" role="region" aria-label="Cookie notice" data-pl-cookie hidden>
  <p>We use cookies to keep Plaay running smoothly. <a href="{{ routes.root_url | append: 'policies/privacy-policy' | replace: '//', '/' }}">Privacy</a></p>
  <button type="button" class="pl-cookie__ok" data-pl-cookie-close>OK</button>
  <button type="button" class="pl-cookie__x" data-pl-cookie-close aria-label="Close cookie notice">
    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" aria-hidden="true"><path d="M18 6 6 18"/><path d="m6 6 12 12"/></svg>
  </button>
</div>

<script>
  (function () {
    var KEY = 'plaay-cookie-consent', SEEN = 'plaay-cookie-seen';
    var box = document.querySelector('[data-pl-cookie]');
    if (!box) return;
    function get(k) { try { return localStorage.getItem(k); } catch (e) { return null; } }
    function set(k) { try { localStorage.setItem(k, 'true'); } catch (e) {} }
    function done() {
      set(KEY);
      document.cookie = 'HL-cookie=true; max-age=315360000; path=/; SameSite=Lax';
    }
    var hasCookie = document.cookie.indexOf('HL-cookie=true') > -1;
    if (get(KEY) === 'true' || hasCookie) { done(); return; }
    /* Shown on an earlier page and left alone: treat it as seen. */
    if (get(SEEN) === 'true') { done(); return; }
    set(SEEN);
    box.hidden = false;
    /* Keep clear of the product page's sticky add-to-bag bar. */
    var sticky = document.querySelector('[data-plo-sticky]');
    function lift() {
      if (box.hidden) return;
      if (sticky && sticky.offsetHeight && sticky.classList.contains('is-on')) {
        box.style.bottom = (parseFloat(getComputedStyle(sticky).bottom) || 0) + sticky.offsetHeight + 10 + 'px';
      } else {
        box.style.bottom = '';
      }
    }
    if (sticky && window.MutationObserver) {
      new MutationObserver(lift).observe(sticky, { attributes: true, attributeFilter: ['class'] });
      window.addEventListener('resize', lift);
      lift();
    }
    box.addEventListener('click', function (e) {
      if (!e.target.closest('[data-pl-cookie-close]')) return;
      done();
      box.classList.add('is-out');
      setTimeout(function () { box.hidden = true; }, 260);
    });
  })();
</script>
