{% style %}
  .cart_items_container::-webkit-scrollbar { width: 3px; }
  .cart_items_container::-webkit-scrollbar-track { background: #f0f0f0; }
  .cart_items_container::-webkit-scrollbar-thumb { background: rgba(2,29,73,0.25); border-radius: 4px; }
{% endstyle %}

<cart-drawer class="group/cart"
  data-module="drawer-cart"
  data-drawer="cart">
  <div class="translate-x-full opacity-0 invisible fixed inset-y-0 right-0 w-screen md:w-[65vw] lg:max-w-[620px] z-[17500] transition-all duration-500 group-active/cart:translate-x-0 group-active/cart:opacity-100 group-active/cart:visible" data-drawer>
    <div class="relative flex w-full h-full min-h-0 overflow-hidden z-10 flex-col" style="background-color: {{ settings.cart_drawer_background | default: '#ffffff' }}">

      {% comment %} Header {% endcomment %}
      <div class="flex items-center justify-between px-6 py-4 border-b border-dark-blue border-opacity-10 flex-shrink-0">
        <div class="flex items-center gap-3">
          <h3 class="text-xl text-dark-blue uppercase font-walsheim-bold">{{ 'cart-drawer.title' | t }}</h3>
          <span class="flex items-center justify-center w-6 h-6 text-xs bg-yellow rounded-full font-walsheim-bold text-dark-blue{% if cart.item_count == 0 %} hidden{% endif %}" data-cart-drawer-count-wrapper>
            <span data-cart-drawer-count>{{ cart.item_count }}</span>
          </span>
        </div>
        <button
          type="button"
          class="flex h-8 w-8 items-center justify-center rounded-full text-dark-blue transition-all hover:bg-dark-blue hover:text-white"
          aria-label="Close cart"
          data-close>
          <span class="h-4 w-4 flex">{% render 'icon-cross-thin' %}</span>
        </button>
      </div>

      {%- render 'cart-drawer-content' -%}

      {% comment %} Loading overlay {% endcomment %}
      <div class="flex items-center justify-center absolute inset-0 bg-black bg-opacity-30 opacity-0 invisible group-loading/cart:opacity-100 group-loading/cart:visible z-50">
        {%- render 'loader' type: 'light' -%}
      </div>

    </div>
  </div>
</cart-drawer>

{% comment %} Cart drawer: gift message prompt and discount-code field. - moved to assets/plaay-cart-gift-prompt.js {% endcomment %}
<script defer src="{{ 'plaay-cart-gift-prompt.js' | asset_url }}"></script>
