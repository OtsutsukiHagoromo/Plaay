{%- comment -%}
  Plaay 2026 cart drawer shell.

  JS contract (bundle.drawers.js / bundle.drawer-cart.js / the inline fallback in layout/theme.liquid):
    - site-drawers.activeDrawer = 'cart' finds [data-drawer="cart"] (this element) and calls .open()
    - Drawer.open() toggles the class `active` on <cart-drawer>; assets/pl-cart.css slides the inner
      [data-drawer] panel in on `cart-drawer.active`. Drawer.loading toggles `loading` the same way.
    - [data-close] buttons must live inside [data-drawer]; the drawer JS binds them on open and
      assets/pl-cart.js also delegates so buttons in re-rendered content keep working.
  Module stubs at the end make bundle.theme.js (an init-only loader) import every cart module even
  when the cart is empty on first paint, so re-rendered content upgrades correctly.
{%- endcomment -%}
{{ 'pl-cart.css' | asset_url | stylesheet_tag }}

<cart-drawer data-module="drawer-cart" data-drawer="cart">
  <div class="pl pl-drawer" data-drawer role="dialog" aria-modal="true" aria-label="Your bag" tabindex="-1">
    <div class="pl-drawer__panel">
      <header class="pl-drawer__head">
        <h2 class="pl-h pl-h--3 pl-drawer__title">
          <span>Your bag</span>
          <span data-cart-drawer-count-wrapper{% if cart.item_count == 0 %} class="hidden"{% endif %}>(<span data-cart-drawer-count>{{ cart.item_count }}</span>)</span>
        </h2>
        <button type="button" class="pl-iconbtn pl-drawer__close" aria-label="Close bag" data-close>
          {%- render 'pl-icon', name: 'close', size: 20, stroke: 2 -%}
        </button>
      </header>

      {%- render 'cart-drawer-content' -%}

      <div class="pl-cart__loading pl-drawer__loading" aria-hidden="true"><span class="pl-cart__spin"></span></div>
    </div>
  </div>

  {%- comment -%} Module stubs: never visible, only here so the loader imports the bundles. {%- endcomment -%}
  <div data-module="cart-recommendations" hidden></div>
  <div data-module="quick-add" hidden></div>
  <div data-module="cart-remove-button" hidden></div>
  <div data-module="quantity-adjuster" hidden></div>
  {%- comment -%} bundle.cart-items.js reads .promotion_message in its constructor (legacy free-shipping confetti); threshold never reached. {%- endcomment -%}
  <div class="promotion_message" data-total="{{ cart.total_price }}" data-threshold="999999999" hidden></div>
</cart-drawer>

<script defer src="{{ 'plaay-cart-gift-prompt.js' | asset_url }}"></script>
<script defer src="{{ 'pl-cart.js' | asset_url }}"></script>
