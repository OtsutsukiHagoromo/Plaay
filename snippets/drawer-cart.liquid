{%- comment -%}
  Plaay 2026 cart drawer shell.

  assets/pl-cart.js opens and closes it (plCart.open / plCart.closeDrawer): <cart-drawer> gets the
  class `active`, and assets/pl-cart.css slides the inner [data-drawer] panel in. [data-close]
  buttons, the overlay in snippets/drawers.liquid and Escape close it. pl-cart.js also runs every
  control inside (lines, quantities, picks, "You might also like").
{%- endcomment -%}
{%- comment -%}
  The drawer is closed on load, so its stylesheet loads without blocking the first paint. Until it
  arrives the drawer is kept out of view (custom.css forces its display, so this hides it another
  way); the onload adds .pl-cart-css to <html>, which lifts the rule.
{%- endcomment -%}
<style>html:not(.pl-cart-css) cart-drawer{position:fixed;left:0;top:0;width:0;height:0;overflow:hidden;visibility:hidden}</style>
<link rel="stylesheet" href="{{ 'pl-cart.css' | asset_url }}" media="print" onload="this.media='all';document.documentElement.classList.add('pl-cart-css')">
<noscript>{{ 'pl-cart.css' | asset_url | stylesheet_tag }}</noscript>

<cart-drawer data-drawer="cart">
  <div class="pl pl-drawer" data-drawer role="dialog" aria-modal="true" aria-label="Your bag" tabindex="-1">
    <div class="pl-drawer__panel">
      <header class="pl-drawer__head">
        <h2 class="pl-h pl-h--3 pl-drawer__title">
          <span>Your Bag</span>
          <span data-cart-drawer-count-wrapper{% if cart.item_count == 0 %} class="hidden"{% endif %}>(<span data-cart-drawer-count>{{ cart.item_count }}</span>)</span>
        </h2>
        <button type="button" class="pl-iconbtn pl-drawer__close" aria-label="Close bag" data-close>
          {%- render 'pl-icon', name: 'close', size: 20, stroke: 2 -%}
        </button>
      </header>

      {%- render 'cart-drawer-content' -%}

      <div class="pl-cart__loading pl-drawer__loading" aria-hidden="true"><span class="pl-cart__spin"></span></div>
    </div>
  </div>

</cart-drawer>

<script defer src="{{ 'plaay-cart-gift-prompt.js' | asset_url }}"></script>
<script defer src="{{ 'pl-cart.js' | asset_url }}"></script>
