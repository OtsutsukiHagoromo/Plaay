{%- comment -%}
  Floating Option A / Option B toggle, rendered by layout/theme.liquid on the preview templates
  only (template suffix option-a / option-b). Keeps the current path and swaps ?view=.
{%- endcomment -%}
{%- liquid
  assign path = request.path
  assign cur = template.suffix
-%}
<nav class="plo-switch" aria-label="Design preview">
  <span>Preview</span>
  <a href="{{ path }}?view=option-a"{% if cur == 'option-a' %} aria-current="true"{% endif %}>Option A</a>
  <a href="{{ path }}?view=option-b"{% if cur == 'option-b' %} aria-current="true"{% endif %}>Option B</a>
</nav>
