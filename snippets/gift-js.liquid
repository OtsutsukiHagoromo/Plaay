{%- comment -%}
  Plaay - mystery gift threshold. Must stay in step with snippets/cart-tier-bar.liquid:
  the gift is the reward attached to tier 2 of the permanent rewards ladder (AED 350),
  so the number emitted here is the same one the ladder shows as the gift stop.

  assets/plaay-gift.js compares this against the cart's ORIGINAL (pre-discount) total,
  so the percentage tier discounts can never remove a gift the shopper already earned.
{%- endcomment -%}
{%- liquid
  # The permanent rewards ladder goes live 5 Sep 2026 00:00 (Dubai / +04:00) - same
  # instant as the ladder in cart-tier-bar.liquid and the Shopify tier discounts.
  assign rewards_live = false
  assign rw_now = 'now' | date: '%s' | times: 1
  assign rw_start = '2026-09-05T00:00:00+04:00' | date: '%s' | times: 1
  if rw_now >= rw_start
    assign rewards_live = true
  endif

  # Plaay Day Sale (27-30 Sep 2026, Dubai / +04:00): the flat 20% automatic discount does
  # not combine with the rewards tier discounts, so during the window the ladder would
  # promise 7/10/15% that never applies. Show free delivery + the mystery gift instead,
  # with the gift raised to AED 440 in cart (~AED 352 paid after 20%). Self-reverts.
  assign pd_active = false
  if settings.bts_sale_enabled
    assign pd_start = '2026-09-27T00:00:00+04:00' | date: '%s' | times: 1
    assign pd_end = '2026-10-01T00:00:00+04:00' | date: '%s' | times: 1
    if rw_now >= pd_start and rw_now < pd_end
      assign pd_active = true
    endif
  endif

  if pd_active
    assign gift_threshold = 44000
  elsif settings.eid_sale_enabled
    assign gift_threshold = settings.eid_tier_1_spend | default: 250 | times: 100
  elsif rewards_live
    assign gift_threshold = settings.cart_tier_2_spend | default: 350 | times: 100
  else
    assign gift_threshold = 25000
  endif
-%}
{% comment %} Mystery-gift cart logic - moved to assets/plaay-gift.js {% endcomment %}
<script>window.plaayGiftConfig = { threshold: {{ gift_threshold }} };</script>
<script defer src="{{ 'plaay-gift.js' | asset_url }}"></script>
