{%- comment -%}
  Plaay - cart rewards ladder (server-rendered twin of assets/plaay-cart-tier-bar.js).

  Emits an ordered list of reward stops as data attributes and renders the same markup
  the JS produces, so the bar is correct on first paint and after every cart change.
  Keep the two in lockstep.

  Stops are chosen here:
    - Eid sale on        -> the Eid ladder (dormant, kept working)
    - rewards live       -> permanent 4-stop ladder (free delivery / 7% / 10% + gift / 15% + gift)
    - before go-live     -> the legacy free-delivery + mystery-gift pair

  Thresholds compare against cart.original_total_price (pre-discount) so the percentage
  tier discounts can never knock a shopper back down a tier they already earned.

  Renders in the cart drawer and on the /cart page, so it must not rely on element ids.
{%- endcomment -%}
{%- liquid
  assign ship_aed = settings.cart_tier_ship | default: 75

  # The permanent rewards ladder goes live 5 Sep 2026 00:00 (Dubai / +04:00), the same
  # instant the Shopify tier discounts start. Until then the cart keeps the old pair so
  # nothing promises a percentage off that would not actually apply at checkout.
  assign rewards_live = false
  assign rw_now = 'now' | date: '%s' | times: 1
  assign rw_start = '2026-09-05T00:00:00+04:00' | date: '%s' | times: 1
  if rw_now >= rw_start
    assign rewards_live = true
  endif

  assign amounts = ship_aed | append: ''
  assign labels = 'Free delivery'

  if settings.eid_sale_enabled
    assign a1 = settings.eid_tier_1_spend | default: 250
    assign l1 = settings.eid_tier_1_label | default: '20% Off + Mystery Gift'
    assign a2 = settings.eid_tier_2_spend | default: 400
    assign l2 = settings.eid_tier_2_label | default: '25% Off + Mystery Gift'
    assign a3 = settings.eid_tier_3_spend | default: 600
    assign l3 = settings.eid_tier_3_label | default: '30% Off + Mystery Gift'
    assign amounts = amounts | append: ',' | append: a1 | append: ',' | append: a2 | append: ',' | append: a3
    assign labels = labels | append: '|' | append: l1 | append: '|' | append: l2 | append: '|' | append: l3
  elsif rewards_live
    assign a1 = settings.cart_tier_1_spend | default: 250
    assign l1 = settings.cart_tier_1_label | default: '7% off'
    assign a2 = settings.cart_tier_2_spend | default: 350
    assign l2 = settings.cart_tier_2_label | default: '10% off + Mystery Gift'
    assign a3 = settings.cart_tier_3_spend | default: 500
    assign l3 = settings.cart_tier_3_label | default: '15% off + Mystery Gift'
    assign amounts = amounts | append: ',' | append: a1 | append: ',' | append: a2 | append: ',' | append: a3
    assign labels = labels | append: '|' | append: l1 | append: '|' | append: l2 | append: '|' | append: l3
  else
    assign amounts = amounts | append: ',250'
    assign labels = labels | append: '|Mystery Gift'
  endif

  assign stop_amounts = amounts | split: ','
  assign stop_labels = labels | split: '|'
  assign stop_count = stop_amounts | size
  assign last_index = stop_count | minus: 1
  assign last_fils = stop_amounts[last_index] | times: 100
  assign total = cart.original_total_price

  assign reached = -1
  for amt in stop_amounts
    assign amt_fils = amt | times: 100
    if total >= amt_fils
      assign reached = forloop.index0
    endif
  endfor

  assign bar_pct = total | times: 100 | divided_by: last_fils
  if bar_pct > 100
    assign bar_pct = 100
  endif
-%}

<div class="plaay-tier-bar" data-plaay-tier-bar data-stop-count="{{ stop_count }}"
  {%- for amt in stop_amounts %} data-stop-{{ forloop.index }}="{{ amt | times: 100 }}" data-stop-{{ forloop.index }}-label="{{ stop_labels[forloop.index0] | escape }}"{% endfor %}>

  <div data-plaay-tier-bar-inner>
    {%- if reached == last_index -%}
      <p class="plaay-tier-bar__msg plaay-tier-bar__msg--done">
        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg>
        All rewards unlocked! You're all set.
      </p>
    {%- elsif reached < 0 -%}
      {%- assign remaining_fils = stop_amounts[0] | times: 100 | minus: total -%}
      <p class="plaay-tier-bar__msg">
        Add <strong>{%- render 'plaay-aed', fils: remaining_fils -%}</strong> more for free delivery
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" style="display:inline;vertical-align:-2px"><rect x="1" y="3" width="15" height="13" rx="1"/><path d="M16 8h4l3 4v5h-7V8z"/><circle cx="5.5" cy="18.5" r="2.5"/><circle cx="18.5" cy="18.5" r="2.5"/></svg>
      </p>
    {%- else -%}
      {%- assign next_index = reached | plus: 1 -%}
      {%- assign remaining_fils = stop_amounts[next_index] | times: 100 | minus: total -%}
      <p class="plaay-tier-bar__msg">
        {% if reached == 0 %}🚚{% else %}🎁{% endif %} {{ stop_labels[reached] }} unlocked! Add <strong>{%- render 'plaay-aed', fils: remaining_fils -%}</strong> more for <strong>{{ stop_labels[next_index] }}</strong>
      </p>
    {%- endif -%}

    <div class="plaay-tier-bar__track" role="progressbar" aria-valuenow="{{ bar_pct }}" aria-valuemin="0" aria-valuemax="100">
      <div class="plaay-tier-bar__fill" style="width:{{ bar_pct }}%"></div>
    </div>

    <div class="plaay-tier-bar__pills">
      {%- for amt in stop_amounts -%}
        {%- assign amt_fils = amt | times: 100 -%}
        {%- assign pill_done = false -%}
        {%- if total >= amt_fils -%}{%- assign pill_done = true -%}{%- endif -%}
        <span class="plaay-tier-bar__pill{% if pill_done %} plaay-tier-bar__pill--done{% endif %}">
          {%- if pill_done -%}<svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg>{%- endif -%}
          {%- if forloop.first -%}{{ stop_labels[forloop.index0] }}{%- else -%}AED {{ amt }} &#8594; {{ stop_labels[forloop.index0] }}{%- endif -%}
        </span>
      {%- endfor -%}
    </div>
  </div>
</div>

{% comment %} Rewards ladder behaviour. - moved to assets/plaay-cart-tier-bar.js {% endcomment %}
<script defer src="{{ 'plaay-cart-tier-bar.js' | asset_url }}"></script>
