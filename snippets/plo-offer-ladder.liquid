{%- comment -%}
  Product page: delivery promise and spend rewards as one flat strip under "Add to bag".
  Top line: the delivery promise ("1–2 day UAE delivery", "Free 1–2 day delivery" once the bag
  plus this product reaches the free delivery spend) and a small pill with the next reward
  ("AED 145 → 10% off"). Under it, a slim bar with a dot at each stop, placed by spend and
  labelled on two lines ("10% off" over "AED 299+").
  Tiers come from the theme settings the cart uses (cart_tier_ship, cart_tier_1/2/3; a tier with
  spend 0 is off). assets/pl-opt.js (initOfferLadder) keeps it current as the bag, pack size,
  quantity or purchase option change.
  Usage: {% render 'plo-offer-ladder', price: cta_price %}
{%- endcomment -%}
{%- liquid
  assign ship = settings.cart_tier_ship | default: 0
  assign stops = ''
  if ship > 0
    assign stops = ship | append: ':Free delivery'
  endif
  assign t_spends = settings.cart_tier_1_spend | append: ',' | append: settings.cart_tier_2_spend | append: ',' | append: settings.cart_tier_3_spend | split: ','
  assign t_labels = settings.cart_tier_1_label | append: '|' | append: settings.cart_tier_2_label | append: '|' | append: settings.cart_tier_3_label | split: '|'
  assign top = ship
  # During a sitewide sale only free delivery is offered here; the % rewards don't apply.
  capture sale_on
    render 'sale-active'
  endcapture
  if sale_on contains '1'
    assign t_spends = ''
  endif
  for sp in t_spends
    assign spn = sp | plus: 0
    if spn > 0
      if stops != ''
        assign stops = stops | append: ','
      endif
      assign stops = stops | append: spn | append: ':' | append: t_labels[forloop.index0]
      if spn > top
        assign top = spn
      endif
    endif
  endfor
  assign stop_list = stops | split: ','
-%}
{%- if stop_list.size > 0 -%}
  <div class="plo-offer" data-plo-offer data-stops="{{ stops | escape }}" data-cart="{{ cart.original_total_price }}" data-price="{{ price }}">
    <p class="plo-offer__top">
      <span class="plo-offer__ship" data-plo-offer-ship>
        {%- render 'pl-icon', name: 'truck', size: 16, stroke: 2 -%}
        <span>1–2 day UAE delivery</span>
      </span>
      <span class="plo-offer__next" data-plo-offer-next hidden></span>
    </p>
    <div class="plo-offer__bar">
      <span class="plo-offer__fill" data-plo-offer-fill></span>
      {%- for st in stop_list -%}
        {%- assign kv = st | split: ':' -%}
        {%- assign at = kv[0] | times: 100 | divided_by: top -%}
        <span class="plo-offer__stop{% if forloop.last %} is-end{% endif %}" style="--at: {{ at }}%;" data-plo-offer-step>
          <i aria-hidden="true">{%- render 'pl-icon', name: 'check', size: 9, stroke: 3.4 -%}</i>
          <small><b>{{ kv[1] }}</b>AED {{ kv[0] }}+</small>
        </span>
      {%- endfor -%}
    </div>
  </div>
{%- endif -%}
