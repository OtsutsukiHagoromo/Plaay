{%- comment -%}
  Category tiles for the header's Shop panel (desktop) and the mobile menu sheet.
  One tile per collection: tinted card, pack shot, name, product count, optional tag.
  Pack shots come from the refreshed shoot (plo-ph-<key>-1.jpg) where there is one, else the
  collection's first product image. Collections with no products are skipped.
  Usage: {% render 'pl-menu-tiles', size: 'lg' %}  (lg = desktop panel, sm = mobile sheet)
{%- endcomment -%}
{%- liquid
  comment
    name | collection | tile colour | refreshed pack-shot key | tag | full-bleed photo | photo focus
    Tiles with a full-bleed photo use it as the whole tile (colour = the photo's backdrop).
    Only rows with a photo are shown, so the set always matches.
  endcomment
  assign rows = 'Truffles|chocolate-truffles|#F8A7D6|triple||plo-cat-truffles.jpg|96% 50%,Bars|chocolate-bars|#F8A7D6|pistbar||plo-cat-bars.jpg|78% 50%,Slabs|new-chocolate-slabs|#F8A7D6|hazel|New|plo-cat-slabs.jpg|94% 50%,Variety packs|variety-packs|#F8A7D6||Gifting|plo-cat-packs.jpg|96% 50%,Limited editions|limited-editions|#FFF0C4|||||' | split: ','
  assign n = 0
-%}
{%- for row in rows -%}
  {%- liquid
    assign f = row | split: '|'
    assign c = collections[f[1]]
    if c == blank or c.products_count == 0
      continue
    endif
    if f[5] == blank
      continue
    endif
    assign n = n | plus: 1
  -%}
  <a class="pl-mtile{% if f[5] != blank %} pl-mtile--photo{% endif %}" href="{{ c.url }}" style="--tile: {{ f[2] }}; --i: {{ n }};{% if f[6] != blank %} --pos: {{ f[6] }};{% endif %}">
    <span class="pl-mtile__pic">
      {%- if f[5] != blank -%}
        <img class="is-full" src="{{ f[5] | asset_url }}" alt="" loading="lazy" width="1448" height="1086">
      {%- elsif f[3] != blank -%}
        {%- assign ph = 'plo-ph-' | append: f[3] | append: '-1.jpg' -%}
        <img class="is-photo" src="{{ ph | asset_url }}" alt="" loading="lazy" width="400" height="500">
      {%- elsif c.featured_image -%}
        {{ c.featured_image | image_url: width: 400 | image_tag: loading: 'lazy', alt: '' }}
      {%- elsif c.products.first.featured_image -%}
        {{ c.products.first.featured_image | image_url: width: 400 | image_tag: loading: 'lazy', alt: '' }}
      {%- endif -%}
      {%- if f[4] != blank -%}<em class="pl-mtile__tag">{{ f[4] }}</em>{%- endif -%}
    </span>
    <span class="pl-mtile__t"><b>{{ f[0] }}</b><small>{{ c.products_count }} {% if c.products_count == 1 %}product{% else %}products{% endif %}</small></span>
  </a>
{%- endfor -%}
