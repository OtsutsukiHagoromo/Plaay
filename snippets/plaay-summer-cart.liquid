{%- comment -%}
  Plaay - Summer Sale cart block. Compact offer line + live countdown.
  Self-gating (summer_active); safe to render unconditionally from the cart drawer.
  Auto-hides after 31 July 23:59 (Dubai / +04:00).
{%- endcomment -%}
{%- liquid
  assign summer_active = false
  if settings.summer_sale_enabled
    assign s_now = 'now' | date: '%s' | times: 1
    assign s_end = '2026-08-01T00:00:00+04:00' | date: '%s' | times: 1
    if s_now < s_end
      assign summer_active = true
    endif
  endif
-%}
{%- if summer_active -%}
  <div style="margin-top:6px;">
    <span class="font-walsheim-bold" style="display:block;font-size:11.5px;line-height:1.3;color:#021D49;margin-bottom:3px;">☀️ Summer Sale &middot; 30% off orders over AED 250</span>
    {%- render 'plaay-summer-countdown' -%}
  </div>
{%- endif -%}
