{%- comment -%}
  Image with a theme-asset fallback, for the Option A / Option B preview sections.
  Usage: {% render 'plo-img', image: block.settings.image, asset: block.settings.image_asset, width: 1200, alt: 'x', class: 'y', eager: true %}
  `image` (an image_picker value) wins; otherwise `asset` is a file name in /assets.
{%- endcomment -%}
{%- liquid
  assign w = width | default: 1200
  assign load = 'lazy'
  if eager
    assign load = 'eager'
  endif
-%}
{%- if image != blank -%}
  {%- assign a = alt | default: image.alt -%}
  {{ image | image_url: width: w | image_tag: loading: load, alt: a, class: class, sizes: sizes }}
{%- elsif asset != blank -%}
  <img src="{{ asset | asset_url }}" alt="{{ alt | escape }}" class="{{ class }}" loading="{{ load }}" decoding="async" width="{{ w }}" height="{{ h | default: w }}">
{%- endif -%}
