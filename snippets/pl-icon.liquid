{%- comment -%}
  Plaay 2026 icon set. Usage: {% render 'pl-icon', name: 'bag', size: 20, class: 'pl-ic' %}
  Stroke icons inherit currentColor. Names: search, bag, menu, close, user, heart, heart-fill,
  star, star-empty, chev-right, chev-down, chev-left, arrow-right, plus, minus, check, truck,
  refresh, gift, play, leaf, home, grid, filter, sort, share, lock, mail, instagram, tiktok, sparkle
{%- endcomment -%}
{%- liquid
  assign s = size | default: 20
  assign sw = stroke | default: 1.8
  assign cls = class | default: ''
-%}
<svg class="pl-ic {{ cls }}" width="{{ s }}" height="{{ s }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="{{ sw }}" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
{%- case name -%}
{%- when 'search' -%}<circle cx="11" cy="11" r="7"/><path d="M20 20l-3.5-3.5"/>
{%- when 'bag' -%}<path d="M6 8h12l1 12H5L6 8z"/><path d="M9 8V6a3 3 0 0 1 6 0v2"/>
{%- when 'menu' -%}<path d="M4 7h16M4 12h16M4 17h16"/>
{%- when 'close' -%}<path d="M6 6l12 12M18 6L6 18"/>
{%- when 'user' -%}<circle cx="12" cy="8" r="4"/><path d="M4 21a8 8 0 0 1 16 0"/>
{%- when 'heart' -%}<path d="M12 20s-7-4.5-7-10a4 4 0 0 1 7-2.5A4 4 0 0 1 19 10c0 5.5-7 10-7 10z"/>
{%- when 'heart-fill' -%}<path fill="currentColor" stroke="none" d="M12 20s-7-4.5-7-10a4 4 0 0 1 7-2.5A4 4 0 0 1 19 10c0 5.5-7 10-7 10z"/>
{%- when 'star' -%}<path fill="currentColor" stroke="none" d="M12 2.5l2.9 6 6.6.9-4.8 4.6 1.2 6.5L12 17.4 6.1 20.5l1.2-6.5L2.5 9.4l6.6-.9z"/>
{%- when 'star-empty' -%}<path d="M12 2.5l2.9 6 6.6.9-4.8 4.6 1.2 6.5L12 17.4 6.1 20.5l1.2-6.5L2.5 9.4l6.6-.9z"/>
{%- when 'chev-right' -%}<path d="M9 6l6 6-6 6"/>
{%- when 'chev-down' -%}<path d="M6 9l6 6 6-6"/>
{%- when 'chev-left' -%}<path d="M15 6l-6 6 6 6"/>
{%- when 'arrow-right' -%}<path d="M5 12h14M13 6l6 6-6 6"/>
{%- when 'plus' -%}<path d="M12 5v14M5 12h14"/>
{%- when 'minus' -%}<path d="M5 12h14"/>
{%- when 'check' -%}<path d="M5 12l5 5L20 7"/>
{%- when 'truck' -%}<path d="M3 7h11v9H3zM14 10h4l3 3v3h-7z"/><circle cx="7" cy="18" r="1.6"/><circle cx="17" cy="18" r="1.6"/>
{%- when 'refresh' -%}<path d="M20 12a8 8 0 1 1-2.3-5.7"/><path d="M20 4v5h-5"/>
{%- when 'gift' -%}<path d="M4 11h16v9H4zM3 7h18v4H3zM12 7v13"/><path d="M12 7c-2-3-6-3-6-1s4 1 6 1zM12 7c2-3 6-3 6-1s-4 1-6 1z"/>
{%- when 'play' -%}<path fill="currentColor" stroke="none" d="M9 6l10 6-10 6z"/>
{%- when 'leaf' -%}<path d="M5 19c0-8 5-13 14-14 0 9-5 14-14 14z"/><path d="M5 19l8-8"/>
{%- when 'home' -%}<path d="M4 11l8-7 8 7v9h-5v-6H9v6H4z"/>
{%- when 'grid' -%}<rect x="4" y="4" width="7" height="7" rx="1.5"/><rect x="13" y="4" width="7" height="7" rx="1.5"/><rect x="4" y="13" width="7" height="7" rx="1.5"/><rect x="13" y="13" width="7" height="7" rx="1.5"/>
{%- when 'filter' -%}<path d="M4 6h16M7 12h10M10 18h4"/>
{%- when 'sort' -%}<path d="M7 4v16M7 20l-3-3M7 20l3-3M17 20V4M17 4l-3 3M17 4l3 3"/>
{%- when 'share' -%}<path d="M12 4v12M12 4L8 8M12 4l4 4"/><path d="M5 13v6h14v-6"/>
{%- when 'lock' -%}<rect x="5" y="11" width="14" height="10" rx="2"/><path d="M8 11V8a4 4 0 0 1 8 0v3"/>
{%- when 'mail' -%}<rect x="3" y="5" width="18" height="14" rx="2"/><path d="M3 7l9 6 9-6"/>
{%- when 'instagram' -%}<rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r="1" fill="currentColor" stroke="none"/>
{%- when 'tiktok' -%}<path d="M14 4v10.5a3.5 3.5 0 1 1-3.5-3.5"/><path d="M14 4c.5 2.5 2.2 4 4.5 4.2"/>
{%- when 'sparkle' -%}<path d="M12 3l2 5 5 2-5 2-2 5-2-5-5-2 5-2z"/>
{%- when 'clock' -%}<circle cx="12" cy="12" r="8"/><path d="M12 8v4l3 2"/>
{%- when 'pin' -%}<path d="M12 21s-6-5.5-6-11a6 6 0 0 1 12 0c0 5.5-6 11-6 11z"/><circle cx="12" cy="10" r="2"/>
{%- else -%}<circle cx="12" cy="12" r="8"/>
{%- endcase -%}
</svg>
