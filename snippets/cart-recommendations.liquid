{%- comment -%}
  Drawer upsell row. bundle.cart-recommendations.js fetches sections/cart-recommendations.liquid
  (which renders the legacy cart-recommendations-item cards) into [data-recommendations] when the
  drawer opens and after every render; assets/pl-cart.css restyles those cards into a single row and
  assets/pl-cart.js adds the ladder line ("Takes you to 10% off + a Mystery Gift") per card from the
  data attributes below. Only rendered when the cart has items (the module needs a product id).
  Params: remaining_fils (fils to the next reward), next_label, reached (index of the last unlocked stop).
{%- endcomment -%}
{%- if cart.items.size > 0 -%}
  {%- liquid
    assign rec_id = cart.items.first.product_id
    assign all_done = false
    if reached >= 3
      assign all_done = true
    endif
  -%}
  <cart-recommendations
    data-module="cart-recommendations"
    data-backup-product="{{ settings.backup_recommendations_product.id }}"
    data-url="{{ routes.product_recommendations_url }}"
    data-id="{{ rec_id }}">
    <div class="pl-card pl-card--cream pl-card--flat pl-upsell"
      cart-recommendations
      data-pl-upsell
      data-remaining="{{ remaining_fils | default: 0 }}"
      data-next-label="{{ next_label | escape }}"
      data-all-done="{% if all_done %}true{% else %}false{% endif %}">
      <div class="pl-upsell__track" data-recommendations></div>
    </div>
  </cart-recommendations>
{%- endif -%}
