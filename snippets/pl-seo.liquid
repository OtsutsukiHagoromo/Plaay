{%- comment -%}
  Share previews and structured data (Open Graph, Twitter, JSON-LD), rendered in <head> from
  layout/theme.liquid.

  Open Graph + Twitter: title, description, URL, type, image. On product pages Shopify already
  adds og:image (from the featured image) through content_for_header, so only the price tags are
  added there. Other pages use page_image (collection, article, page image) or the Plaay icon.

  JSON-LD (Google rich results):
    - product: Product with one Offer per variant (price in the shop currency, stock, SKU, GTIN
      when the barcode is one) and the product's own aggregateRating from the reviews.*
      metafields (Judge.me), only when the product has reviews;
    - product and collection: BreadcrumbList (Home > Shop all / collection > product);
    - home: Organization and WebSite with the site search.
{%- endcomment -%}
{%- liquid
  assign og_type = 'website'
  if request.page_type == 'product'
    assign og_type = 'product'
  elsif request.page_type == 'article'
    assign og_type = 'article'
  endif
  assign og_desc = page_description | default: shop.description | strip_html | strip_newlines | truncate: 200
  assign site = request.origin | default: shop.url
-%}
<meta property="og:site_name" content="Plaay">
<meta property="og:url" content="{{ canonical_url }}">
<meta property="og:title" content="{{ page_title | escape }}">
<meta property="og:type" content="{{ og_type }}">
{%- if og_desc != blank %}
<meta property="og:description" content="{{ og_desc | escape }}">
{%- endif %}
{%- if request.page_type == 'product' %}
<meta property="og:price:amount" content="{{ product.selected_or_first_available_variant.price | money_without_currency | remove: ',' }}">
<meta property="og:price:currency" content="{{ cart.currency.iso_code }}">
{%- else %}
  {%- if page_image %}
<meta property="og:image" content="https:{{ page_image | image_url: width: 1200 }}">
<meta property="og:image:width" content="1200">
<meta property="og:image:height" content="{{ 1200 | divided_by: page_image.aspect_ratio | round }}">
  {%- else %}
<meta property="og:image" content="https:{{ 'pl-app-icon-512.png' | asset_url }}">
<meta property="og:image:width" content="512">
<meta property="og:image:height" content="512">
  {%- endif %}
{%- endif %}
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content="{{ page_title | escape }}">
{%- if og_desc != blank %}
<meta name="twitter:description" content="{{ og_desc | escape }}">
{%- endif %}

{%- if request.page_type == 'product' -%}
  {%- liquid
    assign r_count = product.metafields.reviews.rating_count.value | default: 0 | plus: 0
    assign r_value = product.metafields.reviews.rating.value.rating | default: 0
    assign r_max = product.metafields.reviews.rating.value.scale_max | default: 5
  -%}
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "Product",
    "name": {{ product.title | json }},
    "url": {{ site | append: product.url | json }},
    {%- if product.images.size > 0 %}
    "image": [
      {%- for img in product.images limit: 5 -%}
        {{ img | image_url: width: 1200 | prepend: 'https:' | json }}{% unless forloop.last %},{% endunless %}
      {%- endfor -%}
    ],
    {%- endif %}
    "description": {{ product.description | strip_html | strip_newlines | truncate: 500 | json }},
    {%- if product.selected_or_first_available_variant.sku != blank %}
    "sku": {{ product.selected_or_first_available_variant.sku | json }},
    {%- endif %}
    "brand": { "@type": "Brand", "name": "Plaay" },
    {%- if r_count > 0 and r_value != 0 %}
    "aggregateRating": {
      "@type": "AggregateRating",
      "ratingValue": {{ r_value | json }},
      "bestRating": {{ r_max | json }},
      "reviewCount": {{ r_count }}
    },
    {%- endif %}
    "offers": [
      {%- for v in product.variants -%}
        {%- assign code = v.barcode | strip -%}
        {%- assign code_digits = code | remove: '0' | remove: '1' | remove: '2' | remove: '3' | remove: '4' | remove: '5' | remove: '6' | remove: '7' | remove: '8' | remove: '9' -%}
        {
          "@type": "Offer",
          {%- if product.variants.size > 1 %}
          "name": {{ v.title | json }},
          {%- endif %}
          "url": {{ site | append: v.url | json }},
          "price": {{ v.price | money_without_currency | remove: ',' | json }},
          "priceCurrency": {{ cart.currency.iso_code | json }},
          {%- if v.sku != blank %}
          "sku": {{ v.sku | json }},
          {%- endif %}
          {%- if code != blank and code_digits == blank %}
            {%- case code.size -%}
              {%- when 8, 12, 13, 14 %}
          "gtin": {{ code | json }},
            {%- endcase -%}
          {%- endif %}
          "itemCondition": "https://schema.org/NewCondition",
          "availability": "https://schema.org/{% if v.available %}InStock{% else %}OutOfStock{% endif %}",
          "seller": { "@type": "Organization", "name": "Plaay" }
        }{% unless forloop.last %},{% endunless %}
      {%- endfor -%}
    ]
  }
  </script>
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Home", "item": {{ site | append: '/' | json }} },
      {%- if collection -%}
      { "@type": "ListItem", "position": 2, "name": {{ collection.title | json }}, "item": {{ site | append: collection.url | json }} },
      {%- else -%}
      { "@type": "ListItem", "position": 2, "name": "Shop all", "item": {{ site | append: '/collections/shop-all' | json }} },
      {%- endif -%}
      { "@type": "ListItem", "position": 3, "name": {{ product.title | json }}, "item": {{ site | append: product.url | json }} }
    ]
  }
  </script>
{%- elsif request.page_type == 'collection' and collection -%}
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Home", "item": {{ site | append: '/' | json }} },
      { "@type": "ListItem", "position": 2, "name": {{ collection.title | json }}, "item": {{ site | append: collection.url | json }} }
    ]
  }
  </script>
{%- elsif request.page_type == 'index' -%}
  {%- comment -%} Assigned in a tag: a "}" inside {{ }} would end the output tag early. {%- endcomment -%}
  {%- assign search_target = site | append: '/search?q={search_term_string}' -%}
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "Organization",
    "name": "Plaay",
    "url": {{ site | append: '/' | json }},
    "logo": {{ 'pl-app-icon-512.png' | asset_url | prepend: 'https:' | json }},
    "sameAs": ["https://www.instagram.com/shopplaay/"]
  }
  </script>
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "WebSite",
    "name": "Plaay",
    "url": {{ site | append: '/' | json }},
    "potentialAction": {
      "@type": "SearchAction",
      "target": {{ search_target | json }},
      "query-input": "required name=search_term_string"
    }
  }
  </script>
{%- endif -%}
