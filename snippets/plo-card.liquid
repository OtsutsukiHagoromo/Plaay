{%- comment -%}
  Product card for the Option A / Option B preview templates.
  Usage: {% render 'plo-card', product: product, eager: false, show_sub: false, skip_new: false, view: template.suffix, reason: '' %}
  reason: optional small line above the name (why the card is suggested).
  variant: optional variant to show/add instead of the first available one.
  sub_mode: subscription listing - the subscribe price leads (one-time struck through) and the
    "+" adds on a selling plan (data-plo-plan; data-plo-plan2 / data-plo-plan4 let the page's
    2 / 4 week toggle swap it).
  One markup, two looks: A is a white outlined box with the add button in the footer,
  B is a lifted image tile with a sticker add button on the image. show_sub adds the
  subscribe price under the price (off by default: listings stay one price per card). The "+" buttons carry
  data-plo-quick (first available variant id) and are handled by assets/pl-opt.js rather than the
  theme's <quick-add> module, which opens the live cart drawer and leaves the preview.
{%- endcomment -%}
{%- liquid
  assign v = variant | default: product.selected_or_first_available_variant
  comment
    Multi-size products (truffles) open on the 10 x 60g pack unless a variant was passed, and
    show size swatches that switch the price and what "+" adds.
  endcomment
  assign has_sizes = false
  if product.variants.size > 1
    assign has_sizes = true
    if variant == blank
      for x in product.variants
        assign xt = x.title | downcase | remove: ' '
        if xt == '10x60g' and x.available
          assign v = x
        endif
      endfor
    endif
  endif
  assign sub_pct = 0
  assign plan2 = ''
  assign plan4 = ''
  for grp in product.selling_plan_groups
    for plan in grp.selling_plans
      assign pn = plan.name | downcase
      if pn contains 'every 2 week' or pn contains '2 week'
        assign plan2 = plan.id
      elsif pn contains 'every 4 week' or pn contains '4 week'
        assign plan4 = plan.id
      endif
      if plan4 == '' and plan2 == '' and forloop.first
        assign plan_first = plan.id
      endif
      for adj in plan.price_adjustments
        if adj.value_type == 'percentage' and adj.value > sub_pct
          assign sub_pct = adj.value
        endif
      endfor
    endfor
  endfor
  if plan4 == ''
    assign plan4 = plan2 | default: plan_first
  endif
  if plan2 == ''
    assign plan2 = plan4
  endif
  assign sub_price = 0
  if sub_pct > 0
    assign keep = 100 | minus: sub_pct
    assign sub_price = v.price | times: keep | divided_by: 100
  endif

  assign badge_text = ''
  assign badge_mod = ''
  for tag in product.tags
    assign tl = tag | downcase | strip
    if badge_text == ''
      case tl
        when 'badge:bestseller'
          assign badge_text = 'Best seller'
        when 'badge:new-launch', 'badge:new'
          comment
            "New" badges are switched off sitewide.
          endcomment
        when 'badge:limited', 'limited edition'
          assign badge_text = 'Limited'
          assign badge_mod = 'limited'
        when 'badge:favourite'
          assign badge_text = 'Fan fave'
        when 'badge:staff'
          assign badge_text = 'Staff pick'
      endcase
    endif
  endfor
  if badge != blank
    assign badge_text = badge
  endif
  comment
    Listings pass skip_new: when most of a collection is new, a New badge on every card is noise.
  endcomment
  if skip_new and badge_mod == 'new'
    assign badge_text = ''
  endif

  assign meta = ''
  if sub_mode and v.title != 'Default Title'
    assign meta = v.title | replace: ' X ', ' × ' | replace: ' x ', ' × ' | replace: 'G', 'g' | replace: ' g', 'g'
  elsif has_sizes
    assign meta = ''
  elsif v.title != 'Default Title'
    assign meta = v.title
  endif

  capture pkey
    render 'plo-photo-key', handle: product.handle
  endcapture
  assign pkey = pkey | strip
  assign href = product.url
  if view == 'option-a' or view == 'option-b'
    assign href = product.url | append: '?view=' | append: view
  endif

  assign load = 'lazy'
  if eager
    assign load = 'eager'
  endif
-%}
{%- capture ns -%}{%- render 'plo-name-split', title: product.title -%}{%- endcapture -%}
{%- assign ns = ns | split: '|' -%}
{%- assign c_name = ns[0] | default: product.title -%}
{%- assign c_size = ns[1] -%}
{%- if c_size == blank and has_sizes == false and v.title != 'Default Title' -%}{%- assign c_size = v.title | replace: ' X ', ' × ' | replace: ' x ', ' × ' | replace: 'G', 'g' -%}{%- endif -%}
{%- comment -%}
  Card v3: one cream tile with the product centred (never cropped), then the name, one quiet
  detail line (pack size, or a size picker for multi-size products), and a price row with the
  add button. Every card has the same four rows, so a grid reads in clean lines.
{%- endcomment -%}
<article class="plo-card plo-c3"{% if range != blank %} data-range="{{ range }}"{% endif %}{% if has_sizes %} data-plo-sizes data-pct="{{ sub_pct }}"{% endif %}>
  <a class="plo-card__img" href="{{ href }}" tabindex="-1" aria-hidden="true">
    {%- if pkey != blank -%}
      {%- assign ph = 'plo-ph-' | append: pkey | append: '-1.jpg' -%}
      <img src="{{ ph | asset_url }}" alt="{{ product.title | escape }}" loading="{{ load }}" width="800" height="1000" class="is-photo">
    {%- elsif product.featured_image -%}
      {{ product.featured_image | image_url: width: 600 | image_tag: loading: load, sizes: '(min-width: 1024px) 300px, 46vw', widths: '240, 360, 480, 600', alt: product.title }}
    {%- else -%}
      {{ 'product-1' | placeholder_svg_tag }}
    {%- endif -%}
    {%- if badge_text != blank -%}<span class="plo-badge{% if badge_mod != blank %} plo-badge--{{ badge_mod }}{% endif %}">{{ badge_text }}</span>{%- endif -%}
  </a>
  <div class="plo-card__body">
    {%- if reason != blank -%}<p class="plo-card__why">{{ reason }}</p>{%- endif -%}
    <h3 class="plo-card__name"><a href="{{ href }}">{{ c_name }}</a></h3>
    <div class="plo-card__detail">
      {%- if has_sizes -%}
        <label class="plo-card__sel">
          <span class="pl-vh">Pack size</span>
          <select data-plo-szsel>
            {%- for x in product.variants -%}
              {%- assign xl = x.title | replace: ' X ', ' × ' | replace: ' x ', ' × ' | replace: 'G', 'g' | replace: ' g', 'g' -%}
              <option value="{{ x.id }}" data-price="{{ x.price }}"{% if x.id == v.id %} selected{% endif %}{% unless x.available %} disabled{% endunless %}>{{ xl }}</option>
            {%- endfor -%}
          </select>
          {%- render 'pl-icon', name: 'chev-down', size: 12, stroke: 2.6 -%}
        </label>
      {%- elsif c_size != blank -%}
        <span>{{ c_size }}</span>
      {%- elsif meta != blank -%}
        <span>{{ meta }}</span>
      {%- endif -%}
    </div>
    <div class="plo-card__foot">
      <div class="plo-card__prices">
        {%- if sub_mode and sub_price > 0 -%}
          <span class="plo-card__price"><span data-plo-cp-sub>{%- render 'plaay-aed', fils: sub_price -%}</span></span>
          <s class="plo-card__was" data-plo-cp>{%- render 'plaay-aed', fils: v.price -%}</s>
        {%- else -%}
          <span class="plo-card__price"><span data-plo-cp>{%- render 'plaay-aed', fils: v.price -%}</span></span>
        {%- endif -%}
      </div>
      {%- if v.available -%}
        <button type="button" class="plo-add plo-c3__add" data-plo-quick="{{ v.id }}"{% if sub_mode and plan4 != '' %} data-plo-plan="{{ plan4 }}" data-plo-plan2="{{ plan2 }}" data-plo-plan4="{{ plan4 }}"{% endif %} aria-label="{% if sub_mode %}Subscribe to{% else %}Add{% endif %} {{ product.title | escape }}{% unless sub_mode %} to bag{% endunless %}">{%- render 'pl-icon', name: 'plus', size: 16, stroke: 2.6 -%}</button>
      {%- else -%}
        <span class="plo-card__soldout">Sold out</span>
      {%- endif -%}
    </div>
  </div>
</article>
