{%- comment -%}
  Cart line items.

  Default: wraps the list in <cart-drawer-items>. bare: true renders the list without the wrapper,
  for the cart page where <cart-items> is the host.

  assets/pl-cart.js runs every line control (no webpack modules any more):
    - [data-cart-item][data-key][data-unit][data-quantity] per line
    - button[data-minus] / input[name=quantity] / button[data-plus] for the quantity, .pl-item__remove to remove
  Subscription switch data (read by assets/pl-cart.js): data-plan-id, data-plan-name, data-sub-saving,
  data-quantity, data-variant-id, data-properties.
{%- endcomment -%}
{%- liquid
  assign is_bare = false
  if bare == true
    assign is_bare = true
  endif
-%}
{%- unless is_bare -%}
<cart-drawer-items class="pl-lines">
  <div class="pl-cart__loading loading_dots" aria-hidden="true"><span class="pl-cart__spin"></span></div>
{%- endunless -%}
  <div class="pl-items">
    {%- comment -%} Two passes: reward gifts (Mystery Gift) first, then everything else. {%- endcomment -%}
    {%- assign box_done = ',' -%}
    {%- for pass in (1..2) -%}
    {%- for item in cart.items -%}
      {%- liquid
        assign is_gift = false
        if item.properties._plaay_reward != blank
          assign is_gift = true
        endif
        if pass == 1 and is_gift == false
          continue
        endif
        if pass == 2 and is_gift
          continue
        endif

        assign is_sub = false
        if item.selling_plan_allocation
          assign is_sub = true
        endif

        assign has_plans = false
        if item.product.selling_plan_groups.size > 0 and is_gift == false
          assign has_plans = true
        endif

        assign show_variant = true
        if item.variant.title == 'Default Title' or item.variant.title == blank
          assign show_variant = false
        endif

        assign line_price = item.original_line_price
        assign line_one_time = line_price
        if is_sub
          assign line_one_time = item.selling_plan_allocation.compare_at_price | times: item.quantity
        endif
        assign sub_saving = line_one_time | minus: line_price

        assign line_compare = 0
        if item.variant.compare_at_price > item.variant.price
          assign line_compare = item.variant.compare_at_price | times: item.quantity
        endif
        assign show_was = false
        if line_compare > line_price and is_sub == false
          assign show_was = true
        endif

        assign plan_id = ''
        assign plan_name = ''
        assign plan_pct = 15
        if has_plans
          for plan in item.product.selling_plan_groups.first.selling_plans
            if plan_id == '' or plan.name contains '4'
              assign plan_id = plan.id
              assign plan_name = plan.name
              for adj in plan.price_adjustments
                if adj.value_type == 'percentage'
                  assign plan_pct = adj.value
                endif
              endfor
              if plan.name contains '4'
                break
              endif
            endif
          endfor
        endif
        assign offer_saving = line_price | times: plan_pct | divided_by: 100

        comment
          Every plan this pack can use (all plan groups), for the frequency picker
          ("Delivery every 2 Weeks" -> "Every 2 weeks"), so the line's current plan is always listed.
        endcomment
        assign cur_plan_id = ''
        if is_sub
          assign cur_plan_id = item.selling_plan_allocation.selling_plan.id
        endif
        capture plan_opts
          if has_plans
            for alloc in item.variant.selling_plan_allocations
              assign plan = alloc.selling_plan
              assign pl_label = plan.name | downcase | remove: 'delivery' | remove: 'every' | strip | prepend: 'Every '
              assign pl_sel = ''
              if plan.id == cur_plan_id
                assign pl_sel = ' selected'
              endif
              echo '<option value="' | append: plan.id | append: '"' | append: pl_sel | append: '>' | append: pl_label | append: '</option>'
            endfor
          endif
        endcapture

        assign variant_label = item.variant.title | replace: ' X ', ' × ' | replace: ' x ', ' × ' | replace: ' G', 'g' | replace: 'G', 'g'

        assign sub_pct = 15
        assign sub_freq = 'Every 4 weeks'
        if is_sub
          assign sub_name = item.selling_plan_allocation.selling_plan.name
          for adj in item.selling_plan_allocation.selling_plan.price_adjustments
            if adj.value_type == 'percentage'
              assign sub_pct = adj.value
            endif
          endfor
          if sub_name contains '4'
            assign sub_freq = 'Every 4 weeks'
          elsif sub_name contains '2'
            assign sub_freq = 'Every 2 weeks'
          else
            assign sub_freq = sub_name
          endif
        endif
      -%}
      {%- comment -%}
        Build Your Box lines (sections/pl-byob.liquid) share a hidden _box id: the first line of a
        box renders the whole box as one card (snippets/pl-box-line.liquid), the rest are skipped.
      {%- endcomment -%}
      {%- if item.properties._box != blank -%}
        {%- assign bkey = ',' | append: item.properties._box | append: ',' -%}
        {%- unless box_done contains bkey -%}
          {%- assign box_done = box_done | append: item.properties._box | append: ',' -%}
          {%- render 'pl-box-line', box: item.properties._box -%}
        {%- endunless -%}
        {%- continue -%}
      {%- endif -%}
      <div
        class="pl-card pl-item{% if is_sub %} is-sub{% endif %}{% if is_gift %} pl-item--gift{% endif %}"
        data-cart-item
        data-key="{{ item.key }}"
        data-variant-id="{{ item.variant_id }}"
        data-product-id="{{ item.product_id }}"
        data-quantity="{{ item.quantity }}"
        data-unit="{{ line_price | divided_by: item.quantity }}"
        {%- if has_plans %} data-plan-id="{{ plan_id }}" data-plan-name="{{ plan_name | escape }}" data-sub-saving="{{ offer_saving }}"{% endif %}
        data-properties="{{ item.properties | json | escape }}">
        <div class="pl-item__top">
          <a href="{{ item.url }}" class="pl-item__img" tabindex="-1" aria-hidden="true">
            {%- capture ikey -%}{%- render 'plo-photo-key', handle: item.product.handle -%}{%- endcapture -%}{%- assign ikey = ikey | strip -%}
            {%- if ikey != blank -%}
              {%- render 'pl-photo', key: ikey, n: 1, alt: item.product.title, class: 'is-photo', size: 200 -%}
            {%- elsif item.image -%}
              {{ item.image | image_url: width: 176 | image_tag: loading: 'lazy', widths: '88, 176', sizes: '72px', alt: item.product.title }}
            {%- endif -%}
          </a>
          <div class="pl-item__body">
            <div class="pl-item__head">
              <a href="{{ item.url }}" class="pl-item__title">{{ item.product.title }}</a>
              {%- unless is_gift -%}
                <cart-remove-button>
                  <button type="button" class="pl-item__remove" aria-label="Remove {{ item.product.title | escape }}">
                    {%- render 'pl-icon', name: 'close', size: 16, stroke: 2 -%}
                  </button>
                </cart-remove-button>
              {%- endunless -%}
            </div>
            {%- if show_variant -%}
              <span class="pl-item__variant">{{ variant_label }}</span>
            {%- endif -%}
            <div class="pl-item__row">
              {%- if is_gift -%}
                <span class="pl-tag pl-tag--yellow">Mystery Gift</span>
              {%- else -%}
                <quantity-adjuster>
                  <div class="pl-stepper pl-stepper--sm">
                    <button type="button" name="minus" data-minus aria-label="Decrease quantity">&minus;</button>
                    <input type="number" name="quantity" value="{{ item.quantity }}" min="0" inputmode="numeric" aria-label="Quantity">
                    <button type="button" name="plus" data-plus aria-label="Increase quantity">+</button>
                  </div>
                </quantity-adjuster>
              {%- endif -%}
              <div class="pl-item__price">
                {%- if show_was -%}
                  <s class="pl-item__was">{% render 'plaay-aed', fils: line_compare %}</s>
                {%- elsif is_sub and sub_saving > 0 -%}
                  <s class="pl-item__was">{% render 'plaay-aed', fils: line_one_time %}</s>
                {%- endif -%}
                {%- if is_gift and line_price == 0 -%}
                  <b class="pl-item__now">Free</b>
                {%- else -%}
                  <b class="pl-item__now">{% render 'plaay-aed', fils: line_price %}</b>
                {%- endif -%}
              </div>
            </div>
          </div>
        </div>

        {%- if has_plans and plan_id != '' -%}
          {%- comment -%}
            Purchase option: One-time | Subscribe, and while subscribed a frequency picker.
            Wired in assets/pl-cart.js ([data-pl-sub-on], [data-pl-sub-off], [data-pl-sub-freq]).
          {%- endcomment -%}
          <div class="pl-buymode{% if is_sub %} is-sub{% endif %}">
            <div class="pl-seg" role="group" aria-label="Purchase option for {{ item.product.title | escape }}">
              <button type="button" class="pl-seg__b{% unless is_sub %} is-on{% endunless %}" data-pl-sub-off aria-pressed="{% if is_sub %}false{% else %}true{% endif %}">One-time</button>
              <button type="button" class="pl-seg__b{% if is_sub %} is-on{% endif %}" data-pl-sub-on aria-pressed="{% if is_sub %}true{% else %}false{% endif %}">{% render 'pl-icon', name: 'refresh', size: 12, stroke: 2.4 %}Subscribe <em>−{% if is_sub %}{{ sub_pct }}{% else %}{{ plan_pct }}{% endif %}%</em></button>
            </div>
            {%- if is_sub -%}
              <div class="pl-buymode__row">
                <label class="pl-freq">
                  <span class="pl-vh">Delivery frequency</span>
                  <select data-pl-sub-freq>{{ plan_opts }}</select>
                  {%- render 'pl-icon', name: 'chev-down', size: 14, stroke: 2.4 -%}
                </label>
                {%- if sub_saving > 0 -%}<span class="pl-buymode__save">You save {% render 'plaay-aed', fils: sub_saving %}</span>{%- endif -%}
              </div>
            {%- else -%}
              <p class="pl-buymode__hint">Subscribe and save {% render 'plaay-aed', fils: offer_saving %} · free delivery · skip or cancel any time</p>
            {%- endif -%}
          </div>
        {%- endif -%}
      </div>
    {%- endfor -%}
    {%- endfor -%}
  </div>
{%- unless is_bare -%}
</cart-drawer-items>
{%- endunless -%}
