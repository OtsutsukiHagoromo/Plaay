{%- comment -%}
  Cart contents, shared by the drawer (default) and the cart page (page: true).

  Drawer: root is [data-cart-drawer-content] carrying data-cart-item-count. It is swapped wholesale by
  window.plaayRenderCartDrawerSections (assets/plaay-cart-gift-prompt.js) / bundle.cart-drawer-items.js
  from the `cart-drawer-content` section after every cart change.

  Page: root is <cart-items> inside [data-cart-page-root]; assets/pl-cart.js re-renders the root from
  the `main-cart` section after every change.

  Ladder maths use the rewards settings and cart.original_total_price (pre-discount), matching
  snippets/cart-tier-bar.liquid, so a percentage tier can never knock a shopper down a tier.
{%- endcomment -%}
{%- liquid
  assign is_page = false
  if page == true
    assign is_page = true
  endif

  assign ship_fils = settings.cart_tier_ship | default: 75 | times: 100
  assign t1_fils = settings.cart_tier_1_spend | default: 250 | times: 100
  assign t2_fils = settings.cart_tier_2_spend | default: 350 | times: 100
  assign t3_fils = settings.cart_tier_3_spend | default: 500 | times: 100
  assign l1 = settings.cart_tier_1_label | default: '7% off'
  assign l2 = settings.cart_tier_2_label | default: '10% off + Mystery Gift' | replace: '+ Mystery Gift', '+ a Mystery Gift'
  assign l3 = settings.cart_tier_3_label | default: '15% off + Mystery Gift' | replace: '+ Mystery Gift', '+ a Mystery Gift'

  # Threshold sale (sale kit on + sale_min_spend, e.g. Black Friday 25% off AED 399+): the ladder
  # becomes free delivery -> tier 1 (if below the sale minimum) -> the sale. Shopify gives the
  # bigger of the non-combining order discounts, so this is what checkout applies.
  assign threshold_sale = false
  capture sale_on_l
    render 'sale-active'
  endcapture
  assign sale_min_fils = settings.sale_min_spend | default: 0 | times: 100
  if sale_on_l contains '1' and sale_min_fils > 0
    assign threshold_sale = true
    if t1_fils >= sale_min_fils
      assign t1_fils = sale_min_fils
      assign l1 = settings.sale_default_pct | append: '% off'
      assign t2_fils = 0
    else
      assign t2_fils = sale_min_fils
      assign l2 = settings.sale_default_pct | append: '% off'
    endif
    assign t3_fils = 0
  endif

  # Free delivery counts the whole bag. The % rewards count one-time items only: the Shopify
  # tier discounts don't apply to subscribed items, and their minimum spend counts only the
  # items they apply to (so a subscribed line can't "unlock" 10% that checkout won't give).
  assign total = cart.original_total_price
  assign elig = 0
  assign has_sub = false
  for it in cart.items
    if it.selling_plan_allocation
      assign has_sub = true
    else
      assign elig = elig | plus: it.original_line_price
    endif
  endfor
  assign reached = -1
  if total >= ship_fils
    assign reached = 0
  endif
  if reached == 0 and t1_fils > 0 and elig >= t1_fils
    assign reached = 1
  endif
  if reached == 1 and t2_fils > 0 and elig >= t2_fils
    assign reached = 2
  endif
  if reached == 2 and t3_fils > 0 and elig >= t3_fils
    assign reached = 3
  endif

  assign next_fils = 0
  assign next_label = ''
  assign done_label = ''
  if reached == -1
    assign next_fils = ship_fils
    assign next_label = 'free delivery'
  elsif reached == 0
    assign next_fils = t1_fils
    assign next_label = l1
    assign done_label = 'Free delivery'
  elsif reached == 1
    assign next_fils = t2_fils
    assign next_label = l2
    assign done_label = l1
  elsif reached == 2 and t3_fils > 0
    assign next_fils = t3_fils
    assign next_label = l3
    assign done_label = l2
  elsif reached == 2
    assign done_label = l2
  else
    assign done_label = l3
  endif
  # During a sitewide sale (snippets/sale-active) the sale discount replaces the 10% / 18%
  # rewards (they don't combine and the sale is always bigger), so the ladder stops at free
  # delivery instead of showing tiers as unlocked that won't apply.
  capture sale_on
    render 'sale-active'
  endcapture
  if sale_on contains '1' and reached >= 0 and threshold_sale == false
    assign reached = 0
    assign next_fils = 0
    assign next_label = ''
    assign done_label = 'Free delivery'
  endif
  if reached == -1
    assign remaining_fils = next_fils | minus: total
  else
    assign remaining_fils = next_fils | minus: elig
  endif
  if remaining_fils < 0
    assign remaining_fils = 0
  endif

  assign first_product_id = false
  if cart.items.size > 0
    assign first_product_id = cart.items.first.product_id
  endif
-%}

{%- capture ladder_html -%}
  <div class="pl-card pl-ladder">
    {%- if next_label != '' -%}
      <p class="pl-ladder__msg"><b>{% render 'plaay-aed', fils: remaining_fils %}</b> away from <b>{{ next_label }}</b></p>
    {%- else -%}
      <p class="pl-ladder__msg pl-green">{% render 'pl-icon', name: 'check', size: 14, stroke: 2.6 %}{% if sale_on contains '1' %}Free delivery unlocked{% else %}All rewards unlocked{% endif %}</p>
    {%- endif -%}
    {%- render 'cart-tier-bar' -%}
    {%- unless sale_on contains '1' -%}{%- if has_sub and t1_fils > 0 -%}
      <p class="pl-ladder__note">Subscribed items already get their subscription discount, so they don't count toward the % rewards.</p>
    {%- endif -%}{%- endunless -%}
    {%- if next_label != '' and cart.item_count > 0 -%}
      {%- liquid
        comment
          Next-reward preview: up to 3 products that close the gap on their own (cheapest first,
          price >= what is missing), else the 3 priciest. Not already in the bag, available,
          no gift. Taps add through assets/pl-cart.js ([data-pl-gap-add]).
        endcomment
        assign in_bag = ''
        for it in cart.items
          assign in_bag = in_bag | append: ',' | append: it.product_id | append: ','
        endfor
        assign pool = collections['shop-all'].products | sort: 'price'
        assign picks = ''
        assign n_picks = 0
        for pr in pool
          if n_picks >= 3
            break
          endif
          assign pid = ',' | append: pr.id | append: ','
          if pr.available == false or in_bag contains pid or pr.price == 0 or pr.handle contains 'gift'
            continue
          endif
          if pr.price >= remaining_fils
            assign picks = picks | append: pr.handle | append: '|'
            assign n_picks = n_picks | plus: 1
          endif
        endfor
        if n_picks == 0
          assign rev = pool | reverse
          for pr in rev
            if n_picks >= 3
              break
            endif
            assign pid = ',' | append: pr.id | append: ','
            if pr.available == false or in_bag contains pid or pr.price == 0 or pr.handle contains 'gift'
              continue
            endif
            assign picks = picks | append: pr.handle | append: '|'
            assign n_picks = n_picks | plus: 1
          endfor
        endif
        assign pick_handles = picks | split: '|'
      -%}
      {%- if n_picks > 0 -%}
        <details class="pl-gap" data-pl-gap>
          <summary>
            <span>Quick ways to get there</span>
            <span class="pl-gap__cta">See picks {% render 'pl-icon', name: 'chev-down', size: 14, stroke: 2.4 %}</span>
          </summary>
          <ul class="pl-gap__list">
            {%- for h in pick_handles -%}
              {%- assign pr = all_products[h] -%}
              {%- assign pv = pr.selected_or_first_available_variant -%}
              {%- capture gk -%}{%- render 'plo-photo-key', handle: pr.handle -%}{%- endcapture -%}{%- assign gk = gk | strip -%}
              <li class="pl-gap__i" style="--i: {{ forloop.index }}">
                <a class="pl-gap__pic" href="{{ pr.url }}" tabindex="-1" aria-hidden="true">
                  {%- if gk != blank -%}
                    {%- render 'pl-photo', key: gk, n: 1, alt: '', size: 200 -%}
                  {%- elsif pr.featured_image -%}
                    {{ pr.featured_image | image_url: width: 160 | image_tag: loading: 'lazy', alt: '' }}
                  {%- endif -%}
                </a>
                <span class="pl-gap__t">
                  <a href="{{ pr.url }}">{{ pr.title }}</a>
                  <small>{% render 'plaay-aed', fils: pv.price %}{% if pv.price >= remaining_fils %} · unlocks it{% endif %}</small>
                </span>
                <button type="button" class="pl-gap__add" data-pl-gap-add="{{ pv.id }}" aria-label="Add {{ pr.title | escape }}">{% render 'pl-icon', name: 'plus', size: 16, stroke: 2.6 %}</button>
              </li>
            {%- endfor -%}
          </ul>
        </details>
      {%- endif -%}
    {%- endif -%}
  </div>
{%- endcapture -%}

{%- liquid
  # Plaay Express in the bag: everywhere once express_enabled is on; until then only when the
  # bag holds the hidden test product (tag express-test).
  assign plx_cart = settings.express_enabled
  for plx_item in cart.items
    if plx_item.product.tags contains 'express-test'
      assign plx_cart = true
    endif
  endfor
-%}
{%- capture trust_html -%}
  {%- comment -%}
    Two quiet facts under the summary. No returns promise: the products are perishable.
  {%- endcomment -%}
  {%- if plx_cart -%}{%- render 'plx-express-box', mode: 'cart' -%}{%- endif -%}
  <div class="pl-trust pl-trust--quiet">
    <span>{% render 'pl-icon', name: 'truck', size: 14, stroke: 1.8 %}{% if plx_cart %}Express in Dubai, free over AED {{ settings.express_free_over | default: 199 }} · 1–2 days UAE-wide, free over AED {{ settings.cart_tier_ship | default: 99 }}{% else %}1–2 day UAE delivery · Free delivery over AED {{ settings.cart_tier_ship | default: 99 }}{% endif %}</span>
    <span>{% render 'pl-icon', name: 'lock', size: 14, stroke: 1.8 %}Secure checkout · Halal certified</span>
  </div>
{%- endcapture -%}

{%- if is_page -%}
  <cart-items class="pl-cartpage__grid{% if cart.item_count == 0 %} is-empty{% endif %}">
    <span data-pl-cart-count-source data-cart-item-count="{{ cart.item_count }}" hidden></span>
    <div class="pl-cart__loading loading_dots" aria-hidden="true"><span class="pl-cart__spin"></span></div>
    {%- if cart.item_count > 0 -%}
      <div class="pl-cartpage__main">
        {%- capture sale_on -%}{%- render 'sale-active' -%}{%- endcapture -%}
        {%- if sale_on contains '1' -%}{%- render 'sale-note', countdown: true, mod: 'cart' -%}{%- endif -%}
        {{ ladder_html }}
        {%- render 'plaay-eid-countdown' -%}
        {%- render 'cart-drawer-items', bare: true -%}
        {%- render 'pl-mix-nudge' -%}
        <cart-page-recommendations class="pl-cartpage__recs" data-id="{{ first_product_id }}" data-url="{{ routes.product_recommendations_url }}">
          <h2 class="pl-h pl-h--4" data-recommendations-title>You might also like</h2>
          <div class="pl-grid pl-grid--2" data-cart-page-recommendations data-limit="4"></div>
        </cart-page-recommendations>
      </div>
      <aside class="pl-cartpage__side">
        <div class="pl-card pl-cartpage__summary" data-cart-drawer-footer>
          {%- render 'cart-drawer-footer', ship_fils: ship_fils -%}
          <a href="/checkout" class="pl-btn pl-btn--full" data-checkout-url="/checkout">Checkout</a>
          {{ trust_html }}
          <p class="pl-continue"><a href="{{ routes.collections_url }}/shop-all" class="pl-btn pl-btn--link">Continue shopping</a></p>
        </div>
      </aside>
    {%- else -%}
      <div class="pl-cartpage__main">
        {%- render 'plaay-cart-empty-state' -%}
      </div>
    {%- endif -%}
  </cart-items>
{%- else -%}
  <div class="pl-drawer__body" data-cart-drawer-content data-cart-item-count="{{ cart.item_count }}">
    <div class="pl-drawer__scroll" data-cart-items>
      {%- if cart.item_count > 0 -%}
        {%- capture sale_on -%}{%- render 'sale-active' -%}{%- endcapture -%}
        {%- if sale_on contains '1' -%}{%- render 'sale-note', countdown: true, mod: 'cart' -%}{%- endif -%}
        {{ ladder_html }}
        {%- render 'plaay-eid-countdown' -%}
        {%- render 'cart-drawer-items' -%}
        {%- render 'pl-mix-nudge' -%}
        {%- render 'cart-recommendations', remaining_fils: remaining_fils, next_label: next_label, reached: reached -%}
        <div class="pl-card pl-summary-card" data-cart-drawer-footer>
          {%- render 'cart-drawer-footer', ship_fils: ship_fils -%}
        </div>
        {{ trust_html }}
        <p class="pl-continue"><button type="button" class="pl-btn pl-btn--link" data-close>Continue shopping</button></p>
      {%- else -%}
        <div hidden aria-hidden="true">{%- render 'cart-drawer-items' -%}</div>
        {%- render 'plaay-cart-empty-state' -%}
      {%- endif -%}
    </div>

    <div class="pl-drawer__foot">
      {%- if cart.item_count > 0 -%}
        {%- comment -%}
          The total opens a short summary above the bar (a copy of the summary rows further up,
          made by assets/pl-cart.js on tap: [data-pl-sum-toggle] / [data-pl-sum]).
        {%- endcomment -%}
        {%- liquid
          comment
            Footer, two rows: the total line (tap for the summary), then one full-width Checkout.
            The total line carries what was earned: a chip with the tier ("18% off") and "You
            save AED x" on the left, the pre-discount total struck through beside the total on
            the right; with no discount yet, "Free delivery" once unlocked.
          endcomment
          # Savings = everything taken off the one-time price: subscription prices, rewards tiers,
          # promo codes, sale. The base matches the summary's "Subtotal" (subscribed lines at their
          # one-time price), so base - total = every "−" row in the summary added up.
          assign was = 0
          for item in cart.items
            if item.selling_plan_allocation
              assign was = item.selling_plan_allocation.compare_at_price | times: item.quantity | plus: was
            else
              assign was = was | plus: item.original_line_price
            endif
          endfor
          if was < cart.total_price
            assign was = cart.total_price
          endif
          assign saved = was | minus: cart.total_price
          assign chip = ''
          if saved > 0
            # The chip is the real share saved on this bag (e.g. 15% subscription + 10% reward on
            # part of it reads "13% off"), never just the tier name.
            assign saved_pct = saved | times: 100.0 | divided_by: was | floor
            if saved_pct < 1
              assign saved_pct = 1
            endif
            assign chip = saved_pct | append: '% off'
          endif
        -%}
        <button type="button" class="pl-drawer__total" data-pl-sum-toggle aria-expanded="false" aria-label="Show order summary">
          <span class="pl-drawer__total-l">
            <span class="pl-drawer__total-k">Total {% render 'pl-icon', name: 'chev-down', size: 13, stroke: 2.6 %}{% if chip != '' %}<em class="pl-drawer__chip">{{ chip }}</em>{% endif %}</span>
            {%- if saved > 0 -%}
              <span class="pl-drawer__perk is-save">You save {% render 'plaay-aed', fils: saved %}</span>
            {%- elsif reached >= 0 -%}
              <span class="pl-drawer__perk">{% render 'pl-icon', name: 'truck', size: 13, stroke: 2.2 %}Free delivery</span>
            {%- else -%}
              <span class="pl-drawer__perk">{% render 'pl-icon', name: 'truck', size: 13, stroke: 2.2 %}Incl. AED {{ settings.cart_ship_fee | default: 15 }} delivery</span>
            {%- endif -%}
          </span>
          <span class="pl-drawer__total-row">
            {%- if saved > 0 -%}<s class="pl-drawer__was">{% render 'plaay-aed', fils: was %}</s>{%- endif -%}
            {%- liquid
              # Same as the summary: Standard delivery is in the total until it is free.
              assign foot_total = cart.total_price
              if reached < 0
                assign foot_fee = settings.cart_ship_fee | default: 15 | times: 100
                assign foot_total = foot_total | plus: foot_fee
              endif
            -%}
            <span class="pl-drawer__total-v" data-pl-sticky-total>{% render 'plaay-aed', fils: foot_total %}</span>
          </span>
        </button>
        <div class="pl-drawer__sum" data-pl-sum hidden></div>
        <a href="/checkout" class="pl-btn pl-drawer__checkout" data-checkout-url="/checkout">{% render 'pl-icon', name: 'lock', size: 17, stroke: 2.4 %}<span>Checkout</span></a>
        {%- comment -%} Apple Pay / Google Pay / Shop Pay under Checkout, for every bag. {%- endcomment -%}
        {%- if additional_checkout_buttons -%}
          <div class="pl-wallet">{{ content_for_additional_checkout_buttons }}</div>
        {%- endif -%}
      {%- else -%}
        <button type="button" class="pl-btn pl-btn--full" data-close>Continue shopping</button>
      {%- endif -%}
    </div>
  </div>
{%- endif -%}
