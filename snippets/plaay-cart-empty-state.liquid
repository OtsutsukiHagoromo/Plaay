{%- comment -%}
  Empty bag state for the drawer and the cart page. The two tiles use pl-tile, whose <quick-add>
  adds through cart-drawer-items / cart-items (both hosts stay in the DOM on an empty cart).
{%- endcomment -%}
{%- liquid
  assign empty_p1 = all_products['og-plaayer-pack']
  assign empty_p2 = all_products['triple-chocolate-truffle']
-%}
<div class="pl-empty">
  <span class="pl-empty__icon" aria-hidden="true">{% render 'pl-icon', name: 'bag', size: 34, stroke: 1.6 %}</span>
  <h3 class="pl-h pl-h--3">Your bag is empty.</h3>
  <p class="pl-body pl-mute">Start with a bestseller.</p>
  {%- if empty_p1.title != blank or empty_p2.title != blank -%}
    <div class="pl-grid pl-grid--2 pl-empty__grid">
      {%- if empty_p1.title != blank -%}
        {%- render 'pl-tile', product: empty_p1, sizes: '(min-width: 1024px) 200px, 44vw' -%}
      {%- endif -%}
      {%- if empty_p2.title != blank -%}
        {%- render 'pl-tile', product: empty_p2, sizes: '(min-width: 1024px) 200px, 44vw' -%}
      {%- endif -%}
    </div>
  {%- endif -%}
</div>
